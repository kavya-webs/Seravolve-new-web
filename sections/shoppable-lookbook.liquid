        <img class="gallery-item__image" src="{{ 'event-sky_5925.jpg' | asset_url }}" alt="Launch event photo 5925" loading="lazy">
      </div>

      <div class="gallery-item gi-11" data-type="image" aria-label="View Event Photo 9">
        <span class="gallery-item__badge">Photo</span>
