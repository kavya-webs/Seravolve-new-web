<style>
  .lookbook-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alternate);
  }
  .lookbook-section__heading {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  .lookbook-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .lookbook-grid {
      grid-template-columns: 1.5fr 1fr;
      grid-template-rows: auto auto;
    }
    .lookbook-grid__item--large {
      grid-row: 1 / 3;
    }
  }
  .lookbook-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }
  .lookbook-item__image {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .lookbook-item:hover .lookbook-item__image {
    transform: scale(1.03);
  }
  .lookbook-grid__item--large { min-height: 500px; }
  .lookbook-grid__item--small { min-height: 240px; }

  .hotspot {
    position: absolute;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--color-cta);
    border: 3px solid #fff;
    cursor: pointer;
    z-index: 3;
    animation: hotspot-pulse 2s infinite;
  }
  @keyframes hotspot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0,149,255,0.4); }
    50% { box-shadow: 0 0 0 10px rgba(0,149,255,0); }
  }

  .lookbook-item__label {
    position: absolute;
    bottom: 16px; left: 16px;
    background: rgba(255,255,255,0.9);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-heading);
    z-index: 3;
  }
</style>

<section class="lookbook-section">
  <div class="container">
    <h2 class="lookbook-section__heading">The Seravolve Lookbook</h2>
    <div class="lookbook-grid">
      <div class="lookbook-item lookbook-grid__item--large">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=800&q=80" alt="Seravolve skincare routine" loading="lazy">
        <span class="hotspot" style="top: 40%; left: 35%;"></span>
        <span class="hotspot" style="top: 70%; left: 50%;"></span>
        <span class="lookbook-item__label">Full Seravolve Routine</span>
      </div>
      <div class="lookbook-item lookbook-grid__item--small">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80" alt="Seravolve Serum" loading="lazy">
        <span class="hotspot" style="top: 45%; left: 40%;"></span>
        <span class="lookbook-item__label">Vitamin C Serum</span>
      </div>
      <div class="lookbook-item lookbook-grid__item--small">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=500&q=80" alt="Seravolve Moisturiser" loading="lazy">
        <span class="hotspot" style="top: 50%; left: 60%;"></span>
        <span class="lookbook-item__label">Moisturiser</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shoppable Lookbook",
  "settings": [],
  "presets": [{ "name": "Shoppable Lookbook" }]
}
{% endschema %}
