<style>
  .lookbook-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alternate);
    overflow: hidden;
  }
  .lookbook-section__heading {
    text-align: center;
    margin-bottom: 8px;
  }
  .lookbook-section__subtext {
    text-align: center;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-lg);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Responsive Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .gallery-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #fff;
    box-shadow: 0 4px 15px rgba(0,149,255,0.03);
    cursor: pointer;
  }
  
  /* Highlight videos with a slightly larger grid space or just badge */
  .gallery-item--video {
    border: 2px solid var(--color-cta);
  }

  .gallery-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .gallery-item:hover .gallery-item__image {
    transform: scale(1.05);
  }

  .gallery-item__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(18,59,90,0.85);
    color: #fff;
    padding: 3px 8px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: 4px;
    z-index: 2;
  }
  .gallery-item__badge--video {
    background: var(--color-cta);
  }

  .gallery-item__play-btn {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 44px; height: 44px;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }
  .gallery-item__play-btn svg {
    margin-left: 2px;
    fill: var(--color-cta);
  }

  /* Lightbox Modal (Premium feature) */
  .lightbox-modal {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(18,59,90,0.95);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .lightbox-modal__close {
    position: absolute;
    top: 20px; right: 20px;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
  }
  .lightbox-modal__content {
    max-width: 90%;
    max-height: 80vh;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
  }
  .lightbox-modal__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>

