      <div class="gallery-item gi-7 gallery-item--video" data-type="video" aria-label="Play Launch Event Video 2">
        <span class="gallery-item__badge gallery-item__badge--video">Video</span>
        <img class="gallery-item__image" src="{{ 'event-sky_5922.jpg' | asset_url }}" alt="Launch event video 2" loading="lazy">
        <div class="gallery-item__play-btn">
          <svg width="14" height="14" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
