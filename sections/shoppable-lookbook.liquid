<style>
  .lookbook-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .lookbook-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .lookbook-grid {
      grid-template-columns: 1.5fr 1fr;
      grid-template-rows: auto auto;
    }
    .lookbook-grid__item--large {
      grid-row: 1 / 3;
    }
  }
  .lookbook-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }
  .lookbook-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .lookbook-item:hover .lookbook-item__image {
    transform: scale(1.03);
  }
  .lookbook-grid__item--large {
    min-height: 500px;
  }
  .lookbook-grid__item--small {
    min-height: 240px;
  }

  /* Hotspot dots */
  .hotspot {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #C0392B;
    border: 3px solid #fff;
    cursor: pointer;
    z-index: 3;
    animation: hotspot-pulse 2s infinite;
  }
  @keyframes hotspot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(192,57,43,0.4); }
    50% { box-shadow: 0 0 0 10px rgba(192,57,43,0); }
  }
</style>

<section class="lookbook-section">
  <div class="container">
    <div class="lookbook-grid">
      <!-- Large image (left, spans 2 rows) -->
      <div class="lookbook-item lookbook-grid__item--large">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=800&q=80" alt="Model with skincare" loading="lazy">
        <span class="hotspot" style="top: 40%; left: 35%;"></span>
        <span class="hotspot" style="top: 70%; left: 50%;"></span>
      </div>

      <!-- Top-right image -->
      <div class="lookbook-item lookbook-grid__item--small">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=500&q=80" alt="Product bottles" loading="lazy">
        <span class="hotspot" style="top: 45%; left: 40%;"></span>
      </div>

      <!-- Bottom-right image -->
      <div class="lookbook-item lookbook-grid__item--small">
        <img class="lookbook-item__image" src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=500&q=80" alt="Close-up skincare" loading="lazy">
        <span class="hotspot" style="top: 50%; left: 60%;"></span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shoppable Lookbook",
  "settings": [],
  "presets": [{ "name": "Shoppable Lookbook" }]
}
{% endschema %}
