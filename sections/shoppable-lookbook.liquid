      </div>

      <!-- Column 4 -->
      <div class="gallery-item gi-8" data-type="image" aria-label="View Event Photo 6">
        <span class="gallery-item__badge">Photo</span>
        <img class="gallery-item__image" src="{{ 'event-sky_5923.jpg' | asset_url }}" alt="Launch event photo 5923" loading="lazy">
      </div>

      <div class="gallery-item gi-9" data-type="image" aria-label="View Event Photo 7">
        <span class="gallery-item__badge">Photo</span>
        <img class="gallery-item__image" src="{{ 'event-sky_5924.jpg' | asset_url }}" alt="Launch event photo 5924" loading="lazy">
      </div>

      <!-- Column 5 (Right-most) -->
      <div class="gallery-item gi-10" data-type="image" aria-label="View Event Photo 8">
