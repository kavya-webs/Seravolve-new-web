<style>
  .collection-categories {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .collection-categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .collection-categories__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .category-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 3/4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-decoration: none;
  }
  .category-card__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }
  .category-card__label {
    position: relative;
    z-index: 2;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: #fff;
    padding-bottom: var(--spacing-lg);
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
</style>

<section class="collection-categories">
  <div class="container">
    <div class="collection-categories__grid">
      <a href="{{ routes.all_products_collection_url }}" class="category-card">
        <img class="category-card__image" src="https://images.unsplash.com/photo-1596755389378-c31d21fd1273?w=600&q=80" alt="Skin Care" loading="lazy">
        <span class="category-card__label">Skin Care</span>
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="category-card">
        <img class="category-card__image" src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=600&q=80" alt="Sets" loading="lazy">
        <span class="category-card__label">Sets</span>
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="category-card">
        <img class="category-card__image" src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="Make Up" loading="lazy">
        <span class="category-card__label">Make Up</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Categories",
  "settings": [],
  "presets": [{ "name": "Collection Categories" }]
}
{% endschema %}
