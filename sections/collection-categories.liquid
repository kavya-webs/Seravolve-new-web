<style>
  .collection-categories {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .collection-categories__heading {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  .collection-categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .collection-categories__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .category-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3/4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-decoration: none;
  }
  .category-card__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }
  .category-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 40%;
    background: linear-gradient(to top, rgba(18,59,90,0.7), transparent);
    z-index: 1;
  }
  .category-card__label {
    position: relative;
    z-index: 2;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: #fff;
    padding-bottom: var(--spacing-lg);
  }
</style>

<section class="collection-categories">
  <div class="container">
    <h2 class="collection-categories__heading">Shop By Category</h2>
    <div class="collection-categories__grid">
      
      {%- assign col_products = collections['products'] | default: collections['all'] -%}
      <a href="{{ col_products.url | default: routes.all_products_collection_url }}" class="category-card">
        {%- if col_products and col_products.image -%}
          <img class="category-card__image" src="{{ col_products.image | image_url: width: 600 }}" alt="Products" loading="lazy">
        {%- else -%}
          <img class="category-card__image" src="{{ 'full-seravolve-routine-hero.png' | asset_url }}" alt="Products" loading="lazy">
        {%- endif -%}
        <span class="category-card__label">Products</span>
      </a>

      {%- assign col_routines = collections['routines'] | default: collections['all'] -%}
      <a href="{{ col_routines.url | default: routes.all_products_collection_url }}" class="category-card">
        {%- if col_routines and col_routines.image -%}
          <img class="category-card__image" src="{{ col_routines.image | image_url: width: 600 }}" alt="Routines" loading="lazy">
        {%- else -%}
          <img class="category-card__image" src="{{ 'barrier-repair-and-hydration-routine-hero.png' | asset_url }}" alt="Routines" loading="lazy">
        {%- endif -%}
        <span class="category-card__label">Routines</span>
      </a>

      {%- assign col_bestsellers = collections['bestsellers'] | default: collections['all'] -%}
      <a href="{{ col_bestsellers.url | default: routes.all_products_collection_url }}" class="category-card">
        {%- if col_bestsellers and col_bestsellers.image -%}
          <img class="category-card__image" src="{{ col_bestsellers.image | image_url: width: 600 }}" alt="Bestsellers" loading="lazy">
        {%- else -%}
          <img class="category-card__image" src="{{ 'seravolve-vitamin-c-serum.png' | asset_url }}" alt="Bestsellers" loading="lazy">
        {%- endif -%}
        <span class="category-card__label">Bestsellers</span>
      </a>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Categories",
  "settings": [],
  "presets": [{ "name": "Collection Categories" }]
}
{% endschema %}
