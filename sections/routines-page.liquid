<style>
  /* ============================================
     ROUTINES PAGE — Curated Skincare Routines
     ============================================ */

  /* Hero */
  .routines-hero {
    padding: var(--spacing-xxl) 0 var(--spacing-xl);
    text-align: center;
    background: var(--color-bg-primary);
  }
  .routines-hero__badge {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  .routines-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    margin-bottom: var(--spacing-sm);
  }
  .routines-hero__subtitle {
    color: var(--color-text-body);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Concern Filter Tabs */
  .routines-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 0 20px var(--spacing-xl);
    background: var(--color-bg-primary);
  }
  .routines-filter-btn {
    padding: 10px 22px;
    border-radius: 50px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .routines-filter-btn:hover,
  .routines-filter-btn.is-active {
    background: var(--color-cta);
    color: #fff;
    border-color: var(--color-cta);
  }

  /* Routine Cards Grid */
  .routines-grid {
    padding: 0 0 var(--spacing-xxl);
    background: var(--color-bg-primary);
  }
  .routines-grid__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  @media (min-width: 768px) {
    .routines-grid__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .routines-grid__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Individual Routine Card */
  .routine-card {
    background: var(--color-bg-primary);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .routine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.08);
  }
  .routine-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .routine-card__body {
    padding: var(--spacing-md);
  }
  .routine-card__concern {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .routine-card__title {
    font-size: 1.35rem;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .routine-card__desc {
    color: var(--color-text-body);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  /* Step Indicators */
  .routine-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--spacing-md);
  }
  .routine-step {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .routine-step__number {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .routine-step__text {
    font-size: 0.85rem;
    color: var(--color-text-heading);
    font-weight: 500;
  }

  /* Card Footer */
  .routine-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: var(--spacing-sm);
    border-top: 1px solid rgba(0,0,0,0.06);
  }
  .routine-card__discount {
    background: #E8F9EE;
    color: var(--color-success);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .routine-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-cta);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.3s ease;
  }
  .routine-card__cta:hover {
    gap: 10px;
    opacity: 1;
  }

  /* Bottom CTA Banner */
  .routines-cta {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alternate);
    text-align: center;
  }
  .routines-cta__title {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    margin-bottom: var(--spacing-xs);
  }
  .routines-cta__text {
    color: var(--color-text-body);
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
  }
</style>

