<style>
  /* ============================================
     SERAVOLVE HIGH-PERFORMANCE PDP
     Matches routine-preset reference PDP design & functionality
     Dynamically powered by Shopify product & collection data
     ============================================ */

  .pdp-wrapper {
    padding: var(--spacing-md) 0 var(--spacing-xxl);
    background-color: var(--color-bg-primary);
    color: var(--color-text-heading);
  }

  /* Breadcrumbs */
  .pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-md);
  }
  .pdp-breadcrumbs a {
    color: var(--color-text-body);
    text-decoration: none;
    transition: color 0.2s;
  }
  .pdp-breadcrumbs a:hover {
    color: var(--color-cta);
  }
  .pdp-breadcrumbs__sep {
    opacity: 0.4;
  }

  /* Main 2-Column Product Section */
  .pdp-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }
  @media (min-width: 900px) {
    .pdp-main-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Gallery Component */
  .pdp-gallery-container {
    position: relative;
  }
  @media (min-width: 900px) {
    .pdp-gallery-container {
      position: sticky;
      top: 100px;
    }
  }
  .pdp-main-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    margin-bottom: 16px;
  }
  .pdp-main-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }
  .pdp-main-media:hover {
    transform: scale(1.03);
  }
  .pdp-gallery-thumbnails {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .pdp-thumbnail {
    width: 80px;
    height: 80px;
    min-width: 80px;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    background-color: var(--color-bg-secondary);
    transition: all 0.25s ease;
  }
  .pdp-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-thumbnail.is-active,
  .pdp-thumbnail:hover {
    border-color: var(--color-cta);
    opacity: 1;
  }

  /* Right Buy Column */
  .pdp-details-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pdp-vendor {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-cta);
  }
  .pdp-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    line-height: 1.15;
    margin: 0;
  }
  
  /* Rating */
  .pdp-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-body);
  }
  .pdp-stars {
    color: #FFB800;
    letter-spacing: 2px;
  }

  /* Price & Stock */
  .pdp-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pdp-current-price {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .pdp-compare-price {
    font-size: 1.1rem;
    color: #94A3B8;
    text-decoration: line-through;
  }
  .pdp-badge-bestseller {
    background: var(--color-bg-dark);
    color: #FFF;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .pdp-stock-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #10B981;
  }
  .pdp-stock-status.is-out {
    color: #EF4444;
  }
  .pdp-stock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .pdp-description-excerpt {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Mini Feature Badges */
  .pdp-mini-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .pdp-mini-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Countdown Banner Bar */
  .pdp-sale-banner {
    background: linear-gradient(135deg, #123B5A 0%, #0A5C8F 100%);
    color: #FFF;
    padding: 14px 18px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(18, 59, 90, 0.2);
  }
  .pdp-timer-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .pdp-timer-box {
    background: rgba(255, 255, 255, 0.18);
    color: #FFF;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    min-width: 32px;
    text-align: center;
  }

  /* Variants Picker */
  .pdp-option-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pdp-option-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
  }
  .pdp-option-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pdp-option-pill {
    padding: 10px 22px;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    background: #FFF;
    transition: all 0.25s ease;
    user-select: none;
  }
  .pdp-option-pill.is-selected,
  .pdp-option-pill:hover {
    border-color: var(--color-cta);
    background: var(--color-bg-alternate);
    color: var(--color-cta);
  }

  /* Key Ingredients Breakdown Bar */
  .pdp-ingredients-card {
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 16px;
  }
  .pdp-ingredients-header {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
    margin-bottom: 10px;
  }
  .pdp-ingredients-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pdp-ingredient-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FFF;
    padding: 6px 14px;
    border-radius: 50px;
    border: 1px solid #CBD5E1;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }
  .pdp-ingredient-tag strong {
    color: var(--color-cta);
  }

  /* Add to Cart / Form Buttons */
  .pdp-form-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .pdp-actions-row {
    display: flex;
    gap: 12px;
  }
  .pdp-qty-stepper {
    display: flex;
    align-items: center;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    overflow: hidden;
    background: #FFF;
  }
  .pdp-qty-btn {
    width: 42px;
    height: 48px;
    background: none;
    border: none;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--color-text-heading);
    transition: background 0.2s;
  }
  .pdp-qty-btn:hover {
    background: #F1F5F9;
  }
  .pdp-qty-val {
    width: 36px;
    text-align: center;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    outline: none;
  }
  .btn-add-cart {
    flex: 1;
    height: 48px;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 50px;
  }
  .btn-buy-now {
    width: 100%;
    height: 48px;
    background: #FFF;
    color: var(--color-cta);
    border: 2.5px solid var(--color-cta);
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .btn-buy-now:hover {
    background: var(--color-cta);
    color: #FFF;
  }

  /* Trust Badges */
  .pdp-trust-bar {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-body);
    opacity: 0.85;
  }

  /* Part of Routine Section */
  .pdp-routine-callout {
    background: #EEF8FF;
    border: 1.5px solid rgba(0, 149, 255, 0.25);
    border-radius: 18px;
    padding: 20px;
    margin-top: 8px;
  }
  .pdp-routine-callout__title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-cta);
    margin-bottom: 12px;
  }
  .pdp-routine-avatars {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }
  .pdp-avatar-circle {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #FFF;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }
  .pdp-avatar-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-avatar-play {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    font-size: 0.65rem;
  }

  /* Accordions */
  .pdp-accordion-group {
    margin-top: 12px;
    border-top: 1px solid #E2E8F0;
  }
  .pdp-accordion-item {
    border-bottom: 1px solid #E2E8F0;
  }
  .pdp-accordion-trigger {
    width: 100%;
    padding: 16px 0;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-heading);
    cursor: pointer;
    text-align: left;
  }
  .pdp-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .pdp-accordion-item.is-open .pdp-accordion-content {
    max-height: 400px;
    padding-bottom: 16px;
  }
  .pdp-accordion-icon {
    font-size: 1.3rem;
    color: var(--color-cta);
    transition: transform 0.3s;
  }
  .pdp-accordion-item.is-open .pdp-accordion-icon {
    transform: rotate(45deg);
  }

  /* ============================================
     SECTION 2: STEPS TO HEALTHIER SKIN
     ============================================ */
  .pdp-steps-section {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-secondary);
    text-align: center;
  }
  .pdp-steps-header {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: var(--spacing-xl);
    font-family: var(--font-heading);
  }
  .pdp-steps-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .pdp-steps-cards-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  .pdp-step-card-box {
    background: #FFF;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    text-align: center;
    padding-bottom: 20px;
    border: 1px solid rgba(0,0,0,0.04);
    transition: transform 0.3s;
  }
  .pdp-step-card-box:hover {
    transform: translateY(-4px);
  }
  .pdp-step-card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .pdp-step-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-step-pill-badge {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-cta);
    color: #FFF;
    padding: 5px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 12px rgba(0,149,255,0.4);
  }
  .pdp-step-card-title {
    font-size: 1.15rem;
    font-family: var(--font-heading);
    margin-bottom: 4px;
    color: var(--color-text-heading);
  }
  .pdp-step-card-text {
    font-size: 0.825rem;
    color: var(--color-text-body);
    padding: 0 12px;
    line-height: 1.5;
  }

  /* ============================================
     SECTION 3: WHY YOU'LL LOVE IT (RADIAL DIAGRAM)
     ============================================ */
  .pdp-why-love-section {
    padding: var(--spacing-xxl) 0;
    background: #FFF;
    text-align: center;
  }
  .pdp-why-love-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 8px;
    font-family: var(--font-heading);
  }
  .pdp-why-love-sub {
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-xl);
  }
  .pdp-radial-wrapper {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .pdp-radial-wrapper {
      grid-template-columns: 1fr 280px 1fr;
    }
  }
  .pdp-radial-center-node {
    width: 230px;
    height: 230px;
    margin: 0 auto;
    border-radius: 50%;
    background: #EEF8FF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 24px rgba(238, 248, 255, 0.6);
  }
  .pdp-radial-center-node img {
    max-height: 190px;
    object-fit: contain;
  }
  .pdp-benefit-card {
    background: #FFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 18px;
    padding: 18px 20px;
    text-align: left;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: transform 0.3s, border-color 0.3s;
  }
  .pdp-benefit-card:hover {
    border-color: var(--color-cta);
    transform: translateY(-4px);
  }
  .pdp-benefit-num {
    display: inline-block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #EEF8FF;
    color: var(--color-cta);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    line-height: 26px;
    margin-bottom: 8px;
  }
  .pdp-benefit-head {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: 4px;
  }
  .pdp-benefit-desc {
    font-size: 0.825rem;
    color: var(--color-text-body);
    line-height: 1.45;
  }

  /* ============================================
     SECTION 4: SEE THE DIFFERENCE (BEFORE / AFTER)
     ============================================ */
  .pdp-difference-section {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-primary);
  }
  .pdp-difference-card {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 24px;
    overflow: hidden;
    background: #EEF8FF;
  }
  @media (min-width: 768px) {
    .pdp-difference-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pdp-difference-info {
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pdp-difference-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-family: var(--font-heading);
    margin-bottom: 16px;
  }
  .pdp-difference-text {
    color: var(--color-text-body);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .pdp-difference-media {
    position: relative;
    min-height: 360px;
  }
  .pdp-difference-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-tag-pill {
    position: absolute;
    bottom: 20px;
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #FFF;
  }
  .pdp-tag-pill--day1 { left: 20px; background: rgba(0,0,0,0.65); }
  .pdp-tag-pill--day14 { right: 20px; background: var(--color-cta); box-shadow: 0 4px 14px rgba(0,149,255,0.4); }

  /* ============================================
     SECTION 5: FIND YOUR PERFECT MATCH (MATRIX)
     ============================================ */
  .pdp-comparison-section {
    padding: var(--spacing-xxl) 0;
    background: #FFF;
    text-align: center;
  }
  .pdp-comparison-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: var(--spacing-xl);
    font-family: var(--font-heading);
  }
  .pdp-matrix-overflow {
    overflow-x: auto;
  }
  .pdp-matrix-layout {
    display: grid;
    grid-template-columns: 190px repeat(3, 1fr);
    gap: 14px;
    min-width: 720px;
    max-width: 980px;
    margin: 0 auto;
    align-items: stretch;
  }
  .pdp-matrix-column {
    background: #F8FAFC;
    border-radius: 22px;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1.5px solid #E2E8F0;
  }
  .pdp-matrix-column--hero {
    background: var(--color-bg-dark);
    color: #FFF;
    border-color: var(--color-bg-dark);
    box-shadow: 0 16px 40px rgba(18, 59, 90, 0.28);
  }
  .pdp-matrix-prod-img {
    height: 110px;
    object-fit: contain;
    margin: 0 auto 12px;
  }
  .pdp-matrix-prod-name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .pdp-matrix-prod-price {
    font-size: 0.85rem;
    opacity: 0.85;
    margin-bottom: 18px;
  }
  .pdp-matrix-row-cell {
    padding: 14px 0;
    border-top: 1px solid rgba(0,0,0,0.06);
    font-size: 0.875rem;
  }
  .pdp-matrix-column--hero .pdp-matrix-row-cell {
    border-top-color: rgba(255,255,255,0.15);
  }

  /* ============================================
     SECTION 6: LIFESTYLE HERO BANNER
     ============================================ */
  .pdp-hero-banner {
    position: relative;
    min-height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(18,59,90,0.88) 100%),
                url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&q=80') center center / cover no-repeat;
    padding: var(--spacing-xxl) 20px;
  }
  .pdp-hero-banner-title {
    color: #FFF;
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 24px;
    font-family: var(--font-heading);
  }
</style>

<!-- SEO Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: "Glow Drip Vitamin C Serum" | json }},
  "image": [
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | json }}
    {%- else -%}
      "https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=800"
    {%- endif -%}
  ],
  "description": {{ product.description | default: "Packed with powerful antioxidants, our Vitamin C Serum brightens, firms, and evens skin tone." | strip_html | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: "Seravolve" | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "42"
  }
}
</script>

<div class="pdp-wrapper">
  <div class="container">

    <!-- Breadcrumb Navigation -->
    <nav class="pdp-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
