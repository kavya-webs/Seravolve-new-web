<style>
  :root {
    --pdp-navy: #0A1E30;
    --pdp-blue: #184B79;
    --pdp-blush: #FCEBEA;
    --pdp-blush-light: #FFF5F4;
    --pdp-border: #E2E8F0;
    --pdp-green: #2F855A;
    --pdp-green-light: #C6F6D5;
    --pdp-text: #2D3748;
    --pdp-text-light: #718096;
    --pdp-spacing-xs: 4px;
    --pdp-spacing-sm: 8px;
    --pdp-spacing-md: 16px;
    --pdp-spacing-lg: 24px;
    --pdp-spacing-xl: 32px;
  }

  .product-section {
    padding: var(--pdp-spacing-lg) 0;
    background-color: #FFFFFF;
    color: var(--pdp-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .product-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--pdp-spacing-md);
  }

  /* Grid Layout for Desktop */
  @media (min-width: 992px) {
    .product-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
    .product-info {
      position: sticky;
      top: 40px;
      align-self: start;
    }
  }

  /* Breadcrumbs */
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--pdp-text-light);
    margin-bottom: var(--pdp-spacing-md);
  }
  .breadcrumbs a {
    color: var(--pdp-text-light);
    text-decoration: none;
  }
  .breadcrumbs span {
    font-weight: 600;
    color: var(--pdp-navy);
  }

  /* Gallery */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-md);
    margin-bottom: var(--pdp-spacing-xl);
  }
  .gallery-main-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
    background-color: var(--pdp-blush-light);
    display: block;
  }
  .gallery-main-wrapper {
    position: relative;
  }
  .gallery-expand-icon {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    color: var(--pdp-navy);
    cursor: pointer;
  }
  .gallery-thumbnail-strip {
    display: flex;
    gap: var(--pdp-spacing-sm);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gallery-thumbnail-strip::-webkit-scrollbar {
    display: none;
  }
  .thumbnail-btn {
    flex: 0 0 70px;
    height: 70px;
    border: 1px solid var(--pdp-border);
    border-radius: 8px;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    background: white;
    transition: all 0.2s;
  }
  .thumbnail-btn.is-active {
    border-color: var(--pdp-navy);
    border-width: 2px;
  }
  .thumbnail-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Product Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-md);
  }
  
  .product-vendor {
    font-size: 0.9rem;
    color: var(--pdp-text-light);
    margin: 0;
  }
  
  .product-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pdp-navy);
    margin: 0;
    line-height: 1.2;
  }
  @media (min-width: 992px) {
    .product-title {
      font-size: 2.25rem;
    }
  }

  .product-reviews {
    color: #ECC94B;
    font-size: 1.2rem;
    margin-top: -8px;
  }

  /* Pricing */
  .product-price-wrapper {
    display: flex;
    align-items: center;
    gap: var(--pdp-spacing-sm);
  }
  .price-regular {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pdp-navy);
  }
  .price-compare {
    font-size: 1.1rem;
    color: var(--pdp-text-light);
    text-decoration: line-through;
  }

  /* Badges */
  .product-badges {
    display: flex;
    gap: var(--pdp-spacing-sm);
    flex-wrap: wrap;
    margin-top: -4px;
  }
  .badge {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge--discount {
    background-color: var(--pdp-blush);
    color: var(--pdp-navy);
  }
  .badge--trending {
    background-color: var(--pdp-blue);
    color: white;
  }

  /* Description */
  .product-description {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--pdp-text);
  }

  /* Feature Icons */
  .feature-icons {
    display: flex;
    gap: var(--pdp-spacing-lg);
    margin: var(--pdp-spacing-sm) 0;
  }
  .feature-icon-item {
    display: flex;
    align-items: center;
    gap: var(--pdp-spacing-xs);
    font-size: 0.85rem;
    color: var(--pdp-text);
  }
  .feature-icon-item svg {
    width: 20px;
    height: 20px;
    color: var(--pdp-text-light);
  }

  /* Countdown Promo Block */
  .promo-block {
    background-color: var(--pdp-blush-light);
    border-radius: 12px;
    padding: var(--pdp-spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
  }
  .promo-tag {
    align-self: flex-start;
    background-color: var(--pdp-blue);
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .promo-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--pdp-navy);
    margin: 0;
  }
  .countdown-timer {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .countdown-box {
    background: var(--pdp-blush);
    color: var(--pdp-navy);
    padding: 6px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 45px;
  }
  .countdown-num {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }
  .countdown-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .countdown-sep {
    font-weight: 700;
    color: var(--pdp-navy);
  }

  /* Stock Status */
  .stock-status {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
    margin: var(--pdp-spacing-xs) 0;
  }
  .stock-text-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--pdp-text);
  }
  .stock-dot {
    width: 10px;
    height: 10px;
    background-color: var(--pdp-green);
    border-radius: 50%;
  }
  .stock-progress-bar {
    width: 100%;
    height: 4px;
    background-color: var(--pdp-border);
    border-radius: 2px;
    overflow: hidden;
  }
  .stock-progress-fill {
    height: 100%;
    background-color: var(--pdp-green);
    border-radius: 2px;
  }

  /* Variants */
  .variant-selector {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
  }
  .variant-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pdp-navy);
  }
  .variant-options {
    display: flex;
    gap: var(--pdp-spacing-sm);
    flex-wrap: wrap;
  }
  .variant-pill input {
    display: none;
  }
  .variant-pill label {
    padding: 8px 16px;
    border: 1px solid var(--pdp-text-light);
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    display: block;
  }
  .variant-pill input:checked + label {
    border-color: var(--pdp-navy);
    border-width: 2px;
    padding: 7px 15px; /* adjust for border width */
    font-weight: 600;
    color: var(--pdp-navy);
  }

  /* Quantity */
  .quantity-selector {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
  }
  .quantity-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pdp-navy);
  }
  .quantity-controls {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pdp-border);
    border-radius: 6px;
    overflow: hidden;
    width: fit-content;
  }
  .qty-btn {
    background: none;
    border: none;
    padding: 10px 16px;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--pdp-text);
  }
  .qty-input {
    width: 40px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--pdp-border);
    border-right: 1px solid var(--pdp-border);
    padding: 10px 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--pdp-navy);
    appearance: textfield;
  }
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Key Ingredients */
  .key-ingredients {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
    margin: var(--pdp-spacing-sm) 0;
  }
  .ingredients-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pdp-navy);
  }
  .ingredients-header svg {
    width: 14px;
    height: 14px;
    color: var(--pdp-text-light);
  }
  .ingredient-bars {
    background-color: var(--pdp-blush-light);
    border-radius: 12px;
    padding: var(--pdp-spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
  }
  .ingredient-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ingredient-bar-bg {
    width: 100%;
    height: 8px;
    background-color: white;
    border-radius: 4px;
    overflow: hidden;
  }
  .ingredient-bar-fill {
    height: 100%;
    background-color: var(--pdp-navy); /* Adapted to theme */
    border-radius: 4px;
  }
  .ingredient-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--pdp-text);
  }
  .ingredient-name {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ingredient-check {
    color: var(--pdp-blue);
  }

  /* Buttons */
  .product-actions {
    margin-top: var(--pdp-spacing-sm);
  }
  .product-actions form {
    display: flex;
    flex-direction: column;
    gap: var(--pdp-spacing-sm);
  }
  .btn {
    width: 100%;
    padding: 14px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s;
  }
  .btn-secondary {
    background-color: white;
    border: 1px solid var(--pdp-blue);
    color: var(--pdp-blue);
  }
  .btn-primary {
    background-color: var(--pdp-blue);
    border: 1px solid var(--pdp-blue);
    color: white;
  }
  .btn-secondary:hover {
    background-color: var(--pdp-blush);
  }
  .btn-primary:hover {
    background-color: var(--pdp-navy);
    border-color: var(--pdp-navy);
  }

  /* Trust & Share */
  .trust-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--pdp-spacing-sm);
    margin-top: var(--pdp-spacing-md);
  }
  .payment-icons {
    display: flex;
    gap: 6px;
    justify-content: center;
  }
  .payment-icons img,
  .payment-icons svg {
    height: 24px;
    width: auto;
  }
  .secure-checkout {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--pdp-text-light);
  }
  .secure-checkout svg {
    width: 12px;
    height: 12px;
  }
  .share-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--pdp-blue);
    text-decoration: none;
    font-weight: 500;
    align-self: flex-start;
    margin-top: var(--pdp-spacing-md);
  }

</style>

<section class="product-section">
  <div class="product-container">
    
    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
      <a href="/">Home</a> / <a href="/collections/all">All Collections</a> / <span>{{ product.title }}</span>
    </div>

    <div class="product-grid">
      
      <!-- Gallery -->
      <div class="product-gallery">
        {%- if product.media.size > 0 -%}
          <div class="gallery-main-wrapper">
            <img id="MainImage" class="gallery-main-image" src="{{ product.media.first | image_url: width: 1000 }}" alt="{{ product.media.first.alt | escape }}">
            <div class="gallery-expand-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          {%- if product.media.size > 1 -%}
            <div class="gallery-thumbnail-strip">
              {%- for media in product.media -%}
                <button type="button" class="thumbnail-btn {% if forloop.first %}is-active{% endif %}" data-image-url="{{ media | image_url: width: 1000 }}">
                  <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="gallery-main-wrapper">
            <img class="gallery-main-image" src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=1000&q=80" alt="Placeholder">
          </div>
        {%- endif -%}
      </div>

      <!-- Info Column -->
      <div class="product-info">
        
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when '@app' -%}
              {% render block %}
            
            {%- when 'brand_title' -%}
              <div {{ block.shopify_attributes }}>
                <p class="product-vendor">{{ product.vendor | default: shop.name }}</p>
                <h1 class="product-title">{{ product.title }}</h1>
              </div>

            {%- when 'reviews' -%}
              <div class="product-reviews" {{ block.shopify_attributes }}>
                ★★★★★ <!-- Placeholder for Judge.me app block if added here -->
              </div>

            {%- when 'price' -%}
              <div class="product-price-wrapper" {{ block.shopify_attributes }}>
                <span class="price-regular">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>

            {%- when 'badges' -%}
              <div class="product-badges" {{ block.shopify_attributes }}>
                {%- if block.settings.badge_1_text != blank -%}
                  <span class="badge badge--discount">{{ block.settings.badge_1_text }}</span>
                {%- endif -%}
                {%- if block.settings.badge_2_text != blank -%}
                  <span class="badge badge--trending">{{ block.settings.badge_2_text }}</span>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="product-description" {{ block.shopify_attributes }}>
                {{ product.description | strip_html | truncatewords: 20 }}
              </div>

            {%- when 'feature_icons' -%}
              <div class="feature-icons" {{ block.shopify_attributes }}>
                <div class="feature-icon-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2v20M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  All Skin Types
                </div>
                <div class="feature-icon-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  Cruelty Free
                </div>
              </div>

            {%- when 'countdown' -%}
              <div class="promo-block" {{ block.shopify_attributes }}>
                <div class="promo-tag">
                  {{ block.settings.tag_text }}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M11 2L2 13h9l-2 9 9-11h-9z"/></svg>
                </div>
                <h3 class="promo-title">{{ block.settings.promo_title }}</h3>
                <div class="countdown-timer" data-end-date="{{ block.settings.end_date }}">
                  <div class="countdown-box"><span class="countdown-num" id="cd-days">00</span><span class="countdown-label">Days</span></div>
                  <span class="countdown-sep">:</span>
                  <div class="countdown-box"><span class="countdown-num" id="cd-hours">00</span><span class="countdown-label">Hrs</span></div>
                  <span class="countdown-sep">:</span>
                  <div class="countdown-box"><span class="countdown-num" id="cd-mins">00</span><span class="countdown-label">Min</span></div>
                  <span class="countdown-sep">:</span>
                  <div class="countdown-box"><span class="countdown-num" id="cd-secs">00</span><span class="countdown-label">Sec</span></div>
                </div>
              </div>

            {%- when 'stock_status' -%}
              <div class="stock-status" {{ block.shopify_attributes }}>
                <div class="stock-text-row">
                  <div class="stock-dot"></div>
                  <span><strong>{{ block.settings.stock_number }}</strong> in stock, ready to ship</span>
                </div>
                <div class="stock-progress-bar">
                  <div class="stock-progress-fill" style="width: {{ block.settings.stock_percentage }}%;"></div>
                </div>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-selector" {{ block.shopify_attributes }}>
                  <span class="variant-label">Size: <span id="selected-variant-label">{{ product.selected_or_first_available_variant.title }}</span></span>
                  <div class="variant-options">
                    {%- for variant in product.variants -%}
                      <div class="variant-pill">
                        <input type="radio" name="id" id="Variant-{{ variant.id }}" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %}>
                        <label for="Variant-{{ variant.id }}">{{ variant.title }}</label>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="quantity-selector" {{ block.shopify_attributes }}>
                <span class="quantity-label">Quantity</span>
                <div class="quantity-controls">
                  <button type="button" class="qty-btn" id="qty-minus">−</button>
                  <input type="number" class="qty-input" name="quantity" id="qty-input" value="1" min="1" form="product-form">
                  <button type="button" class="qty-btn" id="qty-plus">+</button>
                </div>
              </div>

            {%- when 'key_ingredients' -%}
              <div class="key-ingredients" {{ block.shopify_attributes }}>
                <div class="ingredients-header">
                  Key Ingredients
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </div>
                <div class="ingredient-bars">
                  {%- if block.settings.ing_1_name != blank -%}
                  <div class="ingredient-item">
                    <div class="ingredient-bar-bg">
                      <div class="ingredient-bar-fill" style="width: {{ block.settings.ing_1_pct }}%;"></div>
                    </div>
                    <div class="ingredient-info">
                      <div class="ingredient-name">
                        <svg class="ingredient-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        {{ block.settings.ing_1_name }}
                      </div>
                      <span>{{ block.settings.ing_1_pct }}%</span>
                    </div>
                  </div>
                  {%- endif -%}
                  
                  {%- if block.settings.ing_2_name != blank -%}
                  <div class="ingredient-item">
                    <div class="ingredient-bar-bg">
                      <div class="ingredient-bar-fill" style="width: {{ block.settings.ing_2_pct }}%;"></div>
                    </div>
                    <div class="ingredient-info">
                      <div class="ingredient-name">
                        <svg class="ingredient-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        {{ block.settings.ing_2_name }}
                      </div>
                      <span>{{ block.settings.ing_2_pct }}%</span>
                    </div>
                  </div>
                  {%- endif -%}

                  {%- if block.settings.ing_3_name != blank -%}
                  <div class="ingredient-item">
                    <div class="ingredient-bar-bg">
                      <div class="ingredient-bar-fill" style="width: {{ block.settings.ing_3_pct }}%;"></div>
                    </div>
                    <div class="ingredient-info">
                      <div class="ingredient-name">
                        <svg class="ingredient-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        {{ block.settings.ing_3_name }}
                      </div>
                      <span>{{ block.settings.ing_3_pct }}%</span>
                    </div>
                  </div>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product-actions" {{ block.shopify_attributes }}>
                {% form 'product', product, id: 'product-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="product-variant-id">
                  <input type="hidden" name="return_to" value="/checkout" id="buy-now-input" disabled>
                  <button type="submit" name="add" class="btn btn-secondary">Add To Bag</button>
                  <button type="button" class="btn btn-primary" onclick="document.getElementById('buy-now-input').disabled = false; document.getElementById('product-form').submit();">Buy It Now</button>
                {% endform %}
              </div>

            {%- when 'trust_share' -%}
              <div class="trust-section" {{ block.shopify_attributes }}>
                <div class="payment-icons">
                  {{ 'visa' | payment_type_svg_tag }}
                  {{ 'master' | payment_type_svg_tag }}
                  {{ 'rupay' | payment_type_svg_tag }}
                  {{ 'upi' | payment_type_svg_tag }}
                </div>
                <div class="secure-checkout">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Secured checkout
                </div>
              </div>
              <a href="#" class="share-link" id="pdp-share-link" data-url="{{ shop.url }}{{ product.url }}" {{ block.shopify_attributes }}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
                SHARE
              </a>

          {%- endcase -%}
        {%- endfor -%}

      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Gallery Logic
    const mainImg = document.getElementById('MainImage');
    const thumbs = document.querySelectorAll('.thumbnail-btn');
    if(mainImg && thumbs.length > 0) {
      thumbs.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbs.forEach(t => t.classList.remove('is-active'));
          btn.classList.add('is-active');
          mainImg.style.opacity = '0';
          setTimeout(() => {
            mainImg.src = btn.dataset.imageUrl;
            mainImg.style.opacity = '1';
          }, 150);
        });
      });
    }

    // Quantity Logic
    const minus = document.getElementById('qty-minus');
    const plus = document.getElementById('qty-plus');
    const input = document.getElementById('qty-input');
    if(minus && plus && input) {
      minus.addEventListener('click', () => {
        if(input.value > 1) input.value = parseInt(input.value) - 1;
      });
      plus.addEventListener('click', () => {
        input.value = parseInt(input.value) + 1;
      });
    }

    // Variant Logic
    const variantRadios = document.querySelectorAll('.variant-pill input');
    const variantLabel = document.getElementById('selected-variant-label');
    const hiddenVariantInput = document.getElementById('product-variant-id');
    variantRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        if(e.target.checked) {
          if (variantLabel) variantLabel.textContent = e.target.nextElementSibling.textContent;
          if (hiddenVariantInput) hiddenVariantInput.value = e.target.value;
        }
      });
    });

    // Countdown Logic
    const countdownEl = document.querySelector('.countdown-timer');
    if(countdownEl) {
      const endDateStr = countdownEl.dataset.endDate;
      const endDate = new Date(endDateStr).getTime();
      const dayEl = document.getElementById('cd-days');
      const hrEl = document.getElementById('cd-hours');
      const minEl = document.getElementById('cd-mins');
      const secEl = document.getElementById('cd-secs');

      if(!isNaN(endDate)) {
        setInterval(() => {
          const now = new Date().getTime();
          const distance = endDate - now;
          if(distance < 0) return;
          
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if(dayEl) dayEl.textContent = days.toString().padStart(2, '0');
          if(hrEl) hrEl.textContent = hours.toString().padStart(2, '0');
          if(minEl) minEl.textContent = minutes.toString().padStart(2, '0');
          if(secEl) secEl.textContent = seconds.toString().padStart(2, '0');
        }, 1000);
      }
    }

    // Share Logic
    const shareLink = document.getElementById('pdp-share-link');
    if(shareLink) {
      shareLink.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = window.location.origin + shareLink.dataset.url;
        const title = document.title;
        
        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              url: url
            });
          } catch (err) {
            console.error('Error sharing:', err);
          }
        } else {
          // Fallback to clipboard
          navigator.clipboard.writeText(url).then(() => {
            alert('Link copied to clipboard!');
          });
        }
      });
    }
  });
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "image": {{ product.featured_image | image_url: width: 1200 | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    {%- if product.compare_at_price -%}
    "priceValidUntil": "2026-08-28",
    {%- endif -%}
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  }
}
</script>

