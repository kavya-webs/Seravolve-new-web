<script>
  // Image Thumbnail Swapper
  function changePDPImage(src, el) {
    const mainImg = document.getElementById('PDPMainImage');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.pdp-thumbnail').forEach(t => t.classList.remove('is-active'));
    if (el) el.classList.add('is-active');
  }

  // Variant Option Pill Selector
  function selectPDPVariantOption(value, el) {
    document.querySelectorAll('.pdp-option-pill').forEach(p => p.classList.remove('is-selected'));
    if (el) el.classList.add('is-selected');
    const label = document.getElementById('PDPOptionVal');
    if (label) label.textContent = value;
  }

  // Accordion Expand / Collapse
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.pdp-accordion-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.pdp-accordion-item');
        item.classList.toggle('is-open');
      });
    });
  });
</script>

