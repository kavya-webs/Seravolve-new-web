<style>
  .product-section {
    padding: var(--spacing-xl) 0;
  }
  .product-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  @media (min-width: 900px) {
    .product-grid-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  
  /* Left Gallery */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  @media (min-width: 900px) {
    .product-gallery {
      position: sticky;
      top: 100px; /* offset for header */
    }
  }
  .product-gallery__main-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
    background-color: var(--color-bg-secondary);
  }
  
  /* Right Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .product-info__badge {
    align-self: flex-start;
    background-color: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }
  .product-info__title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    margin: 0;
    line-height: 1.1;
  }
  .product-info__price {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text-body);
  }
  
  /* Variant Pills */
  .variant-picker {
    margin-top: var(--spacing-md);
  }
  .variant-picker__title {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .variant-picker__options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .variant-pill {
    display: inline-block;
  }
  .variant-pill input {
    display: none;
  }
  .variant-pill label {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid #E2E8F0;
    border-radius: 30px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .variant-pill input:checked + label {
    background-color: var(--color-bg-dark);
    color: #fff;
    border-color: var(--color-bg-dark);
  }
  .variant-pill input:disabled + label {
    opacity: 0.5;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Form & Actions */
  .product-form {
    margin-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .product-form__buttons {
    display: flex;
    gap: var(--spacing-sm);
  }
  .qty-input {
    width: 80px;
    padding: 12px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    text-align: center;
    font-family: inherit;
    font-size: 1rem;
  }
  .btn-add-to-cart {
    flex: 1;
    font-size: 1.125rem;
  }

  /* Accordions */
  .accordion-group {
    margin-top: var(--spacing-xl);
    border-top: 1px solid #E2E8F0;
  }
  .accordion {
    border-bottom: 1px solid #E2E8F0;
  }
  .accordion__btn {
    width: 100%;
    background: none;
    border: none;
    padding: var(--spacing-md) 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-heading);
    cursor: pointer;
    text-align: left;
  }
  .accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .accordion.is-open .accordion__content {
    max-height: 500px;
    padding-bottom: var(--spacing-md);
  }
  .accordion__icon {
    transition: transform 0.3s ease;
  }
  .accordion.is-open .accordion__icon {
    transform: rotate(45deg);
  }
</style>

<section class="product-section">
  <div class="container">
    <div class="product-grid-layout">
      
      <!-- Gallery -->
      <div class="product-gallery">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <img class="product-gallery__main-image" src="{{ media | image_url: width: 1000 }}" alt="{{ media.alt | escape }}">
          {%- endfor -%}
        {%- else -%}
          <img class="product-gallery__main-image" src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=1000&q=80" alt="Dummy Product">
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">
        {%- if product.tags contains 'Trending' -%}
          <span class="product-info__badge">Trending</span>
        {%- endif -%}
        
        <h1 class="product-info__title">{{ product.title | default: 'Seravolve Glow Serum' }}</h1>
        <div class="product-info__price">{{ product.price | default: 4500 | money }}</div>

        {%- unless product.has_only_default_variant -%}
          <div class="variant-picker">
            {%- for option in product.options_with_values -%}
              <div class="variant-picker__title">{{ option.name }}</div>
              <div class="variant-picker__options">
                {%- for value in option.values -%}
                  <div class="variant-pill">
                    <input type="radio" id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ value }}</label>
                  </div>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- form 'product', product, class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <div class="product-form__buttons">
            <input type="number" name="quantity" class="qty-input" value="1" min="1">
            <button type="submit" name="add" class="btn btn-add-to-cart" {% if product.available == false %}disabled{% endif %}>
              {%- if product.available -%}
                Add to Cart
              {%- else -%}
                Out of Stock
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        <div class="product-description" style="margin-top: 16px;">
          {{ product.description | default: '<p>A powerful antioxidant serum designed to brighten and smooth the complexion. Formulated with clinical-grade ingredients for visible results.</p>' }}
        </div>

        <!-- Accordions -->
        <div class="accordion-group">
          <div class="accordion">
            <button class="accordion__btn">
              Ingredients
              <svg class="accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 0V14M0 7H14" stroke="currentColor" stroke-width="2"/></svg>
            </button>
            <div class="accordion__content">
              <p>Water, Niacinamide, Glycerin, Sodium Hyaluronate, Ascorbic Acid.</p>
            </div>
          </div>
          <div class="accordion">
            <button class="accordion__btn">
              How to Use
              <svg class="accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 0V14M0 7H14" stroke="currentColor" stroke-width="2"/></svg>
            </button>
            <div class="accordion__content">
              <p>Apply 2-3 drops to clean skin morning and night. Follow with moisturizer.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Simple Accordion Logic
  document.querySelectorAll('.accordion__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.accordion');
      parent.classList.toggle('is-open');
    });
  });
</script>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
