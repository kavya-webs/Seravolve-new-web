<style>
  /* ============================================
     SERAVOLVE RICH PRODUCT DETAIL PAGE (PDP)
     Matches reference layout & Seravolve Blue Palette
     ============================================ */

  .pdp-section {
    padding: var(--spacing-md) 0 var(--spacing-xxl);
    background-color: var(--color-bg-primary);
  }

  /* Breadcrumbs */
  .pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-md);
  }
  .pdp-breadcrumbs a {
    color: var(--color-text-body);
    text-decoration: none;
  }
  .pdp-breadcrumbs a:hover {
    color: var(--color-cta);
  }
  .pdp-breadcrumbs__sep {
    opacity: 0.4;
  }

  /* Main 2-Column Grid */
  .pdp-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }
  @media (min-width: 900px) {
    .pdp-main-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Gallery */
  .pdp-gallery {
    position: relative;
  }
  @media (min-width: 900px) {
    .pdp-gallery {
      position: sticky;
      top: 100px;
    }
  }
  .pdp-gallery__featured {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
    background-color: var(--color-bg-secondary);
    margin-bottom: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .pdp-gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .pdp-gallery__thumb {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background-color: var(--color-bg-secondary);
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }
  .pdp-gallery__thumb:hover,
  .pdp-gallery__thumb.is-active {
    border-color: var(--color-cta);
  }

  /* Product Summary Column */
  .pdp-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pdp-info__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-body);
  }
  .pdp-info__stars {
    color: #FFB800;
    font-size: 1rem;
    letter-spacing: 2px;
  }
  .pdp-info__title {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    line-height: 1.15;
    margin: 0;
  }
  .pdp-info__price-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pdp-info__price {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .pdp-info__compare-price {
    font-size: 1.1rem;
    color: #94A3B8;
    text-decoration: line-through;
  }
  .pdp-info__discount-badge {
    background: #EEF8FF;
    color: var(--color-cta);
    padding: 4px 10px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .pdp-info__summary {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Key Highlights Badges */
  .pdp-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .pdp-highlight-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }

  /* Sale Timer Pill Bar */
  .pdp-sale-timer {
    background: linear-gradient(135deg, #123B5A 0%, #0A5C8F 100%);
    color: #FFF;
    padding: 12px 18px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .pdp-sale-timer__pills {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .pdp-timer-pill {
    background: rgba(255,255,255,0.15);
    color: #FFF;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* Variant & Quantity Selectors */
  .pdp-variant-picker__label {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
  }
  .pdp-variant-options {
    display: flex;
    gap: 10px;
  }
  .pdp-variant-option {
    padding: 10px 22px;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.25s ease;
    background: #FFF;
  }
  .pdp-variant-option.is-selected {
    border-color: var(--color-cta);
    background: #EEF8FF;
    color: var(--color-cta);
  }

  /* Ingredients Breakdown Bar */
  .pdp-ingredients-bar {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px 16px;
  }
  .pdp-ingredients-bar__title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
    margin-bottom: 10px;
  }
  .pdp-ingredients-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pdp-ingredient-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FFF;
    padding: 6px 12px;
    border-radius: 50px;
    border: 1px solid #E2E8F0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-heading);
  }
  .pdp-ingredient-chip span {
    color: var(--color-cta);
  }

  /* Form & Actions */
  .pdp-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }
  .pdp-actions__row {
    display: flex;
    gap: 12px;
  }
  .pdp-qty {
    display: flex;
    align-items: center;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    overflow: hidden;
  }
  .pdp-qty__btn {
    width: 40px;
    height: 48px;
    background: none;
    border: none;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--color-text-heading);
  }
  .pdp-qty__input {
    width: 40px;
    text-align: center;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    outline: none;
  }
  .btn-pdp-cart {
    flex: 1;
    height: 48px;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .btn-pdp-buy {
    width: 100%;
    height: 48px;
    background: #FFF;
    color: var(--color-cta);
    border: 2px solid var(--color-cta);
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .btn-pdp-buy:hover {
    background: var(--color-cta);
    color: #FFF;
  }

  /* Trust Badges */
  .pdp-trust-badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    opacity: 0.75;
  }

  /* Part of Routine Callout Box */
  .pdp-routine-box {
    background: #EEF8FF;
    border: 1px solid rgba(0, 149, 255, 0.2);
    border-radius: 16px;
    padding: 18px;
    margin-top: 12px;
  }
  .pdp-routine-box__title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-cta);
    margin-bottom: 12px;
  }
  .pdp-customer-avatars {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
  .pdp-avatar {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #FFF;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }
  .pdp-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-avatar__play {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    font-size: 0.6rem;
  }
  .pdp-routine-pairs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .pdp-pair-card {
    background: #FFF;
    border-radius: 12px;
    padding: 12px;
    border: 1px solid #E2E8F0;
  }
  .pdp-pair-card__tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-cta);
    text-transform: uppercase;
  }
  .pdp-pair-card__title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 2px 0 4px;
  }

  /* Accordions */
  .pdp-accordions {
    margin-top: 12px;
    border-top: 1px solid #E2E8F0;
  }
  .pdp-accordion {
    border-bottom: 1px solid #E2E8F0;
  }
  .pdp-accordion__btn {
    width: 100%;
    padding: 16px 0;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-heading);
    cursor: pointer;
    text-align: left;
  }
  .pdp-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .pdp-accordion.is-open .pdp-accordion__content {
    max-height: 300px;
    padding-bottom: 16px;
  }
  .pdp-accordion.is-open .pdp-accordion__icon {
    transform: rotate(45deg);
  }
  .pdp-accordion__icon {
    transition: transform 0.3s;
    font-size: 1.2rem;
    color: var(--color-cta);
  }

  /* ============================================
     SECTION 2: STEPS TO HEALTHIER SKIN
     ============================================ */
  .pdp-steps-section {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-secondary);
    text-align: center;
  }
  .pdp-steps-section__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: var(--spacing-xl);
  }
  .pdp-steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .pdp-steps-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  .pdp-step-card {
    background: #FFF;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    text-align: center;
    padding-bottom: 20px;
    border: 1px solid rgba(0,0,0,0.04);
  }
  .pdp-step-card__img-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .pdp-step-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-step-card__badge {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-cta);
    color: #FFF;
    padding: 4px 16px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 12px rgba(0,149,255,0.4);
  }
  .pdp-step-card__title {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    margin-bottom: 4px;
    color: var(--color-text-heading);
  }
  .pdp-step-card__desc {
    font-size: 0.825rem;
    color: var(--color-text-body);
    padding: 0 12px;
  }

  /* ============================================
     SECTION 3: WHY YOU'LL LOVE IT (RADIAL DIAGRAM)
     ============================================ */
  .pdp-why-section {
    padding: var(--spacing-xxl) 0;
    background: #FFF;
    text-align: center;
  }
  .pdp-why-section__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 8px;
  }
  .pdp-why-section__subtitle {
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-xl);
  }
  .pdp-radial-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .pdp-radial-container {
      grid-template-columns: 1fr 280px 1fr;
    }
  }
  .pdp-radial-center {
    width: 220px;
    height: 220px;
    margin: 0 auto;
    border-radius: 50%;
    background: #EEF8FF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 20px rgba(238, 248, 255, 0.5);
  }
  .pdp-radial-center img {
    max-height: 180px;
    object-fit: contain;
  }
  .pdp-radial-node {
    background: #FFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 16px 20px;
    text-align: left;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: transform 0.3s, border-color 0.3s;
  }
  .pdp-radial-node:hover {
    border-color: var(--color-cta);
    transform: translateY(-4px);
  }
  .pdp-radial-node__num {
    display: inline-block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #EEF8FF;
    color: var(--color-cta);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    line-height: 24px;
    margin-bottom: 6px;
  }
  .pdp-radial-node__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: 2px;
  }
  .pdp-radial-node__desc {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }

  /* ============================================
     SECTION 4: SEE THE DIFFERENCE
     ============================================ */
  .pdp-diff-section {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-primary);
  }
  .pdp-diff-card {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 24px;
    overflow: hidden;
    background: #EEF8FF;
  }
  @media (min-width: 768px) {
    .pdp-diff-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pdp-diff-content {
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pdp-diff-content__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 16px;
  }
  .pdp-diff-content__text {
    color: var(--color-text-body);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .pdp-diff-image-wrapper {
    position: relative;
    min-height: 340px;
  }
  .pdp-diff-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-diff-tag {
    position: absolute;
    bottom: 20px;
    background: var(--color-cta);
    color: #FFF;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .pdp-diff-tag--before { left: 20px; background: rgba(0,0,0,0.6); }
  .pdp-diff-tag--after { right: 20px; }

  /* ============================================
     SECTION 5: FIND YOUR PERFECT MATCH (MATRIX)
     ============================================ */
  .pdp-matrix-section {
    padding: var(--spacing-xxl) 0;
    background: #FFF;
    text-align: center;
  }
  .pdp-matrix-section__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: var(--spacing-xl);
  }
  .pdp-matrix-table-wrapper {
    overflow-x: auto;
  }
  .pdp-matrix-grid {
    display: grid;
    grid-template-columns: 180px repeat(3, 1fr);
    gap: 12px;
    min-width: 700px;
    max-width: 960px;
    margin: 0 auto;
    align-items: stretch;
  }
  .pdp-matrix-col {
    background: #F8FAFC;
    border-radius: 20px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #E2E8F0;
  }
  .pdp-matrix-col--highlight {
    background: var(--color-bg-dark);
    color: #FFF;
    border-color: var(--color-bg-dark);
    box-shadow: 0 12px 36px rgba(18, 59, 90, 0.25);
  }
  .pdp-matrix-col__img {
    height: 100px;
    object-fit: contain;
    margin: 0 auto 12px;
  }
  .pdp-matrix-col__name {
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }
  .pdp-matrix-col__price {
    font-size: 0.85rem;
    opacity: 0.8;
    margin-bottom: 16px;
  }
  .pdp-matrix-cell {
    padding: 12px 0;
    border-top: 1px solid rgba(0,0,0,0.06);
    font-size: 0.85rem;
  }
  .pdp-matrix-col--highlight .pdp-matrix-cell {
    border-top-color: rgba(255,255,255,0.15);
  }

  /* ============================================
     SECTION 6: LIFESTYLE HERO BANNER
     ============================================ */
  .pdp-lifestyle-banner {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(18,59,90,0.85) 100%),
                url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&q=80') center center / cover no-repeat;
    padding: var(--spacing-xxl) 20px;
  }
  .pdp-lifestyle-banner__title {
    color: #FFF;
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin-bottom: 20px;
  }
</style>

<!-- SEO Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: "Glow Drip Vitamin C Serum" | json }},
  "image": [
    {{ product.featured_image | default: "https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=800" | image_url: width: 800 | json }}
  ],
  "description": {{ product.description | default: "Restore your skin youth & vibrancy with 10% Vitamin C Serum, lightweight hydration & barrier defense." | strip_html | json }},
  "brand": {
    "@type": "Brand",
    "name": "Seravolve"
  },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": "INR",
    "price": "749.00",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "42"
  }
}
</script>

<div class="pdp-section">
  <div class="container">

    <!-- Breadcrumbs -->
    <nav class="pdp-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="pdp-breadcrumbs__sep">/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <span class="pdp-breadcrumbs__sep">/</span>
      <span>{{ product.title | default: "Glow Drip Vitamin C Serum" }}</span>
    </nav>

    <!-- ===== TOP 2-COLUMN PDP GRID ===== -->
    <div class="pdp-main-grid">

      <!-- LEFT: MEDIA GALLERY -->
      <div class="pdp-gallery">
        {%- if product.featured_image -%}
          <img class="pdp-gallery__featured" id="PDPMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}">
        {%- else -%}
          <img class="pdp-gallery__featured" id="PDPMainImg" src="{{ 'seravolve-vitamin-c-serum.png' | asset_url }}" alt="Glow Drip Vitamin C Serum">
        {%- endif -%}

        <div class="pdp-gallery__thumbnails">
          <img class="pdp-gallery__thumb is-active" src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=600&q=80" alt="Model Skin Application" onclick="document.getElementById('PDPMainImg').src=this.src">
          <img class="pdp-gallery__thumb" src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=600&q=80" alt="Serum Droplet Texture" onclick="document.getElementById('PDPMainImg').src=this.src">
        </div>
      </div>

      <!-- RIGHT: PRODUCT BUY COLUMN -->
      <div class="pdp-info">

        <!-- Rating -->
        <div class="pdp-info__rating">
          <span class="pdp-info__stars">★★★★★</span>
          <span>5.0 (42 verified reviews)</span>
        </div>

        <!-- Title -->
        <h1 class="pdp-info__title">{{ product.title | default: "Glow Drip Vitamin C Serum" }}</h1>

        <!-- Price -->
        <div class="pdp-info__price-row">
          <span class="pdp-info__price">₹749.00</span>
          <span class="pdp-info__compare-price">₹999.00</span>
