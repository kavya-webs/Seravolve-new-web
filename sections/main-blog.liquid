<style>
  /* ============================================
     BLOG PAGE — Seravolve Skincare Journal
     ============================================ */

  /* Breadcrumb */
  .sera-blog-breadcrumb {
    padding: var(--spacing-md) 0 0;
    background: var(--color-bg-primary);
  }
  .sera-blog-breadcrumb__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--color-text-body);
  }
  .sera-blog-breadcrumb__list a {
    color: var(--color-cta);
    font-weight: 500;
  }
  .sera-blog-breadcrumb__list a:hover { opacity: 0.8; }
  .sera-blog-breadcrumb__sep { opacity: 0.4; }

  /* Hero */
  .sera-blog-hero {
    padding: var(--spacing-lg) 0;
    text-align: center;
    background: var(--color-bg-primary);
  }
  .sera-blog-hero__badge {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  .sera-blog-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    margin-bottom: var(--spacing-xs);
  }
  .sera-blog-hero__subtitle {
    color: var(--color-text-body);
    font-size: 1.05rem;
    max-width: 560px;
    margin: 0 auto var(--spacing-md);
    line-height: 1.7;
  }

  /* Search Bar */
  .sera-blog-search {
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }
  .sera-blog-search__input {
    width: 100%;
    padding: 14px 50px 14px 20px;
    border: 1.5px solid rgba(0,0,0,0.1);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    background: var(--color-bg-secondary);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .sera-blog-search__input:focus {
    border-color: var(--color-cta);
    box-shadow: 0 0 0 3px rgba(0,149,255,0.1);
  }
  .sera-blog-search__btn {
    position: absolute;
    right: 6px; top: 50%;
    transform: translateY(-50%);
    background: var(--color-cta);
    border: none;
    border-radius: 50%;
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s;
  }
  .sera-blog-search__btn:hover { background: var(--color-cta-hover); }
  .sera-blog-search__btn svg { width: 16px; height: 16px; }

  /* Category Filter Chips */
  .sera-blog-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 0 20px var(--spacing-lg);
    background: var(--color-bg-primary);
  }
  .sera-blog-filter-btn {
    padding: 10px 22px;
    border-radius: 50px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .sera-blog-filter-btn:hover,
  .sera-blog-filter-btn.is-active {
    background: var(--color-cta);
    color: #fff;
    border-color: var(--color-cta);
  }

  /* Featured Article Card */
  .sera-blog-featured {
    padding: 0 0 var(--spacing-xl);
    background: var(--color-bg-primary);
  }
  .sera-blog-featured__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-bg-secondary);
    transition: box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
  }
  .sera-blog-featured__card:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
    opacity: 1;
  }
  @media (min-width: 768px) {
    .sera-blog-featured__card {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .sera-blog-featured__image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .sera-blog-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .sera-blog-featured__card:hover .sera-blog-featured__image {
    transform: scale(1.03);
  }
  .sera-blog-featured__content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .sera-blog-featured__label {
    display: inline-block;
    background: var(--color-cta);
    color: #fff;
    padding: 4px 14px;
    border-radius: 50px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 16px;
    width: fit-content;
  }
  .sera-blog-featured__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-body);
    font-size: 0.8rem;
    margin-bottom: 12px;
  }
  .sera-blog-featured__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .sera-blog-featured__excerpt {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sera-blog-featured__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-cta);
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.3s;
  }
  .sera-blog-featured__link:hover {
    gap: 10px;
    opacity: 1;
  }

  /* Articles Grid */
  .sera-blog-grid {
    padding: 0 0 var(--spacing-xl);
    background: var(--color-bg-primary);
  }
  .sera-blog-grid__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 600px) {
    .sera-blog-grid__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sera-blog-grid__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Article Card */
  .sera-blog-card {
    background: var(--color-bg-primary);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .sera-blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.07);
    opacity: 1;
  }
  .sera-blog-card__image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .sera-blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .sera-blog-card:hover .sera-blog-card__image {
    transform: scale(1.05);
  }
  .sera-blog-card__body {
    padding: var(--spacing-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .sera-blog-card__category {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 12px;
    width: fit-content;
  }
  .sera-blog-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-body);
    font-size: 0.75rem;
    margin-bottom: 10px;
  }
  .sera-blog-card__title {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 10px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sera-blog-card__excerpt {
    color: var(--color-text-body);
    font-size: 0.85rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
    flex: 1;
  }
  .sera-blog-card__read {
    color: var(--color-cta);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.3s;
  }
  .sera-blog-card:hover .sera-blog-card__read {
    gap: 8px;
  }

  /* Inline Quiz CTA Card */
  .sera-blog-quiz-cta {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--color-bg-dark), #1a5276);
    border-radius: 20px;
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--spacing-sm);
    min-height: 220px;
  }
  .sera-blog-quiz-cta__emoji {
    font-size: 2.5rem;
  }
  .sera-blog-quiz-cta__title {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: #fff;
    margin-bottom: 0;
  }
  .sera-blog-quiz-cta__text {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem;
    max-width: 420px;
    line-height: 1.6;
  }
  .sera-blog-quiz-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: #fff;
    color: var(--color-bg-dark);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border-radius: 50px;
    border: none;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .sera-blog-quiz-cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    opacity: 1;
  }

  /* Newsletter CTA */
  .sera-blog-newsletter {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alternate);
    text-align: center;
  }
  .sera-blog-newsletter__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-bottom: var(--spacing-xs);
  }
  .sera-blog-newsletter__text {
    color: var(--color-text-body);
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .sera-blog-newsletter__form {
    display: flex;
    max-width: 440px;
    margin: 0 auto;
    gap: 0;
  }
  .sera-blog-newsletter__input {
    flex: 1;
    padding: 14px 20px;
    border: 1.5px solid rgba(0,0,0,0.1);
    border-radius: 50px 0 0 50px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.3s;
  }
  .sera-blog-newsletter__input:focus {
    border-color: var(--color-cta);
  }
  .sera-blog-newsletter__btn {
    padding: 14px 28px;
    background: var(--color-cta);
    color: #fff;
    border: none;
    border-radius: 0 50px 50px 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  .sera-blog-newsletter__btn:hover {
    background: var(--color-cta-hover);
  }

  /* Pagination */
  .sera-blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: var(--spacing-lg) 0 0;
  }
  .sera-blog-pagination a,
  .sera-blog-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s;
    color: var(--color-text-body);
  }
  .sera-blog-pagination a:hover {
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    opacity: 1;
  }
  .sera-blog-pagination .is-current {
    background: var(--color-cta);
    color: #fff;
  }
</style>

<!-- BreadcrumbList + Blog Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop.url }}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ blog.title | escape }}",
          "item": "{{ shop.url }}{{ blog.url }}"
        }
      ]
    },
    {
      "@type": "Blog",
      "name": "{{ blog.title | escape }}",
      "description": "Expert skincare tips, ingredient guides, and routine advice from the Seravolve team.",
      "url": "{{ shop.url }}{{ blog.url }}",
      "publisher": {
        "@type": "Organization",
        "name": "Seravolve",
        "url": "{{ shop.url }}"
      }
    }
  ]
}
</script>

{%- paginate blog.articles by 12 -%}

<!-- ===== BREADCRUMB ===== -->
<nav class="sera-blog-breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol class="sera-blog-breadcrumb__list">
      <li><a href="/">Home</a></li>
      <li class="sera-blog-breadcrumb__sep" aria-hidden="true">›</li>
      <li aria-current="page">{{ blog.title }}</li>
    </ol>
  </div>
</nav>

<!-- ===== HERO + SEARCH ===== -->
<section class="sera-blog-hero" aria-label="Blog hero">
  <div class="container">
    <span class="sera-blog-hero__badge">Skincare Journal</span>
    <h1 class="sera-blog-hero__title">{{ blog.title | default: "Skincare Tips & Expertise" }}</h1>
    <p class="sera-blog-hero__subtitle">Expert advice on ingredients, routines, and skin health — loved by our community.</p>
    <form class="sera-blog-search" action="/search" method="get" role="search" aria-label="Search blog articles">
      <input type="hidden" name="type" value="article">
      <input type="hidden" name="options[prefix]" value="last">
      <input
        class="sera-blog-search__input"
        type="search"
        name="q"
        placeholder="Search articles..."
        aria-label="Search articles"
      >
      <button class="sera-blog-search__btn" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
    </form>
  </div>
</section>

<!-- ===== CATEGORY FILTER CHIPS ===== -->
<nav class="sera-blog-filters" aria-label="Blog category filters">
  <button class="sera-blog-filter-btn is-active" data-blog-tag="all">All</button>
  <button class="sera-blog-filter-btn" data-blog-tag="routine">Skincare Routine</button>
  <button class="sera-blog-filter-btn" data-blog-tag="ingredients">Ingredients</button>
  <button class="sera-blog-filter-btn" data-blog-tag="skin concerns">Skin Concerns</button>
  <button class="sera-blog-filter-btn" data-blog-tag="lifestyle">Lifestyle</button>
</nav>

<!-- ===== FEATURED ARTICLE ===== -->
{%- if blog.articles.size > 0 -%}
  {%- assign featured = blog.articles.first -%}
  {%- assign featured_words = featured.content | strip_html | split: ' ' | size -%}
  {%- assign featured_read_time = featured_words | divided_by: 200 | plus: 1 -%}
  <section class="sera-blog-featured" aria-label="Featured article">
    <div class="container">
      <a href="{{ featured.url }}" class="sera-blog-featured__card" aria-label="Read featured article: {{ featured.title | escape }}">
        <div class="sera-blog-featured__image-wrapper">
          {%- if featured.image -%}
            <img
              class="sera-blog-featured__image"
              src="{{ featured.image | image_url: width: 800 }}"
              srcset="
                {{ featured.image | image_url: width: 400 }} 400w,
                {{ featured.image | image_url: width: 600 }} 600w,
                {{ featured.image | image_url: width: 800 }} 800w,
                {{ featured.image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 768px) 55vw, 100vw"
              alt="{{ featured.image.alt | default: featured.title | escape }}"
              width="{{ featured.image.width }}"
              height="{{ featured.image.height }}"
              loading="eager"
            >
          {%- else -%}
            <img class="sera-blog-featured__image" src="{{ 'smooth-skin-routine-lifestyle.png' | asset_url }}" alt="Seravolve Skincare featured article" loading="eager" width="800" height="500">
          {%- endif -%}
        </div>
        <div class="sera-blog-featured__content">
          <span class="sera-blog-featured__label">Featured</span>
          <div class="sera-blog-featured__meta">
            <time datetime="{{ featured.published_at | date: '%Y-%m-%d' }}">{{ featured.published_at | date: "%b %d, %Y" }}</time>
            <span aria-hidden="true">•</span>
            <span>{{ featured_read_time }} min read</span>
          </div>
          <h2 class="sera-blog-featured__title">{{ featured.title }}</h2>
          <p class="sera-blog-featured__excerpt">{{ featured.excerpt_or_content | strip_html | truncate: 180 }}</p>
          <span class="sera-blog-featured__link" aria-hidden="true">
            Read Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </span>
        </div>
      </a>
    </div>
  </section>
{%- endif -%}

<!-- ===== ARTICLES GRID ===== -->
<section class="sera-blog-grid" aria-label="Blog articles">
  <div class="container">
    <div class="sera-blog-grid__inner">

      {%- assign card_counter = 0 -%}
      {%- for article in blog.articles offset: 1 -%}
        {%- assign card_counter = card_counter | plus: 1 -%}
        {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
        {%- assign read_time = word_count | divided_by: 200 | plus: 1 -%}

        <a href="{{ article.url }}" class="sera-blog-card" data-tags="{{ article.tags | join: ',' | downcase }}" aria-label="Read article: {{ article.title | escape }}">
          <div class="sera-blog-card__image-wrapper">
            {%- if article.image -%}
              <img
                class="sera-blog-card__image"
                src="{{ article.image | image_url: width: 600 }}"
                srcset="
                  {{ article.image | image_url: width: 300 }} 300w,
                  {{ article.image | image_url: width: 450 }} 450w,
                  {{ article.image | image_url: width: 600 }} 600w
                "
                sizes="(min-width: 1024px) 33vw, (min-width: 600px) 50vw, 100vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <img class="sera-blog-card__image" src="{{ 'event-sky_5712.jpg' | asset_url }}" alt="Seravolve skincare article" loading="lazy" width="600" height="375">
            {%- endif -%}
          </div>
          <div class="sera-blog-card__body">
            {%- if article.tags.size > 0 -%}
              <span class="sera-blog-card__category">{{ article.tags.first }}</span>
            {%- else -%}
              <span class="sera-blog-card__category">Skincare</span>
            {%- endif -%}
            <div class="sera-blog-card__meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: "%b %d, %Y" }}</time>
              <span aria-hidden="true">•</span>
              <span>{{ read_time }} min read</span>
            </div>
            <h2 class="sera-blog-card__title">{{ article.title }}</h2>
            <p class="sera-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <span class="sera-blog-card__read" aria-hidden="true">
              Read Article <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </div>
        </a>

        {%- if card_counter == 6 -%}
          <!-- Quiz CTA inline card -->
          <div class="sera-blog-quiz-cta">
            <span class="sera-blog-quiz-cta__emoji" aria-hidden="true">✨</span>
            <h2 class="sera-blog-quiz-cta__title">Not Sure Where to Start?</h2>
            <p class="sera-blog-quiz-cta__text">Take our 60-second skin quiz and get a personalized routine — powered by science.</p>
            <a href="/pages/quiz" class="sera-blog-quiz-cta__btn">
              Take the Skin Quiz
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        {%- endif -%}

      {%- endfor -%}

    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="sera-blog-pagination" aria-label="Blog pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- else -%}
            <span class="{% if paginate.current_page == part.title %}is-current{% endif %}" {% if paginate.current_page == part.title %}aria-current="page"{% endif %}>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" aria-label="Next page">→</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</section>

<!-- ===== NEWSLETTER ===== -->
<section class="sera-blog-newsletter" aria-label="Newsletter signup">
  <div class="container">
    <h2 class="sera-blog-newsletter__title">Get Expert Skincare Advice in Your Inbox</h2>
    <p class="sera-blog-newsletter__text">Join 10,000+ readers who get our weekly skincare tips, product launches, and exclusive offers.</p>
    <form class="sera-blog-newsletter__form" aria-label="Newsletter signup form">
      <input type="email" class="sera-blog-newsletter__input" placeholder="Enter your email" required aria-label="Email address">
      <button type="submit" class="sera-blog-newsletter__btn">Subscribe</button>
    </form>
  </div>
</section>

{%- endpaginate -%}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const filterBtns = document.querySelectorAll('.sera-blog-filter-btn');
  const cards = document.querySelectorAll('.sera-blog-card');
  const featured = document.querySelector('.sera-blog-featured');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const tag = btn.dataset.blogTag;

      cards.forEach(card => {
        const tags = (card.dataset.tags || '').toLowerCase();
        if (tag === 'all' || tags.includes(tag)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      /* Hide featured card when filtering by tag */
      if (featured) {
        featured.style.display = tag === 'all' ? '' : 'none';
      }
    });
  });
});
</script>

