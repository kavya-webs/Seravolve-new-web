<style>
  /* ============================================
     BLOG PAGE — Skincare Tips & Expertise
     ============================================ */

  /* Hero */
  .blog-hero {
    padding: var(--spacing-xxl) 0 var(--spacing-lg);
    text-align: center;
    background: var(--color-bg-primary);
  }
  .blog-hero__badge {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  .blog-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    margin-bottom: var(--spacing-sm);
  }
  .blog-hero__subtitle {
    color: var(--color-text-body);
    font-size: 1.05rem;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Category Filter Chips */
  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 0 20px var(--spacing-lg);
    background: var(--color-bg-primary);
  }
  .blog-filter-btn {
    padding: 10px 22px;
    border-radius: 50px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .blog-filter-btn:hover,
  .blog-filter-btn.is-active {
    background: var(--color-cta);
    color: #fff;
    border-color: var(--color-cta);
  }

  /* Featured Article Card */
  .blog-featured {
    padding: 0 0 var(--spacing-xl);
    background: var(--color-bg-primary);
  }
  .blog-featured__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-bg-secondary);
    transition: box-shadow 0.3s;
  }
  .blog-featured__card:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }
  @media (min-width: 768px) {
    .blog-featured__card {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .blog-featured__image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .blog-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .blog-featured__card:hover .blog-featured__image {
    transform: scale(1.03);
  }
  .blog-featured__content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .blog-featured__label {
    display: inline-block;
    background: var(--color-cta);
    color: #fff;
    padding: 4px 14px;
    border-radius: 50px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 16px;
    width: fit-content;
  }
  .blog-featured__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-body);
    font-size: 0.8rem;
    margin-bottom: 12px;
  }
  .blog-featured__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .blog-featured__excerpt {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-featured__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-cta);
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.3s;
  }
  .blog-featured__link:hover {
    gap: 10px;
    opacity: 1;
  }

  /* Articles Grid */
  .blog-grid {
    padding: 0 0 var(--spacing-xl);
    background: var(--color-bg-primary);
  }
  .blog-grid__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  @media (min-width: 600px) {
    .blog-grid__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .blog-grid__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Article Card */
  .blog-card {
    background: var(--color-bg-primary);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.07);
    opacity: 1;
  }
  .blog-card__image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .blog-card:hover .blog-card__image {
    transform: scale(1.05);
  }
  .blog-card__body {
    padding: var(--spacing-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-card__category {
    display: inline-block;
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin-bottom: 12px;
    width: fit-content;
  }
  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-body);
    font-size: 0.75rem;
    margin-bottom: 10px;
  }
  .blog-card__title {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 10px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__excerpt {
    color: var(--color-text-body);
    font-size: 0.85rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
    flex: 1;
  }
  .blog-card__read {
    color: var(--color-cta);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.3s;
  }
  .blog-card:hover .blog-card__read {
    gap: 8px;
  }

  /* Newsletter CTA */
  .blog-newsletter {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alternate);
    text-align: center;
  }
  .blog-newsletter__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-bottom: var(--spacing-xs);
  }
  .blog-newsletter__text {
    color: var(--color-text-body);
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .blog-newsletter__form {
    display: flex;
    max-width: 440px;
    margin: 0 auto;
    gap: 0;
  }
  .blog-newsletter__input {
    flex: 1;
    padding: 14px 20px;
    border: 1.5px solid rgba(0,0,0,0.1);
    border-radius: 50px 0 0 50px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.3s;
  }
  .blog-newsletter__input:focus {
    border-color: var(--color-cta);
  }
  .blog-newsletter__btn {
    padding: 14px 28px;
    background: var(--color-cta);
    color: #fff;
    border: none;
    border-radius: 0 50px 50px 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  .blog-newsletter__btn:hover {
    background: var(--color-cta-hover);
  }

  /* Pagination */
  .blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: var(--spacing-lg) 0 0;
  }
  .blog-pagination a,
  .blog-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s;
    color: var(--color-text-body);
  }
  .blog-pagination a:hover {
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    opacity: 1;
  }
  .blog-pagination .is-current {
    background: var(--color-cta);
    color: #fff;
  }
</style>

<!-- SEO Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Seravolve Skincare Blog",
  "description": "Expert skincare tips, ingredient guides, dermatology insights, and routine advice from the Seravolve team.",
  "url": "{{ canonical_url }}",
  "publisher": {
    "@type": "Organization",
    "name": "Seravolve"
  }
}
</script>

{%- paginate blog.articles by 7 -%}

<!-- ===== HERO ===== -->
<section class="blog-hero" aria-label="Blog hero">
  <div class="container">
    <span class="blog-hero__badge">Skincare Journal</span>
    <h1 class="blog-hero__title">{{ blog.title | default: "Skincare Tips & Expertise" }}</h1>
    <p class="blog-hero__subtitle">Expert advice on ingredients, routines, and skin health — backed by dermatologists and loved by our community.</p>
  </div>
</section>

<!-- ===== CATEGORY FILTER CHIPS ===== -->
<div class="blog-filters" aria-label="Blog category filters">
  <button class="blog-filter-btn is-active" data-blog-tag="all">All</button>
  <button class="blog-filter-btn" data-blog-tag="routine">Skincare Routine</button>
  <button class="blog-filter-btn" data-blog-tag="ingredients">Ingredients</button>
  <button class="blog-filter-btn" data-blog-tag="dermatology">Dermatology Insights</button>
  <button class="blog-filter-btn" data-blog-tag="lifestyle">Lifestyle</button>
</div>

<!-- ===== FEATURED ARTICLE ===== -->
{%- if blog.articles.size > 0 -%}
  {%- assign featured = blog.articles.first -%}
  <section class="blog-featured" aria-label="Featured article">
    <div class="container">
      <a href="{{ featured.url }}" class="blog-featured__card" style="text-decoration:none;color:inherit;">
        <div class="blog-featured__image-wrapper">
          {%- if featured.image -%}
            <img class="blog-featured__image" src="{{ featured.image | image_url: width: 800 }}" alt="{{ featured.image.alt | escape }}" loading="lazy">
          {%- else -%}
            <img class="blog-featured__image" src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=800&q=80" alt="Skincare blog article" loading="lazy">
          {%- endif -%}
        </div>
        <div class="blog-featured__content">
          <span class="blog-featured__label">Featured</span>
          <div class="blog-featured__meta">
            <span>{{ featured.published_at | date: "%b %d, %Y" }}</span>
            <span>•</span>
            <span>{{ featured.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
          </div>
          <h2 class="blog-featured__title">{{ featured.title }}</h2>
          <p class="blog-featured__excerpt">{{ featured.excerpt_or_content | strip_html | truncate: 180 }}</p>
          <span class="blog-featured__link">
            Read Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </span>
        </div>
      </a>
    </div>
  </section>
{%- endif -%}

<!-- ===== ARTICLES GRID ===== -->
<section class="blog-grid" aria-label="Blog articles">
  <div class="container">
    <div class="blog-grid__inner">

      {%- for article in blog.articles offset: 1 -%}
        <a href="{{ article.url }}" class="blog-card" data-tags="{{ article.tags | join: ',' | downcase }}">
          <div class="blog-card__image-wrapper">
            {%- if article.image -%}
              <img class="blog-card__image" src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
            {%- else -%}
              <img class="blog-card__image" src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&q=80" alt="Skincare article" loading="lazy">
            {%- endif -%}
          </div>
          <div class="blog-card__body">
            {%- if article.tags.size > 0 -%}
              <span class="blog-card__category">{{ article.tags.first }}</span>
            {%- else -%}
              <span class="blog-card__category">Skincare</span>
            {%- endif -%}
            <div class="blog-card__meta">
              <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
              <span>•</span>
              <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
            </div>
            <h2 class="blog-card__title">{{ article.title }}</h2>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <span class="blog-card__read">
              Read Article <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}

    </div>

    {%- if paginate.pages > 1 -%}
      <div class="blog-pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">←</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="{% if paginate.current_page == part.title %}is-current{% endif %}">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">→</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- ===== NEWSLETTER ===== -->
<section class="blog-newsletter" aria-label="Newsletter signup">
  <div class="container">
    <h2 class="blog-newsletter__title">Get Expert Skincare Advice in Your Inbox</h2>
    <p class="blog-newsletter__text">Join 10,000+ readers who get our weekly skincare tips, product launches, and exclusive offers.</p>
    <form class="blog-newsletter__form">
      <input type="email" class="blog-newsletter__input" placeholder="Enter your email" required>
      <button type="submit" class="blog-newsletter__btn">Subscribe</button>
    </form>
  </div>
</section>

{%- endpaginate -%}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const filterBtns = document.querySelectorAll('.blog-filter-btn');
  const cards = document.querySelectorAll('.blog-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const tag = btn.dataset.blogTag;

      cards.forEach(card => {
        const tags = (card.dataset.tags || '').toLowerCase();
        if (tag === 'all' || tags.includes(tag)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
});
</script>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "grid", "label": "t:sections.main-blog.settings.layout.options__1.label" },
        { "value": "collage", "label": "t:sections.main-blog.settings.layout.options__2.label" }
      ],
      "default": "grid",
      "label": "t:sections.main-blog.settings.layout.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "adapt", "label": "t:sections.main-blog.settings.image_height.options__1.label" },
        { "value": "medium", "label": "t:sections.main-blog.settings.image_height.options__3.label" }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ]
}
{% endschema %}
