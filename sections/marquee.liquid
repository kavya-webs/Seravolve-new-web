<style>
  .marquee-section {
    background-color: var(--color-bg-primary);
    padding: var(--spacing-md) 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .marquee-content {
    display: flex;
    align-items: center;
    animation: marquee 25s linear infinite;
  }
  .marquee-content__item {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 1px;
    padding: 0 var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--color-text-heading);
  }
  .marquee-content__thumb {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<section class="marquee-section">
  <div class="marquee-content">
    {%- for i in (1..4) -%}
      <div class="marquee-content__item">
        <img class="marquee-content__thumb" src="https://images.unsplash.com/photo-1596755389378-c31d21fd1273?w=100&q=80" alt="Skincare" loading="lazy">
        Premium skincare
      </div>
      <div class="marquee-content__item">
        <img class="marquee-content__thumb" src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=100&q=80" alt="Beauty deals" loading="lazy">
        Limited-time beauty deals
      </div>
      <div class="marquee-content__item">
        <img class="marquee-content__thumb" src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=100&q=80" alt="Sale" loading="lazy">
        All up to 30% off
      </div>
      <div class="marquee-content__item">
        <img class="marquee-content__thumb" src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?w=100&q=80" alt="Skincare meets science" loading="lazy">
        Science meets skincare
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "settings": [],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
