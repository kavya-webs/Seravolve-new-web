<style>
  .marquee-section {
    background-color: var(--color-bg-primary);
    padding: 12px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .marquee-content {
    display: flex;
    align-items: center;
    animation: marquee 6s linear infinite;
  }
  .marquee-content__item {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 0 var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-bg-dark);
  }
  .marquee-content__dot {
    width: 6px; height: 6px;
    background: var(--color-cta);
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .marquee-section {
      padding: 8px 0;
    }
    .marquee-content__item {
      font-size: 0.95rem;
      font-weight: 700;
      padding: 0 14px;
      gap: 8px;
    }
    .marquee-content__dot {
      width: 5px;
      height: 5px;
    }
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<section class="marquee-section">
  <div class="marquee-content">
    {%- for i in (1..6) -%}
      <div class="marquee-content__item">
        Vegan <span class="marquee-content__dot"></span>
      </div>
      <div class="marquee-content__item">
        Cruelty-Free <span class="marquee-content__dot"></span>
      </div>
      <div class="marquee-content__item">
        Science Backed <span class="marquee-content__dot"></span>
      </div>
      <div class="marquee-content__item">
        Toxin-Free <span class="marquee-content__dot"></span>
      </div>
      <div class="marquee-content__item">
        For All Skin Types <span class="marquee-content__dot"></span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "settings": [],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
