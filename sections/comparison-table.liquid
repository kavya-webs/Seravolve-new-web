<style>
  .comparison-table-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-bg-secondary);
  }
  .comparison-table-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .comparison-table-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    color: var(--color-text-heading);
    text-align: center;
    margin-bottom: 48px;
    font-weight: 500;
  }
  .comparison-table-wrapper {
    overflow-x: auto;
    width: 100%;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
  }
  .comparison-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 12px 8px;
    min-width: 750px;
  }
  
  .comparison-table th,
  .comparison-table td {
    padding: 14px 20px;
    vertical-align: middle;
    text-align: center;
    font-size: 0.95rem;
  }
  
  /* Row header (labels) column */
  .comparison-table th:first-child,
  .comparison-table td:first-child {
    text-align: left;
    background: transparent;
    border: none;
    font-weight: 500;
    color: var(--color-text-body);
    width: 31%;
    padding-left: 0;
  }
  .comparison-table td:first-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    color: var(--color-text-heading);
  }

  /* Seravolve Pillar Column */
  .comparison-table .seravolve-cell {
    background-color: var(--color-bg-dark); /* #123B5A */
    color: #ffffff;
    font-weight: 600;
    border-radius: 8px;
    width: 23%;
    border: 1px solid var(--color-bg-dark);
  }
  .comparison-table th.seravolve-cell {
    font-size: 1rem;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  /* Competitor Columns */
  .comparison-table .competitor-cell {
    background-color: #ffffff;
    color: var(--color-text-body);
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    width: 23%;
  }
  .comparison-table th.competitor-cell {
    font-weight: 500;
    color: var(--color-text-body);
  }
  
  /* Text values style */
  .comparison-table .val-no {
    color: #9CA3AF;
  }
  .comparison-table .competitor-cell.val-yes {
    color: var(--color-text-heading);
    font-weight: 500;
  }
</style>

<section class="comparison-table-section">
  <div class="comparison-table-container">
    <h2 class="comparison-table-title">Why Choose Seravolve?</h2>
    
    <div class="comparison-table-wrapper">
      <table class="comparison-table">
        <thead>
          <tr>
            <th></th>
            <th class="seravolve-cell">Seravolve</th>
            <th class="competitor-cell">Brand B</th>
            <th class="competitor-cell">Brand C</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Clean ingredients</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-yes">Yes</td>
            <td class="competitor-cell val-no">No</td>
          </tr>
          <tr>
            <td>Cruelty-free & vegan</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-yes">Yes</td>
            <td class="competitor-cell val-no">No</td>
          </tr>
          <tr>
            <td>Complete 5-step system</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-no">No</td>
            <td class="competitor-cell val-no">No</td>
          </tr>
          <tr>
            <td>Curated routines</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-no">No</td>
            <td class="competitor-cell val-no">No</td>
          </tr>
          <tr>
            <td>Suitable for all skin types</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-no">No</td>
            <td class="competitor-cell val-yes">Yes</td>
          </tr>
          <tr>
            <td>Eco-conscious packaging</td>
            <td class="seravolve-cell">Yes</td>
            <td class="competitor-cell val-no">No</td>
            <td class="competitor-cell val-no">No</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [],
  "presets": [{ "name": "Comparison Table" }]
}
{% endschema %}
