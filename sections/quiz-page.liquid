  }
  .quiz-results.is-active {
    display: block;
  }
  .quiz-results__header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  .quiz-results__badge {
    display: inline-block;
    background: #E8F9EE;
    color: var(--color-success);
