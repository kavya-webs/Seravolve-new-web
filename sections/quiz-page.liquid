  .quiz-routine-header__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #EEF8FF;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0095FF;
  }
  .quiz-routine-header__text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text-heading);
  }

  .quiz-product {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1.5px solid #EEF2F6;
    border-radius: 16px;
    margin-bottom: 10px;
    background: #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
