<style>
  /* ============================================
     QUIZ PAGE — Build Your Routine
     ============================================ */

  .quiz-page {
    min-height: 100vh;
    background: var(--color-bg-secondary);
    padding: var(--spacing-xl) 0 var(--spacing-xxl);
  }
  .quiz-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Progress Bar */
  .quiz-progress {
    margin-bottom: var(--spacing-lg);
  }
  .quiz-progress__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .quiz-progress__step {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-cta);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .quiz-progress__count {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }
  .quiz-progress__bar {
    width: 100%;
    height: 6px;
    background: rgba(0,0,0,0.06);
    border-radius: 100px;
    overflow: hidden;
  }
  .quiz-progress__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-cta), var(--color-accent));
    border-radius: 100px;
    transition: width 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Quiz Card */
  .quiz-card {
    background: var(--color-bg-primary);
    border-radius: 20px;
    padding: var(--spacing-lg);
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    border: 1px solid rgba(0,0,0,0.04);
  }
  @media (min-width: 768px) {
    .quiz-card {
      padding: var(--spacing-xl);
    }
  }

  /* Slide container */
  .quiz-slides {
    position: relative;
    overflow: hidden;
  }
  .quiz-slide {
    display: none;
    animation: quizFadeIn 0.4s ease forwards;
  }
  .quiz-slide.is-active {
    display: block;
  }
  @keyframes quizFadeIn {
    from { opacity: 0; transform: translateX(24px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Question */
  .quiz-question {
    text-align: center;
    margin-bottom: var(--spacing-md);
  }
  .quiz-question__title {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .quiz-question__subtitle {
    color: var(--color-text-body);
    font-size: 0.95rem;
  }

  /* Options Grid */
  .quiz-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: var(--spacing-md);
  }
  @media (min-width: 480px) {
    .quiz-options--2col {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .quiz-option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border: 2px solid rgba(0,0,0,0.08);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
    background: var(--color-bg-primary);
  }
  .quiz-option:hover {
    border-color: var(--color-cta);
    background: var(--color-bg-alternate);
  }
  .quiz-option.is-selected {
    border-color: var(--color-cta);
    background: var(--color-bg-alternate);
    box-shadow: 0 0 0 3px rgba(0,149,255,0.12);
  }
  .quiz-option__icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 12px;
    background: var(--color-bg-alternate);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }
  .quiz-option.is-selected .quiz-option__icon {
    background: var(--color-cta);
    color: #fff;
  }
  .quiz-option__text {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-heading);
  }
  .quiz-option__desc {
    font-size: 0.8rem;
    color: var(--color-text-body);
    margin-top: 2px;
  }

  /* Navigation Buttons */
  .quiz-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: var(--spacing-sm);
  }
  .quiz-nav__back {
    background: none;
    border: none;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 0;
    transition: color 0.3s;
  }
  .quiz-nav__back:hover {
    color: var(--color-text-heading);
  }
  .quiz-nav__next {
    margin-left: auto;
    padding: 14px 36px;
    background: var(--color-cta);
    color: #fff;
    border: none;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: background 0.3s;
    opacity: 0.4;
    pointer-events: none;
  }
  .quiz-nav__next.is-enabled {
    opacity: 1;
    pointer-events: auto;
  }
  .quiz-nav__next:hover {
    background: var(--color-cta-hover);
  }

  /* ===== Results Page ===== */
  .quiz-results {
    display: none;
