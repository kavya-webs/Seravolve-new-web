    letter-spacing: 2px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .quiz-results__title {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    margin-bottom: 6px;
    font-family: var(--font-heading);
  }
  .quiz-results__subtitle {
    color: var(--color-text-body);
    font-size: 0.9rem;
  }

  /* Product Recommendation Cards with Shop Products */
  .quiz-routine-section {
    margin-bottom: 24px;
  }
  .quiz-routine-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
