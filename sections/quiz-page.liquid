<style>
  /* ============================================
     QUIZ PAGE — Mobile-First Routine Builder
     ============================================ */

  .quiz-page {
    position: relative;
    min-height: 100vh;
    padding: var(--spacing-md) 0 var(--spacing-xxl);
    background: linear-gradient(180deg, rgba(18, 59, 90, 0.82) 0%, rgba(10, 30, 48, 0.92) 100%),
                url("{{ 'cta-bg-desktop.webp' | asset_url }}") center center / cover no-repeat fixed;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quiz-container {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Progress Bar */
  .quiz-progress {
    margin-bottom: var(--spacing-md);
  }
  .quiz-progress__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .quiz-progress__step {
    font-size: 0.85rem;
    font-weight: 700;
    color: #66C8FF;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .quiz-progress__count {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 600;
  }
  .quiz-progress__bar {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 100px;
    overflow: hidden;
    backdrop-filter: blur(4px);
  }
  .quiz-progress__fill {
    height: 100%;
    background: linear-gradient(90deg, #0095FF, #66C8FF);
    border-radius: 100px;
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 0 12px rgba(0, 149, 255, 0.6);
  }

  /* Mobile-First Elevated Quiz Card */
  .quiz-card {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    padding: 24px 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  @media (min-width: 600px) {
    .quiz-card {
      padding: 36px 32px;
    }
  }

  /* Slide container */
  .quiz-slides {
    position: relative;
  }
  .quiz-slide {
    display: none;
    animation: quizSlideIn 0.35s ease forwards;
  }
  .quiz-slide.is-active {
    display: block;
  }
  @keyframes quizSlideIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Question Header */
  .quiz-question {
    text-align: center;
    margin-bottom: 24px;
  }
  .quiz-question__badge {
    display: inline-block;
    background: #EEF8FF;
    color: #0095FF;
    padding: 4px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
  }
  .quiz-question__title {
    font-size: clamp(1.4rem, 5vw, 2rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 6px;
    line-height: 1.25;
  }
  .quiz-question__subtitle {
    color: var(--color-text-body);
    font-size: 0.9rem;
  }

  /* ===== BIG VISIBLE OPTION SELECTORS ===== */
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
  }
  .quiz-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    min-height: 72px;
    border: 2.5px solid #E5E7EB;
    border-radius: 18px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background: #FFFFFF;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .quiz-option:hover {
    border-color: #0095FF;
    background: #F4FAFF;
    transform: translateY(-2px);
  }
  .quiz-option.is-selected {
    border-color: #0095FF;
    background: #EEF8FF;
    box-shadow: 0 8px 24px rgba(0, 149, 255, 0.18);
  }
  .quiz-option__icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 14px;
    background: #EEF8FF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    transition: transform 0.25s ease;
  }
  .quiz-option.is-selected .quiz-option__icon {
    background: #0095FF;
    color: #FFF;
    transform: scale(1.08);
  }
  .quiz-option__content {
    flex: 1;
  }
  .quiz-option__text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: 1.3;
  }
  .quiz-option__desc {
    font-size: 0.825rem;
    color: var(--color-text-body);
    margin-top: 3px;
    line-height: 1.4;
  }
  /* Radio Indicator Circle */
  .quiz-option__radio {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border-radius: 50%;
    border: 2px solid #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }
  .quiz-option.is-selected .quiz-option__radio {
    border-color: #0095FF;
    background: #0095FF;
  }
  .quiz-option__radio::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #FFF;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.25s ease;
  }
  .quiz-option.is-selected .quiz-option__radio::after {
    opacity: 1;
    transform: scale(1);
  }

  /* Navigation Buttons */
  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .quiz-nav__back {
    background: none;
    border: none;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 14px 16px;
    border-radius: 50px;
    transition: background 0.25s;
  }
  .quiz-nav__back:hover {
    background: rgba(0, 0, 0, 0.04);
  }
  .quiz-nav__next {
    margin-left: auto;
    width: 100%;
    max-width: 200px;
    padding: 16px 28px;
    background: #0095FF;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.35;
    pointer-events: none;
    box-shadow: 0 4px 16px rgba(0, 149, 255, 0.3);
  }
  .quiz-nav__next.is-enabled {
    opacity: 1;
    pointer-events: auto;
  }
  .quiz-nav__next:hover {
    background: #007AD6;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 149, 255, 0.4);
  }

  /* ===== INTRO SLIDE ===== */
  .quiz-intro {
    text-align: center;
    padding: 12px 0;
  }
  .quiz-intro__icon {
    width: 90px;
    height: 90px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #EEF8FF;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0095FF;
    box-shadow: 0 8px 24px rgba(0, 149, 255, 0.15);
