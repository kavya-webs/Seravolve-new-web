<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.quiz-slide');
  const progress = document.getElementById('QuizProgress');
  const progressFill = document.getElementById('QuizProgressFill');
  const stepLabel = document.getElementById('QuizStepLabel');
  const percentLabel = document.getElementById('QuizPercent');
  const resultsEl = document.getElementById('QuizResults');
  const slidesContainer = document.getElementById('QuizSlides');

  let currentSlide = 'intro';
  const answers = {};
  const totalSteps = 4;

  function goToSlide(slideId) {
    currentSlide = slideId;
    slides.forEach(s => s.classList.remove('is-active'));

    if (slideId === 'results') {
      slidesContainer.style.display = 'none';
      resultsEl.classList.add('is-active');
      progress.style.display = 'none';
      generateResults();
      return;
    }

    slidesContainer.style.display = '';
    resultsEl.classList.remove('is-active');

    const target = document.querySelector(`[data-slide="${slideId}"]`);
    if (target) target.classList.add('is-active');

    if (slideId === 'intro') {
      progress.style.display = 'none';
    } else {
      progress.style.display = '';
      const step = parseInt(slideId);
      const pct = Math.round((step / totalSteps) * 100);
      stepLabel.textContent = `Step ${step} of ${totalSteps}`;
      percentLabel.textContent = `${pct}%`;
      progressFill.style.width = `${pct}%`;
    }

    updateNextBtnState();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateNextBtnState() {
    slides.forEach(slide => {
      const nextBtn = slide.querySelector('.quiz-nav__next');
      if (!nextBtn) return;
      const slideId = slide.dataset.slide;
      const question = slide.querySelector('.quiz-option')?.dataset.question;
      if (question && answers[question]) {
        nextBtn.classList.add('is-enabled');
      } else {
        nextBtn.classList.remove('is-enabled');
      }
    });
  }

  // Option selection
  document.querySelectorAll('.quiz-option').forEach(opt => {
    opt.addEventListener('click', () => {
      const question = opt.dataset.question;
      const value = opt.dataset.value;
      answers[question] = value;

      opt.closest('.quiz-options').querySelectorAll('.quiz-option').forEach(o => o.classList.remove('is-selected'));
      opt.classList.add('is-selected');
      updateNextBtnState();
    });
  });

  // Start Quiz
  document.getElementById('QuizStartBtn')?.addEventListener('click', () => goToSlide('1'));

  // Back on step 1 goes to intro
  document.getElementById('QuizBack1')?.addEventListener('click', () => goToSlide('intro'));

  // Next/Back buttons
  document.querySelectorAll('.quiz-nav__next[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!btn.classList.contains('is-enabled')) return;
      goToSlide(btn.dataset.next);
    });
  });
  document.querySelectorAll('.quiz-nav__back[data-back]').forEach(btn => {
    btn.addEventListener('click', () => goToSlide(btn.dataset.back));
  });

  // Step 1 Next
  document.getElementById('QuizNext1')?.addEventListener('click', () => {
    if (answers.gender) goToSlide('2');
  });

  // Results generation
  function generateResults() {
    const routines = {
      dry: {
        morning: [
          { name: 'Hydrating Cream Cleanser', desc: 'Gentle cleanse without stripping moisture' },
          { name: 'Hyaluronic Acid Serum', desc: 'Deep hydration with HA + B5' },
          { name: 'Rich Moisturizer + SPF 50', desc: 'Lock in moisture with UV protection' }
        ],
        night: [
          { name: 'Oil-Based Cleansing Balm', desc: 'Dissolve makeup & impurities' },
          { name: 'Ceramide Repair Serum', desc: 'Strengthen skin barrier overnight' },
          { name: 'Overnight Hydrating Mask', desc: 'Intensive moisture recovery' }
        ]
      },
      oily: {
        morning: [
          { name: 'Salicylic Acid Gel Cleanser', desc: 'Deep pore cleansing & oil control' },
          { name: 'Niacinamide 10% Serum', desc: 'Minimize pores & control sebum' },
          { name: 'Oil-Free Gel Moisturizer + SPF', desc: 'Lightweight protection' }
        ],
        night: [
          { name: 'Foaming Gel Cleanser', desc: 'Remove excess oil & debris' },
          { name: 'BHA Exfoliating Toner', desc: 'Unclog pores & prevent breakouts' },
          { name: 'Lightweight Gel Cream', desc: 'Hydrate without clogging pores' }
        ]
      },
      combination: {
        morning: [
          { name: 'Gentle Foaming Cleanser', desc: 'Balanced cleanse for mixed skin' },
          { name: 'Vitamin C Brightening Serum', desc: 'Even skin tone & protect' },
          { name: 'Lightweight Moisturizer + SPF 50', desc: 'All-day balanced hydration' }
        ],
        night: [
          { name: 'Micellar Water Cleanser', desc: 'Gentle yet effective removal' },
          { name: 'Niacinamide + Zinc Serum', desc: 'Balance oil & reduce pores' },
          { name: 'Balancing Night Cream', desc: 'Zone-targeted overnight care' }
        ]
      },
      sensitive: {
        morning: [
          { name: 'Fragrance-Free Cream Cleanser', desc: 'Ultra-gentle, no irritation' },
          { name: 'Centella Calming Essence', desc: 'Reduce redness & soothe' },
          { name: 'Mineral SPF 50 Moisturizer', desc: 'Physical sun protection' }
        ],
        night: [
          { name: 'Micellar Cleansing Water', desc: 'No-rinse gentle cleanse' },
          { name: 'Ceramide Barrier Serum', desc: 'Rebuild & strengthen skin barrier' },
          { name: 'Soothing Recovery Balm', desc: 'Calm & repair overnight' }
        ]
      },
      aging: {
        morning: [
          { name: 'Peptide Cleansing Cream', desc: 'Anti-aging cleanse with peptides' },
          { name: 'Vitamin C + Ferulic Acid Serum', desc: 'Antioxidant protection & brightening' },
          { name: 'Firming SPF 50 Day Cream', desc: 'UV shield + collagen support' }
        ],
        night: [
          { name: 'Double Cleanse Balm + Foam', desc: 'Thorough evening cleanse' },
          { name: 'Retinol 0.5% Renewal Serum', desc: 'Stimulate cell turnover' },
          { name: 'Collagen Peptide Night Cream', desc: 'Intensive firming & repair' }
        ]
      }
    };

    const concern = answers.concern || 'combination';
    const routine = routines[concern] || routines.combination;
    const complexity = answers.complexity || 'balanced';

    let morningSteps = routine.morning;
    let nightSteps = routine.night;

    if (complexity === 'minimal') {
      morningSteps = morningSteps.slice(0, 2);
      nightSteps = nightSteps.slice(0, 2);
    } else if (complexity === 'complete') {
      morningSteps = [...morningSteps, { name: 'Hydrating Toner Mist', desc: 'Prep & balance pH' }];
      nightSteps = [...nightSteps, { name: 'Eye Cream', desc: 'Target dark circles & fine lines' }];
    }

    const morningEl = document.getElementById('QuizMorningProducts');
    const nightEl = document.getElementById('QuizNightProducts');

    morningEl.innerHTML = morningSteps.map((p, i) => `
      <div class="quiz-product">
        <div class="quiz-product__step">${i + 1}</div>
        <div class="quiz-product__info">
          <div class="quiz-product__name">${p.name}</div>
          <div class="quiz-product__desc">${p.desc}</div>
        </div>
      </div>
    `).join('');

    nightEl.innerHTML = nightSteps.map((p, i) => `
      <div class="quiz-product">
        <div class="quiz-product__step">${i + 1}</div>
        <div class="quiz-product__info">
          <div class="quiz-product__name">${p.name}</div>
          <div class="quiz-product__desc">${p.desc}</div>
        </div>
      </div>
    `).join('');

    const concernLabels = { dry: 'Dry / Dehydrated', oily: 'Oily / Acne-Prone', combination: 'Combination', sensitive: 'Sensitive', aging: 'Anti-Aging' };
    document.getElementById('QuizResultsSummary').textContent =
      `Customized for ${concernLabels[concern] || concern} skin with a ${complexity} routine approach.`;
  }
});
</script>

