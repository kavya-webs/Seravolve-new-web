  .quiz-product__img {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 12px;
    object-fit: cover;
    background: #EEF8FF;
  }
  .quiz-product__info {
    flex: 1;
  }
  .quiz-product__step {
    font-size: 0.7rem;
    font-weight: 700;
    color: #0095FF;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }
  .quiz-product__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text-heading);
    margin-bottom: 2px;
  }
  .quiz-product__desc {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }

  /* Add to Cart CTA */
  .quiz-results__cta {
    text-align: center;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .quiz-results__cta .btn {
    width: 100%;
    padding: 18px 32px;
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(0, 149, 255, 0.35);
  }
  .quiz-results__cta-note {
    margin-top: 10px;
    font-size: 0.8rem;
    color: var(--color-text-body);
  }
</style>

