              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line></svg>
            </div>
            <span class="quiz-routine-header__text">Morning Routine</span>
          </div>
          <div id="QuizMorningProducts"></div>
        </div>

        <!-- Evening Routine -->
        <div class="quiz-routine-section">
          <div class="quiz-routine-header">
            <div class="quiz-routine-header__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </div>
            <span class="quiz-routine-header__text">Night Routine</span>
          </div>
          <div id="QuizNightProducts"></div>
        </div>

        <div class="quiz-results__cta">
          <a href="{{ routes.all_products_collection_url }}" class="btn">Shop Recommended Products</a>
          <p class="quiz-results__cta-note">Free shipping on all orders across India</p>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.quiz-slide');
  const progress = document.getElementById('QuizProgress');
  const progressFill = document.getElementById('QuizProgressFill');
  const stepLabel = document.getElementById('QuizStepLabel');
  const percentLabel = document.getElementById('QuizPercent');
  const resultsEl = document.getElementById('QuizResults');
  const slidesContainer = document.getElementById('QuizSlides');

  let currentSlide = 'intro';
  const answers = {};
  const totalSteps = 4;

  const shopProducts = {
    facewash: { name: 'Seravolve Facewash', desc: 'Gentle pore cleansing & hydration', img: "{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" },
    toner: { name: 'Seravolve Toner', desc: 'Prep, balance pH & refine pores', img: "{{ 'all-5-products-toner-front.jpeg' | asset_url }}" },
    serum: { name: 'Seravolve Serum', desc: 'Vitamin C antioxidant treat & boost', img: "{{ 'seravolve-vitamin-c-serum.png' | asset_url }}" },
    moisturiser: { name: 'Seravolve Moisturiser', desc: 'Barrier repair & 24h moisture', img: "{{ 'all-5-products-moisturiser-front.jpeg' | asset_url }}" },
    sunscreen: { name: 'Seravolve Sunscreen', desc: 'SPF 50 broad spectrum protection', img: "{{ 'all-5-products-sunscreen-front.jpeg' | asset_url }}" }
  };

  function goToSlide(slideId) {
    currentSlide = slideId;
    slides.forEach(s => s.classList.remove('is-active'));

    if (slideId === 'results') {
      slidesContainer.style.display = 'none';
      resultsEl.classList.add('is-active');
      progress.style.display = 'none';
      generateResults();
      return;
    }

    slidesContainer.style.display = '';
    resultsEl.classList.remove('is-active');

    const target = document.querySelector(`[data-slide="${slideId}"]`);
    if (target) target.classList.add('is-active');

    if (slideId === 'intro') {
      progress.style.display = 'none';
    } else {
      progress.style.display = '';
      const step = parseInt(slideId);
      const pct = Math.round((step / totalSteps) * 100);
      stepLabel.textContent = `Step ${step} of ${totalSteps}`;
      percentLabel.textContent = `${pct}%`;
      progressFill.style.width = `${pct}%`;
    }

    updateNextBtnState();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateNextBtnState() {
    slides.forEach(slide => {
      const nextBtn = slide.querySelector('.quiz-nav__next');
      if (!nextBtn) return;
      const question = slide.querySelector('.quiz-option')?.dataset.question;
      if (question && answers[question]) {
        nextBtn.classList.add('is-enabled');
      } else {
        nextBtn.classList.remove('is-enabled');
      }
    });
  }

  document.querySelectorAll('.quiz-option').forEach(opt => {
    opt.addEventListener('click', () => {
      const question = opt.dataset.question;
      const value = opt.dataset.value;
      answers[question] = value;

      opt.closest('.quiz-options').querySelectorAll('.quiz-option').forEach(o => o.classList.remove('is-selected'));
      opt.classList.add('is-selected');
      updateNextBtnState();
    });
  });

  document.getElementById('QuizStartBtn')?.addEventListener('click', () => goToSlide('1'));
  document.getElementById('QuizBack1')?.addEventListener('click', () => goToSlide('intro'));

  document.querySelectorAll('.quiz-nav__next[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!btn.classList.contains('is-enabled')) return;
      goToSlide(btn.dataset.next);
    });
  });

  document.querySelectorAll('.quiz-nav__back[data-back]').forEach(btn => {
    btn.addEventListener('click', () => goToSlide(btn.dataset.back));
  });

  document.getElementById('QuizNext1')?.addEventListener('click', () => {
    if (answers.gender) goToSlide('2');
  });

  function generateResults() {
    const isComplete = answers.complexity === 'complete';

    const morningList = isComplete
      ? [shopProducts.facewash, shopProducts.toner, shopProducts.serum, shopProducts.moisturiser, shopProducts.sunscreen]
      : [shopProducts.facewash, shopProducts.serum, shopProducts.sunscreen];

    const nightList = isComplete
      ? [shopProducts.facewash, shopProducts.toner, shopProducts.serum, shopProducts.moisturiser]
      : [shopProducts.facewash, shopProducts.serum, shopProducts.moisturiser];

    const morningEl = document.getElementById('QuizMorningProducts');
    const nightEl = document.getElementById('QuizNightProducts');

    morningEl.innerHTML = morningList.map((p, i) => `
      <div class="quiz-product">
        <img class="quiz-product__img" src="${p.img}" alt="${p.name}">
        <div class="quiz-product__info">
          <div class="quiz-product__step">Step ${i + 1}</div>
          <div class="quiz-product__name">${p.name}</div>
          <div class="quiz-product__desc">${p.desc}</div>
        </div>
      </div>
    `).join('');

    nightEl.innerHTML = nightList.map((p, i) => `
      <div class="quiz-product">
        <img class="quiz-product__img" src="${p.img}" alt="${p.name}">
        <div class="quiz-product__info">
          <div class="quiz-product__step">Step ${i + 1}</div>
          <div class="quiz-product__name">${p.name}</div>
          <div class="quiz-product__desc">${p.desc}</div>
        </div>
      </div>
    `).join('');
  }
});
</script>

{% schema %}
{
  "name": "Quiz Page",
  "settings": []
}
{% endschema %}
