    margin-bottom: var(--spacing-sm);
  }
  .quiz-results__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 8px;
  }
  .quiz-results__subtitle {
    color: var(--color-text-body);
    font-size: 0.95rem;
  }

  /* Routine Time Headers */
  .quiz-routine-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }
  .quiz-routine-header__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--color-bg-alternate);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cta);
  }
  .quiz-routine-header__text {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-text-heading);
  }

  /* Product recommendation cards */
  .quiz-product {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 14px;
    margin-bottom: 12px;
    background: var(--color-bg-primary);
    transition: box-shadow 0.3s;
  }
  .quiz-product:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .quiz-product__step {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: var(--color-cta);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .quiz-product__info {
    flex: 1;
  }
  .quiz-product__name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-heading);
    margin-bottom: 2px;
  }
  .quiz-product__desc {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }

  /* Add to Cart CTA */
  .quiz-results__cta {
    text-align: center;
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(0,0,0,0.06);
