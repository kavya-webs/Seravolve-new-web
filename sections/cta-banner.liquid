<style>
  .cta-banner {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cta-banner__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .cta-banner::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    z-index: 2;
  }
  .cta-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 600px;
    padding: var(--spacing-lg);
  }
  .cta-banner__title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #fff;
    margin-bottom: var(--spacing-sm);
    font-style: italic;
  }
  .cta-banner__text {
    color: rgba(255,255,255,0.85);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-md);
  }
  .cta-banner__btn {
    display: inline-flex;
    padding: 16px 40px;
    background: #C0392B;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
  }
  .cta-banner__btn:hover { opacity: 0.9; }
</style>

<section class="cta-banner">
  <img class="cta-banner__image" src="https://images.unsplash.com/photo-1487412912498-0447578fcca8?w=1600&q=80" alt="Models skincare" loading="lazy">
  <div class="cta-banner__content">
    <h2 class="cta-banner__title">Effective, clean skincare is all that's needed for great results.</h2>
    <p class="cta-banner__text">Discover our complete range of science-backed formulas</p>
    <a href="{{ routes.all_products_collection_url }}" class="cta-banner__btn">Shop Now</a>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
