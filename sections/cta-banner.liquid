<style>
  .cta-banner {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cta-banner__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .cta-banner__image.mobile-only {
    display: none;
  }
  .cta-banner__image.desktop-only {
    display: block;
  }
  @media (max-width: 768px) {
    .cta-banner {
      min-height: 480px;
    }
    .cta-banner__image.desktop-only {
      display: none;
    }
    .cta-banner__image.mobile-only {
      display: block;
    }
  }

  .cta-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 650px;
    padding: var(--spacing-lg);
  }
  .cta-banner__title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #fff;
    margin-bottom: var(--spacing-sm);
    font-style: italic;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }
  .cta-banner__text {
    color: #fff;
    font-size: 1.1rem;
    margin-bottom: var(--spacing-md);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .cta-banner__btn {
    display: inline-flex;
    padding: 16px 40px;
    background: #fff;
    color: var(--color-bg-dark);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .cta-banner__btn:hover {
    background: var(--color-cta);
    color: #fff;
    opacity: 1;
    transform: translateY(-2px);
  }
</style>

<section class="cta-banner">
  <img class="cta-banner__image desktop-only" src="{{ 'cta-bg-desktop.webp' | asset_url }}" alt="5 Products 6 Routines Desktop" loading="lazy">
  <img class="cta-banner__image mobile-only" src="{{ 'cta-bg-mobile.webp' | asset_url }}" alt="5 Products 6 Routines Mobile" loading="lazy">
  
  <div class="cta-banner__content">
    <h2 class="cta-banner__title">5 Products. 6 Routines.<br>One Brand You Can Trust.</h2>
    <p class="cta-banner__text">Build your perfect skincare routine from facewash to sunscreen</p>
    <a href="{{ routes.all_products_collection_url }}" class="cta-banner__btn">Shop All Products</a>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
