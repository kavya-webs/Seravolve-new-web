<style>
  .sale-banner {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-bg-alternate);
  }
  .sale-banner__bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.15;
  }
  .sale-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    background: rgba(255,255,255,0.95);
    padding: var(--spacing-xl) var(--spacing-xxl);
    border-radius: 20px;
    max-width: 600px;
    box-shadow: 0 8px 40px rgba(0,149,255,0.08);
  }
  .sale-banner__badge {
    position: absolute;
    top: -40px;
    left: -40px;
    width: 120px;
    height: 120px;
    background: var(--color-cta);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    animation: spin 8s linear infinite;
    z-index: 4;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .sale-banner__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: 8px;
  }
  .sale-banner__text {
    font-size: 1rem;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-md);
  }
  .countdown {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: var(--spacing-md);
  }
  .countdown__item { text-align: center; }
  .countdown__number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: var(--color-cta);
    line-height: 1;
  }
  .countdown__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-body);
  }
  .countdown__sep {
    font-size: 2rem;
    color: var(--color-cta);
    line-height: 1;
    padding-top: 2px;
  }
  .sale-banner__btn {
    display: inline-flex;
    padding: 16px 40px;
    background: var(--color-cta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .sale-banner__btn:hover { background: var(--color-cta-hover); opacity: 1; }
</style>

<section class="sale-banner">
  <img class="sale-banner__bg" src="https://images.unsplash.com/photo-1563804447971-6e113ab80713?w=1600&q=80" alt="Sale background" loading="lazy">
  <div class="sale-banner__content">
    <div class="sale-banner__badge">SALE %</div>
    <h2 class="sale-banner__title">Launch Offer</h2>
    <p class="sale-banner__text">Get your complete skincare routine at up to 50% off</p>
    <div class="countdown" id="SaleCountdown">
      <div class="countdown__item">
        <div class="countdown__number" id="cd-days">30</div>
        <div class="countdown__label">Days</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-hours">15</div>
        <div class="countdown__label">Hrs</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-mins">59</div>
        <div class="countdown__label">Min</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-secs">00</div>
        <div class="countdown__label">Sec</div>
      </div>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="sale-banner__btn">Shop Now</a>
  </div>
</section>

<script>
(function() {
  const end = new Date();
  end.setDate(end.getDate() + 30);
  function update() {
    const now = new Date();
    const diff = end - now;
    if (diff <= 0) return;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('cd-days').textContent = String(d).padStart(2, '0');
    document.getElementById('cd-hours').textContent = String(h).padStart(2, '0');
    document.getElementById('cd-mins').textContent = String(m).padStart(2, '0');
    document.getElementById('cd-secs').textContent = String(s).padStart(2, '0');
  }
  update();
  setInterval(update, 1000);
})();
</script>

{% schema %}
{
  "name": "Sale Banner",
  "settings": [],
  "presets": [{ "name": "Sale Banner" }]
}
{% endschema %}
