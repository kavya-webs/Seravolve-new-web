<style>
  .sale-banner {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .sale-banner__bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Spinning SALE badge — top left of section, fully responsive */
  .sale-banner__badge {
    position: absolute;
    top: 40px;
    left: 40px;
    width: clamp(100px, 12vw, 150px);
    height: clamp(100px, 12vw, 150px);
    background: var(--color-cta);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    box-shadow: 0 8px 24px rgba(0,149,255,0.3);
  }

  .sale-banner__badge-svg {
    width: 100%;
    height: 100%;
    animation: spin 12s linear infinite;
  }

  .sale-banner__badge-inner {
    position: absolute;
    color: #fff;
    font-weight: 800;
    font-size: clamp(1.25rem, 2vw, 2rem);
    text-align: center;
    line-height: 1;
    z-index: 5;
    font-family: var(--font-heading);
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .sale-banner__badge {
      top: 20px; left: 20px;
    }
  }

  /* Content Card */
  .sale-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    background: rgba(255, 255, 255, 0.95);
    padding: 60px 80px;
    border-radius: 20px;
    max-width: 650px;
    width: 90%;
    box-shadow: 0 12px 40px rgba(0,149,255,0.1);
  }
  @media (max-width: 768px) {
    .sale-banner__content {
      padding: 40px 24px;
    }
  }

  .sale-banner__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-bottom: 12px;
    color: var(--color-bg-dark);
  }
  .sale-banner__text {
    font-size: 1rem;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-lg);
  }

  /* Countdown */
  .countdown {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: var(--spacing-lg);
  }
  .countdown__item { text-align: center; }
  .countdown__number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-cta);
    line-height: 1;
    font-weight: 500;
  }
  .countdown__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-body);
    margin-top: 4px;
  }
  .countdown__sep {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-cta);
    line-height: 1;
    padding-top: 4px;
  }

  /* Button */
  .sale-banner__btn {
    display: inline-flex;
    padding: 16px 44px;
    background: var(--color-cta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }
  .sale-banner__btn:hover { background: var(--color-cta-hover); opacity: 1; }
</style>

<section class="sale-banner">
  <!-- Full-page background image (soap bubbles / water foam texture) -->
  <img class="sale-banner__bg" src="https://images.unsplash.com/photo-1563804447971-6e113ab80713?w=1920&q=80" alt="Sale background" loading="lazy">

  <!-- Responsive Spinning SALE badge — top left -->
  <div class="sale-banner__badge">
    <div class="sale-banner__badge-inner">%</div>
    <svg class="sale-banner__badge-svg" viewBox="0 0 100 100">
      <path id="badgePath" d="M 50,50 m -35,0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
      <text font-family="Inter, sans-serif" font-size="7" font-weight="700" fill="#ffffff" letter-spacing="1">
        <textPath href="#badgePath" startOffset="0%">
          • SERAVOLVE • 20% OFF SALE • SERAVOLVE • 20% OFF SALE
        </textPath>
      </text>
    </svg>
  </div>

  <!-- Content Card -->
  <div class="sale-banner__content">
    <h2 class="sale-banner__title">🇮🇳 Independence Day Sale</h2>
    <p class="sale-banner__text">Flat 20% OFF on all products from MRP. Valid Aug 15–28, 2026</p>
    <div class="countdown" id="SaleCountdown">
      <div class="countdown__item">
        <div class="countdown__number" id="cd-days">30</div>
        <div class="countdown__label">Days</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-hours">15</div>
        <div class="countdown__label">Hrs</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-mins">59</div>
        <div class="countdown__label">Min</div>
      </div>
      <span class="countdown__sep">:</span>
      <div class="countdown__item">
        <div class="countdown__number" id="cd-secs">00</div>
        <div class="countdown__label">Sec</div>
      </div>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="sale-banner__btn">Shop Now</a>
  </div>
</section>

<script>
(function() {
  const end = new Date('2026-08-28T23:59:59+05:30');
  function update() {
    const now = new Date();
    const diff = end - now;
    if (diff <= 0) return;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('cd-days').textContent = String(d).padStart(2, '0');
    document.getElementById('cd-hours').textContent = String(h).padStart(2, '0');
    document.getElementById('cd-mins').textContent = String(m).padStart(2, '0');
    document.getElementById('cd-secs').textContent = String(s).padStart(2, '0');
  }
  update();
  setInterval(update, 1000);
})();
</script>

{% schema %}
{
  "name": "Sale Banner",
  "settings": [],
  "presets": [{ "name": "Sale Banner" }]
}
{% endschema %}
