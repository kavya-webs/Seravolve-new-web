<style>
  .texture-section {
    padding: 60px 20px;
    background-color: #ffffff;
    overflow: hidden;
  }
  .texture-section__inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .texture-section__heading {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #0A1E30;
    margin-bottom: 8px;
  }
  .texture-section__subheading {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #64748B;
    margin-bottom: 40px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .texture-section__image-wrap {
    position: relative;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 30px rgba(10, 30, 48, 0.06);
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .texture-section__image-wrap.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  .texture-section__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .texture-section__label {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10, 30, 48, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 8px 20px;
    border-radius: 50px;
    white-space: nowrap;
  }

  /* Texture details pills */
  .texture-section__details {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .texture-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #F1F5F9;
    color: #0A1E30;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 50px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .texture-pill.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .texture-pill svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 749px) {
    .texture-section {
      padding: 40px 16px;
    }
    .texture-section__heading {
      font-size: 1.5rem;
    }
    .texture-section__subheading {
      font-size: 0.9rem;
      margin-bottom: 28px;
    }
    .texture-section__image-wrap {
      border-radius: 12px;
    }
    .texture-section__label {
      font-size: 0.75rem;
      padding: 6px 14px;
      bottom: 14px;
    }
    .texture-pill {
      font-size: 0.75rem;
      padding: 6px 12px;
    }
  }
</style>

{%- comment -%}
  DYNAMIC PER PRODUCT via metafields:
  1. Go to Shopify Admin → Settings → Custom data → Products
  2. Add metafield: "Texture Image" (namespace: custom, key: texture_image, type: File / Image)
  3. Add metafield: "Texture Label" (namespace: custom, key: texture_label, type: Single line text)
  4. Then edit each product and upload its unique texture image + label text.
  Section settings act as fallback if no metafield is set.
{%- endcomment -%}

{%- assign tex_image = product.metafields.custom.texture_image.value | default: section.settings.texture_image -%}
{%- assign tex_label = product.metafields.custom.texture_label.value | default: section.settings.label_text -%}

<section class="texture-section" id="texture-{{ section.id }}">
  <div class="texture-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="texture-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="texture-section__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="texture-section__image-wrap" id="texture-image-{{ section.id }}">
      {%- if tex_image != blank -%}
        <img
          class="texture-section__image"
          src="{{ tex_image | image_url: width: 1400 }}"
          alt="{{ section.settings.image_alt | default: product.title | append: ' texture close-up' }}"
          loading="lazy"
          width="1400"
          height="900"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'texture-section__image' }}
      {%- endif -%}

      {%- if tex_label != blank -%}
        <span class="texture-section__label">{{ tex_label }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="texture-section__details">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'detail_pill' -%}
              <div class="texture-pill" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index | times: 120 }}ms;">
                {%- case block.settings.icon -%}
                  {%- when 'droplet' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                  {%- when 'palette' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 1c1 2 2 4.5 2 8 0 5.5-4.78 11-10 11Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- endcase -%}
                {{ block.settings.text }}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');

          // Animate pills after image
          const pills = entry.target.closest('.texture-section')?.querySelectorAll('.texture-pill');
          if (pills) {
            pills.forEach(pill => {
              setTimeout(() => pill.classList.add('is-visible'), 400);
            });
          }
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    const imgWrap = document.getElementById('texture-image-{{ section.id }}');
    if (imgWrap) observer.observe(imgWrap);
  })();
</script>

{% schema %}
{
  "name": "Product Texture",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel the Texture"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A macro look at what goes on your skin — clean, lightweight, and luxurious."
    },
    {
      "type": "image_picker",
      "id": "texture_image",
      "label": "Texture Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Product texture close-up"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Overlay Label",
      "default": "Lightweight Gel Texture",
      "info": "Shows as a pill label over the bottom of the image"
    }
  ],
  "blocks": [
    {
      "type": "detail_pill",
      "name": "Detail Pill",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "droplet",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "palette", "label": "Palette" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Checkmark" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gel Consistency"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Texture",
      "blocks": [
        {
          "type": "detail_pill",
          "settings": { "icon": "droplet", "text": "Gel Consistency" }
        },
        {
          "type": "detail_pill",
          "settings": { "icon": "palette", "text": "Cyan Blue Color" }
        },
        {
          "type": "detail_pill",
          "settings": { "icon": "sparkle", "text": "Non-Greasy Finish" }
        },
        {
          "type": "detail_pill",
          "settings": { "icon": "leaf", "text": "Paraben-Free" }
        }
      ]
    }
  ]
}
{% endschema %}
