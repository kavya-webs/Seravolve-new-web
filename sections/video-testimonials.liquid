<style>
  .video-testimonials {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .video-testimonials__heading {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  .video-testimonials__track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 40px;
    scrollbar-width: none;
  }
  .video-testimonials__track::-webkit-scrollbar { display: none; }

  .video-card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    background: var(--color-bg-secondary);
  }
  .video-card__media {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
  }
  .video-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #C0392B;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    cursor: pointer;
    border: none;
    transition: transform 0.3s;
  }
  .video-card__play:hover { transform: translate(-50%, -50%) scale(1.1); }
  .video-card__play svg { margin-left: 3px; }

  .video-card__info {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.3));
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 2;
  }
  .video-card__thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    background: #fff;
  }
  .video-card__name {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .video-card__price {
    color: rgba(255,255,255,0.8);
    font-size: 0.85rem;
  }
</style>

