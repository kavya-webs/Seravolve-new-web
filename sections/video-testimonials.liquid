<style>
  .routines-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .routines-section__heading {
    text-align: center;
    margin-bottom: 8px;
  }
  .routines-section__subtext {
    text-align: center;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-lg);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .routines-track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 40px 16px;
    scrollbar-width: none;
  }
  .routines-track::-webkit-scrollbar { display: none; }

  .routine-card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-bg-alternate);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
  }
  .routine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,149,255,0.12);
    opacity: 1;
  }

  .routine-card__image-wrapper {
    aspect-ratio: 4/3;
    overflow: hidden;
    position: relative;
  }
  .routine-card__image {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .routine-card__badge {
    position: absolute;
    top: 12px; right: 12px;
    background: var(--color-cta);
    color: #fff;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .routine-card__content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .routine-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-heading);
    margin-bottom: 8px;
  }
  .routine-card__products {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .routine-card__tag {
    background: rgba(0,149,255,0.1);
    color: var(--color-cta);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .routine-card__cta {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-cta);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>

