<style>
  .routines-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .routines-section__heading {
    text-align: center;
    margin-bottom: 8px;
  }
  .routines-section__subtext {
    text-align: center;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-lg);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .routines-track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 40px 16px;
    scrollbar-width: none;
  }
  .routines-track::-webkit-scrollbar { display: none; }

  .routine-card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-bg-alternate);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
  }
  .routine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,149,255,0.12);
    opacity: 1;
  }

  .routine-card__image-wrapper {
    aspect-ratio: 1/1;
    overflow: hidden;
    position: relative;
  }
  .routine-card__image {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .routine-card__badge {
    position: absolute;
    top: 12px; right: 12px;
    background: var(--color-cta);
    color: #fff;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .routine-card__content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .routine-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-heading);
    margin-bottom: 8px;
  }
  .routine-card__products {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .routine-card__tag {
    background: rgba(0,149,255,0.1);
    color: var(--color-cta);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .routine-card__cta {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-cta);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>

<section class="routines-section" aria-labelledby="routines-heading">
  <div class="container">
    <h2 id="routines-heading" class="routines-section__heading">Find Your Perfect Routine</h2>
    <p class="routines-section__subtext">Curated combinations of our 5 products designed for your specific skin goals</p>
  </div>
  <div class="routines-track">

    <!-- Routine 1: Daily UV Defence Routine (2 Steps) -->
    <a href="/products/daily-uv-defence-routine" class="routine-card" aria-label="Shop Daily UV Defence Routine">
      <div class="routine-card__image-wrapper">
        {% assign routine_product = all_products['daily-uv-defence-routine'] %}
        <img class="routine-card__image" src="{{ routine_product.featured_image | image_url: width: 600 }}" alt="{{ routine_product.title | escape | default: 'Daily UV Defence Routine' }}" loading="lazy">
        <span class="routine-card__badge">2 Steps</span>
      </div>
      <div class="routine-card__content">
        <h3 class="routine-card__title">Daily UV Defence Routine</h3>
        <div class="routine-card__products">
          <span class="routine-card__tag">Moisturizer</span>
          <span class="routine-card__tag">Sunscreen</span>
        </div>
        <span class="routine-card__cta">Shop Routine →</span>
      </div>
    </a>

    <!-- Routine 2: Smooth Skin Routine (2 Steps) -->
    <a href="/products/smooth-skin-routine" class="routine-card" aria-label="Shop Smooth Skin Routine">
      <div class="routine-card__image-wrapper">
        {% assign routine_product = all_products['smooth-skin-routine'] %}
        <img class="routine-card__image" src="{{ routine_product.featured_image | image_url: width: 600 }}" alt="{{ routine_product.title | escape | default: 'Smooth Skin Routine' }}" loading="lazy">
        <span class="routine-card__badge">2 Steps</span>
      </div>
      <div class="routine-card__content">
        <h3 class="routine-card__title">Smooth Skin Routine</h3>
        <div class="routine-card__products">
          <span class="routine-card__tag">Facewash</span>
          <span class="routine-card__tag">Toner</span>
        </div>
        <span class="routine-card__cta">Shop Routine →</span>
      </div>
    </a>

    <!-- Routine 3: Acne Control Routine (3 Steps) -->
    <a href="/products/acne-control-routine" class="routine-card" aria-label="Shop Acne Control Routine">
      <div class="routine-card__image-wrapper">
        {% assign routine_product = all_products['acne-control-routine'] %}
        <img class="routine-card__image" src="{{ routine_product.featured_image | image_url: width: 600 }}" alt="{{ routine_product.title | escape | default: 'Acne Control Routine' }}" loading="lazy">
        <span class="routine-card__badge">3 Steps</span>
      </div>
      <div class="routine-card__content">
        <h3 class="routine-card__title">Acne Control Routine</h3>
        <div class="routine-card__products">
          <span class="routine-card__tag">Facewash</span>
          <span class="routine-card__tag">Moisturizer</span>
          <span class="routine-card__tag">Sunscreen</span>
        </div>
        <span class="routine-card__cta">Shop Routine →</span>
      </div>
    </a>

    <!-- More Routines Card -->
    <a href="/pages/routines" class="routine-card" aria-label="View All Routines" style="background: var(--color-bg-alternate); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border: 2px dashed #E2E8F0; box-shadow: none; min-height: 100%;">
      <div class="routine-card__content" style="align-items: center; flex: none; padding: 40px 20px;">
        <h3 class="routine-card__title" style="margin-bottom: 16px; font-size: 1.4rem;">More on Routines page</h3>
        <p style="color: var(--color-text-body); margin-bottom: 24px; font-size: 0.95rem; line-height: 1.4;">Discover more curated regimens designed for your specific skin goals.</p>
        <span class="routine-card__cta" style="margin-top: 0;">View All Routines →</span>
      </div>
    </a>

  </div>
</section>

{% schema %}
{
  "name": "Routines Carousel",
  "settings": [],
  "presets": [{ "name": "Routines Carousel" }]
}
{% endschema %}
