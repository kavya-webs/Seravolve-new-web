<style>
  /* ============================================
     FAQ PAGE — Frequently Asked Questions
     ============================================ */

  /* Hero */
  .faq-hero {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, #123B5A 0%, #0A5C8F 50%, #0095FF 100%);
    overflow: hidden;
    padding: var(--spacing-xxl) 20px;
  }
  .faq-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(102,200,255,0.12) 0%, transparent 50%);
    pointer-events: none;
  }
  .faq-hero__content {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }
  .faq-hero__title {
    color: #ffffff;
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: var(--spacing-xs);
  }
  .faq-hero__subtitle {
    color: rgba(255,255,255,0.7);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* Main FAQ Layout */
  .faq-layout {
    padding: var(--spacing-xl) 0 var(--spacing-xxl);
    background: var(--color-bg-primary);
  }
  .faq-layout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  @media (min-width: 768px) {
    .faq-layout__grid {
      grid-template-columns: 240px 1fr;
    }
  }

  /* Sidebar Navigation */
  .faq-sidebar {
    display: none;
  }
  @media (min-width: 768px) {
    .faq-sidebar {
      display: block;
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  .faq-sidebar__title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-body);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  .faq-sidebar__list {
    list-style: none;
  }
  .faq-sidebar__item {
    margin-bottom: 4px;
  }
  .faq-sidebar__link {
    display: block;
    padding: 10px 16px;
    border-radius: 10px;
    color: var(--color-text-body);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .faq-sidebar__link:hover,
  .faq-sidebar__link.is-active {
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    opacity: 1;
  }

  /* Mobile Category Filter */
  .faq-mobile-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .faq-mobile-filters { display: none; }
  }
  .faq-mobile-filter {
    padding: 8px 16px;
    border-radius: 50px;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--color-text-body);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .faq-mobile-filter.is-active {
    background: var(--color-cta);
    color: #fff;
    border-color: var(--color-cta);
  }

  /* FAQ Category Sections */
  .faq-category {
    margin-bottom: var(--spacing-lg);
  }
  .faq-category__title {
    font-size: 1.3rem;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 2px solid var(--color-bg-alternate);
  }

  /* Accordion Items */
  .faq-item {
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .faq-item__question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-heading);
    transition: color 0.25s;
    gap: 16px;
  }
  .faq-item__question:hover {
    color: var(--color-cta);
  }
  .faq-item__toggle {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 50%;
    background: var(--color-bg-alternate);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--color-cta);
    transition: transform 0.3s, background 0.3s;
    font-weight: 300;
    line-height: 1;
  }
  .faq-item.is-open .faq-item__toggle {
    background: var(--color-cta);
    color: #fff;
    transform: rotate(45deg);
  }
  .faq-item__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), padding 0.3s;
    padding: 0;
  }
  .faq-item.is-open .faq-item__answer {
    max-height: 500px;
    padding-bottom: 18px;
  }
  .faq-item__answer p {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  /* Contact Support Banner */
  .faq-support {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: var(--color-bg-alternate);
    border-radius: 16px;
    text-align: center;
  }
  .faq-support__title {
    font-size: 1.4rem;
    margin-bottom: var(--spacing-xs);
  }
  .faq-support__text {
    color: var(--color-text-body);
    margin-bottom: var(--spacing-md);
  }
</style>

