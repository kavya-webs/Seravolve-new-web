<style>
  .collection-layout {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg) 0 var(--spacing-xxl) 0;
  }
  
  /* Sidebar */
  .collection-sidebar {
    width: 100%;
    margin-bottom: var(--spacing-lg);
  }
  .filter-group {
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding: var(--spacing-md) 0;
  }
  .filter-group__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }
  .filter-group__summary::-webkit-details-marker {
    display: none;
  }
  .filter-list {
    list-style: none;
    margin-top: var(--spacing-md);
  }
  .filter-list li {
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .filter-list label {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--color-text-body);
  }
  
  /* Grid */
  .collection-grid-container {
    flex: 1;
  }
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    font-size: 0.95rem;
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }
  
  /* Desktop Layout */
  @media (min-width: 900px) {
    .collection-layout {
      flex-direction: row;
      gap: var(--spacing-xl);
    }
    .collection-sidebar {
      width: 250px;
      flex-shrink: 0;
      margin-bottom: 0;
    }
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-lg);
    }
  }
</style>

<div class="container">
  <div class="collection-layout">
    
    <!-- Sidebar Filters -->
    <aside class="collection-sidebar">
      <form id="CollectionFiltersForm" class="filter-form">
        {%- for filter in collection.filters -%}
          <details class="filter-group" open>
            <summary class="filter-group__summary">
              <span>{{ filter.label }}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            
            <div class="filter-group__display">
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul class="filter-list">
                    {%- for value in filter.values -%}
                      <li>
                        <input type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          id="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <label for="Filter-{{ filter.label | escape }}-{{ forloop.index }}">
                          {{ value.label | escape }} ({{ value.count }})
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                  
                {%- when 'price_range' -%}
                  <div style="margin-top: 16px; display: flex; gap: 8px; align-items: center;">
                    <span>{{ cart.currency.symbol }}</span>
                    <input name="{{ filter.min_value.param_name }}"
                      type="number"
                      placeholder="0"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      style="width: 80px; padding: 4px;">
                    <span>-</span>
                    <span>{{ cart.currency.symbol }}</span>
                    <input name="{{ filter.max_value.param_name }}"
                      type="number"
                      placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      style="width: 80px; padding: 4px;">
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </form>
    </aside>

    <!-- Main Grid -->
    <div class="collection-grid-container">
      <div class="collection-toolbar">
        <div>{{ collection.products_count }} products</div>
        
        <div class="collection-sort">
          <label for="SortBy">Sort by: </label>
          <select name="sort_by" id="SortBy" form="CollectionFiltersForm" style="padding: 4px; border: 1px solid #ccc;">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection-grid" id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <p>No products found.</p>
          {%- else -%}
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="margin-top: var(--spacing-xl); text-align: center;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

  </div>
</div>

<script>
  // Simple listener to submit form when a filter or sort changes
  document.getElementById('CollectionFiltersForm').addEventListener('input', function() {
    this.submit();
  });
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    }
  ]
}
{% endschema %}
