<style>
  .featured-dark {
    background: var(--color-bg-dark);
    padding: var(--spacing-lg) 0;
    color: #fff;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .featured-dark {
      padding: var(--spacing-xl) 0;
    }
  }

  .featured-dark__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
    align-items: center;
    width: 100%;
    min-width: 0;
  }
  @media (min-width: 900px) {
    .featured-dark__layout {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--spacing-lg);
    }
  }

  .featured-dark__image-wrapper {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/3;
    max-height: 350px;
  }
  @media (min-width: 900px) {
    .featured-dark__image-wrapper {
      aspect-ratio: 3/4;
      max-height: none;
    }
  }

  .featured-dark__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-dark__content {
    text-align: center;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .featured-dark__content {
      text-align: left;
    }
  }

  .featured-dark__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #fff;
    margin-bottom: var(--spacing-xs);
    font-family: var(--font-heading);
    font-style: italic;
    max-width: 100%;
    word-wrap: break-word;
    display: inline-block;
  }

  .featured-dark__text {
    color: rgba(255,255,255,0.75);
    margin-bottom: var(--spacing-md);
    font-size: 0.95rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 900px) {
    .featured-dark__text {
      margin-left: 0;
    }
  }

  /* Responsive Horizontal Scroll Container */
  .featured-dark__products-wrapper {
    margin: 0 -20px;
    padding: 0 20px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .featured-dark__products-wrapper::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .featured-dark__products-wrapper {
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  .featured-dark__products {
    display: flex;
    gap: 16px;
    width: max-content;
  }
  @media (min-width: 900px) {
    .featured-dark__products {
      width: auto;
    }
  }

  .dark-product-card {
    width: 140px;
    text-decoration: none;
    flex-shrink: 0;
    text-align: left;
  }
  @media (min-width: 900px) {
    .dark-product-card {
      width: 170px;
    }
  }

  .dark-product-card__image-wrapper {
    aspect-ratio: 3/4;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 8px;
    position: relative;
    background: rgba(255,255,255,0.05);
  }

  .dark-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dark-product-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--color-cta);
    color: #fff;
    padding: 3px 8px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    z-index: 2;
  }

  .dark-product-card__title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 2px;
  }

  .dark-product-card__price {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
  }
  .featured-dark__btn {
    display: inline-flex;
    margin-bottom: var(--spacing-md);
    padding: 12px 24px;
    background: transparent;
    border: 1px solid #ffffff;
    color: #ffffff;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: all 0.3s ease;
    text-decoration: none;
    cursor: pointer;
    max-width: calc(100% - 40px);
    text-align: center;
    white-space: normal;
  }
  .featured-dark__btn:hover {
    background: #ffffff;
    color: var(--color-bg-dark);
    opacity: 1;
    transform: translateY(-2px);
  }
</style>

<section class="featured-dark">
  <div class="container">
    <div class="featured-dark__layout">
      <!-- Top/Left: Event lifestyle context shot -->
      <div class="featured-dark__image-wrapper">
        <img class="featured-dark__image" src="{{ 'smooth-skin-routine-lifestyle.png' | asset_url }}" alt="Seravolve clean routine lifestyle" loading="lazy">
      </div>
      
      <!-- Bottom/Right: Text and scrollable steps -->
      <div class="featured-dark__content">
        <h2 class="featured-dark__title">Made For Every Skin Type</h2>
        <p class="featured-dark__text">Our 5-step system works for all skin types — from oily and acne-prone to dry and sensitive. Just pick the routine that fits your goals.</p>

        <a href="{{ routes.all_products_collection_url }}" class="featured-dark__btn">Make Your Own Routine</a>

        <div class="featured-dark__products-wrapper">
          <div class="featured-dark__products">
            {%- assign dark_products = collections['all'].products -%}
            {%- if dark_products and dark_products.size > 0 -%}
              {%- for product in dark_products limit: 5 -%}
                <a href="{{ product.url }}" class="dark-product-card" aria-label="{{ product.title | escape }}">
                  <div class="dark-product-card__image-wrapper">
                    <span class="dark-product-card__badge">Step {{ forloop.index }}</span>
                    {%- if product.featured_image -%}
                      <img class="dark-product-card__image" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                    {%- else -%}
                      <img class="dark-product-card__image" src="{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">
                    {%- endif -%}
                  </div>
                  <div class="dark-product-card__title">{{ product.title }}</div>
                  <div class="dark-product-card__price">{{ product.price | money }}</div>
                </a>
              {%- endfor -%}
            {%- else -%}
              <!-- Step 1 Card -->
              <a href="{{ routes.all_products_collection_url }}" class="dark-product-card" aria-label="Facewash Cleanse Step">
                <div class="dark-product-card__image-wrapper">
                  <span class="dark-product-card__badge">Step 1</span>
                  <img class="dark-product-card__image" src="{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" alt="Facewash" loading="lazy">
                </div>
                <div class="dark-product-card__title">Facewash</div>
                <div class="dark-product-card__price">Cleanse</div>
              </a>

              <!-- Step 2 Card -->
              <a href="{{ routes.all_products_collection_url }}" class="dark-product-card" aria-label="Toner Prep Step">
                <div class="dark-product-card__image-wrapper">
                  <span class="dark-product-card__badge">Step 2</span>
                  <img class="dark-product-card__image" src="{{ 'all-5-products-toner-front.jpeg' | asset_url }}" alt="Toner" loading="lazy">
                </div>
                <div class="dark-product-card__title">Toner</div>
                <div class="dark-product-card__price">Prep & Balance</div>
              </a>

              <!-- Step 3 Card -->
              <a href="{{ routes.all_products_collection_url }}" class="dark-product-card" aria-label="Serum Treat Step">
                <div class="dark-product-card__image-wrapper">
                  <span class="dark-product-card__badge">Step 3</span>
                  <img class="dark-product-card__image" src="{{ 'seravolve-vitamin-c-serum.png' | asset_url }}" alt="Serum" loading="lazy">
                </div>
                <div class="dark-product-card__title">Serum</div>
                <div class="dark-product-card__price">Treat & Target</div>
              </a>

              <!-- Step 4 Card -->
              <a href="{{ routes.all_products_collection_url }}" class="dark-product-card" aria-label="Moisturiser Hydrate Step">
                <div class="dark-product-card__image-wrapper">
                  <span class="dark-product-card__badge">Step 4</span>
                  <img class="dark-product-card__image" src="{{ 'all-5-products-moisturiser-front.jpeg' | asset_url }}" alt="Moisturiser" loading="lazy">
                </div>
                <div class="dark-product-card__title">Moisturiser</div>
                <div class="dark-product-card__price">Hydrate & Nourish</div>
              </a>

              <!-- Step 5 Card -->
              <a href="{{ routes.all_products_collection_url }}" class="dark-product-card" aria-label="Sunscreen Protect Step">
                <div class="dark-product-card__image-wrapper">
                  <span class="dark-product-card__badge">Step 5</span>
                  <img class="dark-product-card__image" src="{{ 'all-5-products-sunscreen-front.jpeg' | asset_url }}" alt="Sunscreen" loading="lazy">
                </div>
                <div class="dark-product-card__title">Sunscreen</div>
                <div class="dark-product-card__price">Protect & Shield</div>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Dark",
  "settings": [],
  "presets": [{ "name": "Featured Dark" }]
}
{% endschema %}
