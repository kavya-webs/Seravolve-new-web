<style>
  /* Sticky Header */
  .site-header-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #fff;
    box-shadow: 0 1px 8px rgba(0,0,0,0.06);
  }

  /* Announcement Bar */
  .announcement-bar {
    background-color: var(--color-bg-dark);
    color: #fff;
    text-align: center;
    padding: 8px 0;
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Main Header */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: #fff;
    width: 100%;
  }
  @media (min-width: 768px) {
    .site-header { padding: 12px 40px; }
  }
  @media (min-width: 900px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
  }

  /* Logo (Left) */
  .header-logo {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--color-bg-dark);
    text-decoration: none;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
  }

  /* Navigation (Center) */
  .header-nav { display: none; }
  @media (min-width: 900px) {
    .header-nav {
      display: flex;
      justify-content: center;
      gap: var(--spacing-md);
    }
  }
  .header-nav__link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.3s;
  }
  .header-nav__link:hover {
    color: var(--color-cta);
    opacity: 1;
  }

  /* Icons / CTA (Right) */
  .header-icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .header-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-heading);
    display: flex;
    align-items: center;
    transition: color 0.3s;
  }
  .header-icon:hover { color: var(--color-cta); }

  .header-quiz-btn { display: none; }
  @media (min-width: 900px) {
    .header-quiz-btn {
      display: inline-flex;
      margin-left: 16px;
      padding: 10px 24px;
      font-size: 0.75rem;
    }
  }

  /* Mobile Menu Icon */
  .header-mobile-menu {
    display: flex;
    align-items: center;
    margin-right: 16px;
  }
  @media (min-width: 900px) {
    .header-mobile-menu { display: none; }
  }
</style>

<div class="site-header-wrapper">
  <!-- Announcement Bar -->
  <div class="announcement-bar">
    Free Shipping on orders above ₹999
  </div>

  <!-- Main Header -->
  <header class="site-header">
    <!-- Left: Logo & Mobile Hamburger -->
    <div style="display: flex; align-items: center;">
      <button class="header-icon header-mobile-menu" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <a href="{{ routes.root_url }}" class="header-logo">
        {{ shop.name }}
      </a>
    </div>

    <!-- Center: Navigation -->
    <nav class="header-nav">
      <a href="{{ routes.root_url }}" class="header-nav__link">Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="header-nav__link">Shop</a>
      <a href="#" class="header-nav__link">Routines</a>
      <a href="#" class="header-nav__link">About</a>
    </nav>

    <!-- Right: Icons & CTA -->
    <div class="header-icons">
      <a href="{{ routes.search_url }}" class="header-icon" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="header-icon" aria-label="Cart" id="HeaderCartIcon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>
      <a href="#" class="btn header-quiz-btn">Build Routine</a>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
