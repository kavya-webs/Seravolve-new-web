<style>
  /* Sticky Main Navbar */
  .site-header-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #fff;
    box-shadow: 0 1px 8px rgba(0,0,0,0.06);
  }

  /* Top Utility Announcement Bar */
  .announcement-bar {
    background-color: #ffffff;
    color: var(--color-text-heading);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 8px 16px;
    font-size: 0.9rem;
    font-family: var(--font-body);
  }
  @media (min-width: 769px) {
    .announcement-bar {
      padding: 10px 80px;
    }
  }

  .announcement-bar__container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin: 0 auto;
    gap: 12px;
  }

  /* Left: Social Media Icons */
  .announcement-bar__socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .announcement-bar__social-link {
    color: var(--color-bg-dark);
    transition: transform 0.2s, color 0.2s;
    display: flex;
    align-items: center;
  }
  .announcement-bar__social-link:hover {
    color: var(--color-cta);
    transform: translateY(-1px);
  }

  /* Center: Sale Text & Live Countdown Timer */
  .announcement-bar__sale {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 auto;
  }
  .announcement-bar__sale-text {
    color: var(--color-cta);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
  }
  .announcement-bar__timer {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .timer-pill {
    background: var(--color-bg-alternate);
    color: var(--color-cta);
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-size: 0.95rem;
    font-weight: 700;
    border: 1px solid rgba(0, 149, 255, 0.15);
  }
  .timer-pill__unit {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-cta);
  }
  .timer-colon {
    color: var(--color-cta);
    font-weight: 700;
    font-size: 1rem;
  }

  /* Right: Currency & Language Selectors */
  .announcement-bar__selectors {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .announcement-bar__selector-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-bg-dark);
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .announcement-bar__selector-item:hover {
    color: var(--color-cta);
  }
  .flag-icon {
    width: 20px;
    height: 14px;
    border-radius: 2px;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .announcement-bar__socials,
    .announcement-bar__selectors {
      display: none;
    }
    .announcement-bar__sale {
      justify-content: center;
      width: 100%;
    }
  }

  /* Main Header Padding matching Hero Image */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: #fff;
    width: 100%;
  }
  @media (min-width: 769px) {
    .site-header { padding: 16px 80px; }
  }
  @media (min-width: 900px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
  }

  /* Logo (Left) */
  .header-logo {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--color-bg-dark);
    text-decoration: none;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
  }

  /* Navigation (Center) */
  .header-nav { display: none; }
  @media (min-width: 900px) {
    .header-nav {
      display: flex;
      justify-content: center;
      gap: var(--spacing-md);
    }
  }
  .header-nav__link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-heading);
    text-decoration: none;
    transition: color 0.3s;
  }
  .header-nav__link:hover {
    color: var(--color-cta);
    opacity: 1;
  }

  /* Icons / CTA (Right) */
  .header-icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .header-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-heading);
    display: flex;
    align-items: center;
    transition: color 0.3s;
  }
  .header-icon:hover { color: var(--color-cta); }

  .header-quiz-btn { display: none; }
  @media (min-width: 900px) {
    .header-quiz-btn {
      display: inline-flex;
      margin-left: 16px;
      padding: 10px 24px;
      font-size: 0.75rem;
    }
  }

  /* Mobile Menu Icon */
  .header-mobile-menu {
    display: flex;
    align-items: center;
    margin-right: 16px;
  }
  @media (min-width: 900px) {
    .header-mobile-menu { display: none; }
  }

  /* Mobile Menu Drawer & Overlay */
  .mobile-menu-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(18,59,90,0.5);
    backdrop-filter: blur(2px);
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .mobile-menu-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-drawer {
    position: fixed;
    top: 0; left: 0;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    background: #fff;
    z-index: 9999;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 25px rgba(0,0,0,0.15);
    padding: 24px 20px;
    overflow-y: auto;
  }
  .mobile-menu-drawer.is-open {
    transform: translateX(0);
  }

  .mobile-menu-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 20px;
  }

  .mobile-menu-close {
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-text-heading);
    cursor: pointer;
    padding: 4px 8px;
  }

  .mobile-menu-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-grow: 1;
  }

  .mobile-menu-drawer__link {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-heading);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 8px 0;
    border-bottom: 1px dashed rgba(0,0,0,0.05);
    transition: color 0.2s ease;
  }
  .mobile-menu-drawer__link:hover {
    color: var(--color-cta);
  }

  .mobile-menu-drawer__footer {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-menu-drawer__contact {
    font-size: 0.8rem;
    color: var(--color-text-body);
    line-height: 1.5;
  }
</style>

