<!-- ===== HERO ===== -->
<section class="about-hero" aria-label="About Seravolve">
  <div class="about-hero__content">
    <span class="about-hero__badge">Our Story</span>
    <h1 class="about-hero__title">Elevating Skincare Through Science & Simplicity</h1>
    <p class="about-hero__subtitle">We believe great skin starts with great science. Seravolve combines clinically proven actives with clean formulations to deliver visible results — no fillers, no guesswork.</p>
  </div>
</section>

<!-- ===== OUR STORY ===== -->
<section class="about-story" aria-label="Our Story">
  <div class="container">
    <div class="about-story__grid">
      <div class="about-story__image-wrapper">
        <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=800&q=80" alt="Seravolve skincare laboratory with natural ingredients" loading="lazy">
      </div>
      <div class="about-story__text">
        <span class="about-story__label">The Beginning</span>
        <h2 class="about-story__title">Born From a Belief in Better Skincare</h2>
        <p class="about-story__body">
          Seravolve was founded with a clear mission: to make clinical-grade skincare accessible to everyone. We saw an industry flooded with empty promises and unnecessary chemicals, so we set out to change it.
        </p>
        <p class="about-story__body">
          Every Seravolve product is developed in partnership with dermatologists and formulated with potent, well-researched actives — Vitamin C, Hyaluronic Acid, Niacinamide, and Salicylic Acid — at concentrations that actually work. We test rigorously, source responsibly, and never compromise on quality.
        </p>
        <a href="/pages/quiz" class="btn">Build Your Routine</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== THREE PILLARS ===== -->
<section class="about-pillars" aria-label="Our Core Values">
  <div class="container">
    <div class="about-pillars__header">
      <span class="about-pillars__label">What We Stand For</span>
      <h2 class="about-pillars__title">The Three Pillars</h2>
    </div>
    <div class="about-pillars__grid">

      <!-- Pillar 1 -->
      <div class="pillar-card">
        <div class="pillar-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="pillar-card__title">Pure & Potent Ingredients</h3>
        <p class="pillar-card__desc">We use only clinically validated actives at effective concentrations. No parabens, no sulfates, no artificial fragrances — ever.</p>
      </div>

      <!-- Pillar 2 -->
      <div class="pillar-card">
        <div class="pillar-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
        </div>
        <h3 class="pillar-card__title">Dermatologist Formulated</h3>
        <p class="pillar-card__desc">Every product is co-developed with board-certified dermatologists and undergoes rigorous clinical testing before launch.</p>
      </div>

      <!-- Pillar 3 -->
      <div class="pillar-card">
        <div class="pillar-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
        </div>
        <h3 class="pillar-card__title">Eco-Conscious & Cruelty-Free</h3>
        <p class="pillar-card__desc">100% vegan, cruelty-free, and packaged in recyclable materials. We care about your skin and the planet equally.</p>
      </div>

    </div>
  </div>
</section>

<!-- ===== STATS STRIP ===== -->
<section class="about-stats" aria-label="Seravolve by the numbers">
