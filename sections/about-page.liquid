<style>
  /* ============================================
     ABOUT US PAGE — Seravolve Brand Story
     ============================================ */

  /* Hero */
  .about-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, #123B5A 0%, #0A5C8F 50%, #0095FF 100%);
    overflow: hidden;
    padding: var(--spacing-xxl) 20px;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(102,200,255,0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(0,149,255,0.1) 0%, transparent 40%);
    pointer-events: none;
  }
  .about-hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }
  .about-hero__badge {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.9);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    margin-bottom: var(--spacing-md);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .about-hero__title {
    color: #ffffff;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.15;
    margin-bottom: var(--spacing-sm);
    font-weight: 400;
  }
  .about-hero__subtitle {
    color: rgba(255,255,255,0.75);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Story Section */
  .about-story {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-primary);
  }
  .about-story__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }
  @media (min-width: 768px) {
    .about-story__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .about-story__image-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-bg-secondary);
  }
  .about-story__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-story__image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 16px;
    pointer-events: none;
  }
  .about-story__text {
    max-width: 520px;
  }
  .about-story__label {
    display: inline-block;
    color: var(--color-cta);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  .about-story__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }
  .about-story__body {
    color: var(--color-text-body);
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  /* Pillars / Values */
  .about-pillars {
    padding: var(--spacing-xxl) 0;
    background: var(--color-bg-alternate);
  }
  .about-pillars__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }
  .about-pillars__label {
    display: inline-block;
    color: var(--color-cta);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }
  .about-pillars__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }
  .about-pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  @media (min-width: 768px) {
    .about-pillars__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pillar-card {
    background: var(--color-bg-primary);
    border-radius: 16px;
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pillar-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }
  .pillar-card__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--spacing-md);
    border-radius: 50%;
    background: var(--color-bg-alternate);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cta);
  }
  .pillar-card__title {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-xs);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
  }
  .pillar-card__desc {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Stats Strip */
  .about-stats {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-dark);
  }
  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    text-align: center;
  }
  @media (min-width: 768px) {
    .about-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat-item {
    padding: var(--spacing-sm) 0;
  }
  .stat-item__number {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    line-height: 1;
    margin-bottom: 8px;
  }
  .stat-item__label {
    color: rgba(255,255,255,0.6);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  /* CTA Section */
  .about-cta {
    padding: var(--spacing-xxl) 0;
    text-align: center;
    background: var(--color-bg-primary);
  }
  .about-cta__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: var(--spacing-sm);
  }
  .about-cta__text {
    color: var(--color-text-body);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto var(--spacing-md);
  }
</style>

