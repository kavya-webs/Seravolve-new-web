      </div>
      <div class="stat-item">
        <div class="stat-item__number">10K+</div>
        <div class="stat-item__label">Happy Customers</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="about-cta" aria-label="Get started">
  <div class="container">
    <h2 class="about-cta__title">Ready to Transform Your Skin?</h2>
    <p class="about-cta__text">Take our 60-second quiz and discover a personalized routine built just for you — backed by dermatologists, powered by science.</p>
    <a href="/pages/quiz" class="btn">Take the Skin Quiz</a>
  </div>
</section>

