<style>
  .site-footer {
    background-color: var(--color-bg-dark);
    color: #ffffff;
    padding: var(--spacing-xxl) 0 var(--spacing-lg) 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
  .footer-block__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .footer-menu {
    list-style: none;
  }
  .footer-menu li {
    margin-bottom: 8px;
  }
  .footer-menu a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-menu a:hover {
    color: #ffffff;
  }
  .footer-contact p {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
  }
  
  /* Newsletter */
  .newsletter-form {
    display: flex;
    margin-top: var(--spacing-sm);
  }
  .newsletter-input {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 12px 16px;
    color: #fff;
    border-radius: 4px 0 0 4px;
    font-family: inherit;
    outline: none;
  }
  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .newsletter-btn {
    background: var(--color-cta);
    color: #fff;
    border: none;
    padding: 0 24px;
    font-weight: 600;
    border-radius: 0 4px 4px 0;
    cursor: pointer;
  }
  
  /* Bottom Bar */
  .footer-bottom {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .social-icons {
    display: flex;
    gap: 16px;
  }
  .social-icons a {
    color: #fff;
    opacity: 0.7;
    transition: opacity 0.3s;
  }
  .social-icons a:hover {
    opacity: 1;
  }
</style>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <!-- Newsletter & About -->
      <div class="footer-block">
        <h2 class="footer-block__title">Seravolve</h2>
        <p style="color: rgba(255,255,255,0.7); margin-bottom: 16px; max-width: 300px;">
          Elevate your skincare routine with scientifically backed formulas for glowing, healthy skin.
        </p>
        <form class="newsletter-form">
          <input type="email" class="newsletter-input" placeholder="Your email address" required>
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
      </div>

      <!-- Quick Links -->
      <div class="footer-block">
        <h3 class="footer-block__title">Explore</h3>
        <ul class="footer-menu">
          <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
          <li><a href="/pages/routines">Routines</a></li>
          <li><a href="/pages/quiz">Build Your Routine</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/blogs/news">Blog</a></li>
        </ul>
      </div>

      <!-- Support Links -->
      <div class="footer-block">
        <h3 class="footer-block__title">Support</h3>
        <ul class="footer-menu">
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/faq#faq-shipping">Shipping & Delivery</a></li>
          <li><a href="/pages/faq#faq-returns">Returns & Refunds</a></li>
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Contact & Grievance -->
      <div class="footer-block footer-contact">
        <h3 class="footer-block__title">Contact Us</h3>
        <p>Email: <a href="mailto:info@seravolve" style="color: inherit; text-decoration: underline;">info@seravolve</a></p>
        <p>Phone: +91 9978099097</p>
        <br>
        <h3 class="footer-block__title" style="margin-bottom: 8px;">Grievance Officer</h3>
        <p>Email: <a href="mailto:info@seravolve" style="color: inherit; text-decoration: underline;">info@seravolve</a></p>
        <p>Phone: +91 9978099097</p>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="copyright">
        &copy; {{ 'now' | date: "%Y" }} Seravolve. All rights reserved.
      </div>
      <div class="social-icons">
        <a href="https://www.instagram.com/seravolve" target="_blank" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://www.facebook.com/people/Seravolve/61590433214671/" target="_blank" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3.8l.2-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://pin.it/2rym1fiZH" target="_blank" aria-label="Pinterest">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.951-7.252 4.168 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.625 0 12.017 0z"/></svg>
