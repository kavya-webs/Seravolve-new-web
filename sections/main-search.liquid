<style>
  /* ============================================
     SERAVOLVE SEARCH RESULTS PAGE
     ============================================ */

  .search-page {
    padding: var(--spacing-xl) 0 var(--spacing-xxl);
    background-color: var(--color-bg-primary);
    min-height: 70vh;
  }

  .search-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--spacing-xl);
  }

  .search-header__badge {
    display: inline-block;
    background: #EEF8FF;
    color: #0095FF;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .search-header__title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 12px;
  }

  .search-header__count {
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  /* Search Input Form on Results Page */
  .search-form-bar {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  .search-form-bar__input {
    width: 100%;
    padding: 14px 50px 14px 20px;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .search-form-bar__input:focus {
    border-color: #0095FF;
    box-shadow: 0 0 0 4px rgba(0, 149, 255, 0.12);
  }
  .search-form-bar__btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: #0095FF;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #FFF;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Product Grid */
  .search-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: var(--spacing-xl);
  }
  @media (min-width: 768px) {
    .search-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .search-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Search Product Card */
  .search-card {
    background: #FFF;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    border: 1.5px solid #F1F5F9;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .search-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 149, 255, 0.12);
    border-color: #0095FF;
  }
  .search-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #EEF8FF;
    overflow: hidden;
  }
  .search-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .search-card:hover .search-card__img {
    transform: scale(1.04);
  }
  .search-card__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }
  .search-card__title {
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .search-card__price {
    font-size: 1rem;
    font-weight: 700;
    color: #0095FF;
    margin-bottom: 12px;
  }
  .search-card__btn {
    width: 100%;
    padding: 10px;
    background: #EEF8FF;
    color: #0095FF;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.25s ease;
  }
  .search-card:hover .search-card__btn {
    background: #0095FF;
    color: #FFF;
  }

  /* Empty Search State */
  .search-empty {
    text-align: center;
    padding: 60px 20px;
    background: #FFF;
    border-radius: 24px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.03);
    margin-top: 24px;
  }
  .search-empty__icon {
    font-size: 3.5rem;
    margin-bottom: 16px;
  }
  .search-empty__title {
    font-size: 1.5rem;
    font-family: var(--font-heading);
    margin-bottom: 8px;
  }
  .search-empty__text {
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }
</style>

<div class="search-page">
  <div class="container">
    
    <!-- Search Header -->
    <div class="search-header">
      <span class="search-header__badge">Search</span>
      
      {%- if search.performed -%}
        <h1 class="search-header__title">Search Results</h1>
        <p class="search-header__count">
          Showing <strong>{{ search.results_count }}</strong> {% if search.results_count == 1 %}result{% else %}results{% endif %} for "<strong>{{ search.terms | escape }}</strong>"
        </p>
      {%- else -%}
        <h1 class="search-header__title">Search Our Store</h1>
        <p class="search-header__count">Type a keyword to find products, formulations, or routines.</p>
      {%- endif -%}

      <!-- Search Input Bar -->
      <form action="{{ routes.search_url }}" method="get" class="search-form-bar">
        <input type="hidden" name="type" value="product">
        <input type="search" name="q" class="search-form-bar__input" value="{{ search.terms | escape }}" placeholder="Search products..." autocomplete="off">
        <button type="submit" class="search-form-bar__btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    </div>

    <!-- Search Results Content -->
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        
        <div class="search-grid">
          {%- for item in search.results -%}
            <a href="{{ item.url }}" class="search-card">
              <div class="search-card__image-wrapper">
                {%- if item.featured_image -%}
                  <img class="search-card__img" src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.title | escape }}" loading="lazy">
                {%- else -%}
                  <img class="search-card__img" src="{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" alt="{{ item.title | escape }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="search-card__body">
                <div>
                  <h2 class="search-card__title">{{ item.title }}</h2>
                  <div class="search-card__price">{{ item.price | money }}</div>
                </div>
                <div class="search-card__btn">View Product</div>
              </div>
            </a>
          {%- endfor -%}
        </div>

      {%- else -%}

        <!-- Empty Results -->
        <div class="search-empty">
          <div class="search-empty__icon">🔍</div>
          <h2 class="search-empty__title">No products found</h2>
          <p class="search-empty__text">We couldn't find any products matching "{{ search.terms | escape }}". Try searching for "Facewash", "Serum", or "Sunscreen".</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">Browse All Products</a>
        </div>

      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
