<style>
  .hero-slider-section {
    position: relative;
    padding: 0 80px;
    background-color: var(--color-bg-primary);
  }
  @media (max-width: 768px) {
    .hero-slider-section { padding: 0 16px; }
  }

  .hero-slider-track {
    position: relative;
    width: 100%;
    height: 75vh;
    min-height: 500px;
    border-radius: 20px;
    overflow: hidden;
  }

  .hero-slider {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hero-slider::-webkit-scrollbar { display: none; }

  .hero-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 80px;
  }

  .hero-slide__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-slide::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 100%);
    z-index: 2;
  }

  .hero-slide__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #fff;
  }
  .hero-slide__title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: #fff;
    margin-bottom: var(--spacing-sm);
    font-style: italic;
  }
  .hero-slide__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: #C0392B;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .hero-slide__btn:hover { background-color: #A93226; opacity: 1; }

  /* Navigation */
  .hero-nav {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 5;
  }
  .hero-nav-arrow {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.5);
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s;
  }
  .hero-nav-arrow:hover { background: rgba(255,255,255,0.2); }
  .hero-progress {
    width: 120px; height: 3px;
    background: rgba(255,255,255,0.3);
    border-radius: 2px;
    overflow: hidden;
  }
  .hero-progress__bar {
    height: 100%;
    background: #fff;
    width: 50%;
    transition: width 0.3s;
  }
</style>

<section class="hero-slider-section">
  <div class="hero-slider-track">
    <div class="hero-slider" id="HeroSlider">
      <div class="hero-slide">
        <img class="hero-slide__image" src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?w=1600&q=80" alt="Beautiful skin model" loading="eager">
        <div class="hero-slide__content">
          <h2 class="hero-slide__title">Your Skin's New Best Friend<br>Effortlessly to Use</h2>
          <a href="{{ routes.all_products_collection_url }}" class="hero-slide__btn">Shop Now</a>
        </div>
      </div>
      <div class="hero-slide">
        <img class="hero-slide__image" src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&q=80" alt="Skincare routine essentials" loading="lazy">
        <div class="hero-slide__content">
          <h2 class="hero-slide__title">Unlock Your Best Skin<br>Daily Essentials</h2>
          <a href="{{ routes.all_products_collection_url }}" class="hero-slide__btn">Explore Now</a>
        </div>
      </div>
    </div>

    <div class="hero-nav">
      <button class="hero-nav-arrow" id="HeroPrev" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="hero-progress"><div class="hero-progress__bar" id="HeroProgressBar"></div></div>
      <button class="hero-nav-arrow" id="HeroNext" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slider = document.getElementById('HeroSlider');
  const prev = document.getElementById('HeroPrev');
  const next = document.getElementById('HeroNext');
  const bar = document.getElementById('HeroProgressBar');
  const slides = slider.children;
  let current = 0;

  function goTo(i) {
    current = (i + slides.length) % slides.length;
    slides[current].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    bar.style.width = ((current + 1) / slides.length * 100) + '%';
  }
  prev.addEventListener('click', () => goTo(current - 1));
  next.addEventListener('click', () => goTo(current + 1));

  // Auto-advance every 5s
  setInterval(() => goTo(current + 1), 5000);
});
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "presets": [{ "name": "Hero Slider" }]
}
{% endschema %}
