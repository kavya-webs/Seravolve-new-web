<style>
  .hero-slider-section {
    position: relative;
    padding: 20px 80px;
    background-color: var(--color-bg-primary);
  }
  @media (max-width: 768px) {
    .hero-slider-section { padding: 8px 10px; }
    .hero-slider-track {
      height: 52vh;
      min-height: 330px;
      max-height: 380px;
      border-radius: 14px;
    }
    .hero-slide {
      padding-bottom: 35px;
    }
    .hero-slide__content {
      padding: 0 14px;
    }
    .hero-slide__title {
      font-size: 1.3rem;
      line-height: 1.2;
      margin-bottom: 10px;
    }
    .hero-slide__btn {
      padding: 8px 20px;
      font-size: 0.75rem;
      letter-spacing: 1px;
      border-radius: 6px;
    }
    .hero-nav {
      bottom: 10px;
      gap: 8px;
    }
    .hero-nav-arrow {
      width: 28px;
      height: 28px;
    }
    .hero-progress {
      width: 70px;
    }
  }

  .hero-slider-track {
    position: relative;
    width: 100%;
    height: 75vh;
    min-height: 500px;
    border-radius: 20px;
    overflow: hidden;
  }

  .hero-slider {
    display: flex;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 80px;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }
  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-slide__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }


  /* Navigation */
  .hero-nav {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 5;
  }
  .hero-nav-arrow {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.5);
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s;
  }
  .hero-nav-arrow:hover { background: rgba(255,255,255,0.2); }
  .hero-progress {
    width: 120px; height: 3px;
    background: rgba(255,255,255,0.3);
    border-radius: 2px;
    overflow: hidden;
  }
  .hero-progress__bar {
    height: 100%;
    background: #fff;
    width: 50%;
    transition: width 0.5s;
  }
</style>

<section class="hero-slider-section">
  <div class="hero-slider-track">
    <div class="hero-slider" id="HeroSlider">
      <!-- Slide 1 -->
      <a href="{{ routes.all_products_collection_url }}" class="hero-slide is-active">
        <img class="hero-slide__image" src="{{ 'hero-banner-new-1.jpg' | asset_url }}" alt="Science-Backed Skincare, Simplified" loading="eager">
      </a>

      <!-- Slide 2 -->
      <a href="{{ routes.all_products_collection_url }}" class="hero-slide">
        <img class="hero-slide__image" src="{{ 'hero-banner-new-2.jpg' | asset_url }}" alt="Protect. Hydrate. Repeat." loading="lazy">
      </a>

    </div>

    <div class="hero-nav">
      <button class="hero-nav-arrow" id="HeroPrev" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="hero-progress"><div class="hero-progress__bar" id="HeroProgressBar"></div></div>
      <button class="hero-nav-arrow" id="HeroNext" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.hero-slide');
  const prev = document.getElementById('HeroPrev');
  const next = document.getElementById('HeroNext');
  const bar = document.getElementById('HeroProgressBar');
  let current = 0;

  function goTo(i) {
    if (slides.length === 0) return;
    slides[current].classList.remove('is-active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (bar) {
      bar.style.width = ((current + 1) / slides.length * 100) + '%';
    }
  }

  if (prev && next) {
    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
  }
  
  setInterval(() => goTo(current + 1), 6000);
});
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "presets": [{ "name": "Hero Slider" }]
}
{% endschema %}
