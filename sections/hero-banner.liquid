<style>
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--color-bg-secondary);
    overflow: hidden;
  }
  .hero-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  /* Subtle overlay to ensure text is readable over image */
  .hero-banner::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(250, 246, 240, 0.8) 0%, rgba(250, 246, 240, 0.2) 100%);
    z-index: 2;
  }
  .hero-banner__content {
    position: relative;
    z-index: 3;
    max-width: 600px;
    /* Extra top padding so it clears the absolute header */
    padding-top: 100px; 
  }
  .hero-banner__title {
    margin-bottom: var(--spacing-sm);
  }
  .hero-banner__text {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
  }
</style>

<section class="hero-banner">
  <img class="hero-banner__image" src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?w=1600&q=80" alt="Skincare Routine" loading="eager">
  
  <div class="container">
    <div class="hero-banner__content">
      <h1 class="hero-banner__title">{{ section.settings.title }}</h1>
      <p class="hero-banner__text">{{ section.settings.text }}</p>
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ routes.all_products_collection_url }}" class="btn">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Elevate Your Skincare Routine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover scientifically backed formulas for glowing, healthy skin every day."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
