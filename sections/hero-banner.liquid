<style>
  .hero-slider-section {
    position: relative;
    padding: 20px 80px;
    background-color: var(--color-bg-primary);
  }
  @media (max-width: 768px) {
    .hero-slider-section { padding: 10px 12px; }
    .hero-slider-track {
      height: 70vh;
      min-height: 420px;
      max-height: 480px;
      border-radius: 16px;
    }
    .hero-slide {
      padding-bottom: 50px;
    }
    .hero-slide__content {
      padding: 0 16px;
    }
    .hero-slide__title {
      font-size: 1.5rem;
      line-height: 1.25;
      margin-bottom: 14px;
    }
    .hero-slide__btn {
      padding: 10px 24px;
      font-size: 0.8rem;
      letter-spacing: 1px;
      border-radius: 8px;
    }
    .hero-nav {
      bottom: 16px;
      gap: 10px;
    }
    .hero-nav-arrow {
      width: 32px;
      height: 32px;
    }
    .hero-progress {
      width: 80px;
    }
  }

  .hero-slider-track {
    position: relative;
    width: 100%;
    height: 75vh;
    min-height: 500px;
    border-radius: 20px;
    overflow: hidden;
  }

  .hero-slider {
    display: flex;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 80px;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }
  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-slide__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-slide::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 50%;
    background: linear-gradient(to top, rgba(18,59,90,0.6) 0%, transparent 100%);
    z-index: 2;
  }

  .hero-slide__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #fff;
    padding: 0 20px;
  }
  .hero-slide__title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: #fff;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-heading);
    font-style: italic;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
  }
  .hero-slide__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: var(--color-cta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.3s;
  }
  .hero-slide__btn:hover { 
    background-color: var(--color-cta-hover); 
    transform: scale(1.02);
    opacity: 1; 
  }

  /* Navigation */
  .hero-nav {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 5;
  }
  .hero-nav-arrow {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.5);
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s;
  }
  .hero-nav-arrow:hover { background: rgba(255,255,255,0.2); }
  .hero-progress {
    width: 120px; height: 3px;
    background: rgba(255,255,255,0.3);
    border-radius: 2px;
    overflow: hidden;
  }
  .hero-progress__bar {
    height: 100%;
    background: #fff;
    width: 33.3%;
    transition: width 0.5s;
  }
</style>

<section class="hero-slider-section">
  <div class="hero-slider-track">
    <div class="hero-slider" id="HeroSlider">
      
      <!-- Slide 1: Full Seravolve Routine -->
      <div class="hero-slide is-active">
        <img class="hero-slide__image" src="{{ 'full-seravolve-routine-hero.png' | asset_url }}" alt="Full Seravolve Routine" loading="eager">
        <div class="hero-slide__content">
          <h2 class="hero-slide__title">Complete 5-Step Skincare Routine</h2>
          <a href="{{ routes.all_products_collection_url }}" class="hero-slide__btn">Shop the Routine</a>
        </div>
      </div>

      <!-- Slide 2: Smooth Skin Routine -->
      <div class="hero-slide">
        <img class="hero-slide__image" src="{{ 'smooth-skin-routine-hero.png' | asset_url }}" alt="Smooth Skin Routine" loading="lazy">
        <div class="hero-slide__content">
          <h2 class="hero-slide__title">Get Smooth, Hydrated Skin</h2>
          <a href="{{ routes.all_products_collection_url }}" class="hero-slide__btn">Explore Routine</a>
        </div>
      </div>

      <!-- Slide 3: Skin Brightening Routine -->
      <div class="hero-slide">
        <img class="hero-slide__image" src="{{ 'skin-brightining-routine-hero.png' | asset_url }}" alt="Skin Brightening Routine" loading="lazy">
        <div class="hero-slide__content">
          <h2 class="hero-slide__title">Brighten & Glow Every Day</h2>
          <a href="{{ routes.all_products_collection_url }}" class="hero-slide__btn">Build Routine</a>
        </div>
      </div>

    </div>

    <div class="hero-nav">
      <button class="hero-nav-arrow" id="HeroPrev" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="hero-progress"><div class="hero-progress__bar" id="HeroProgressBar"></div></div>
      <button class="hero-nav-arrow" id="HeroNext" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.hero-slide');
  const prev = document.getElementById('HeroPrev');
  const next = document.getElementById('HeroNext');
  const bar = document.getElementById('HeroProgressBar');
  let current = 0;

  function goTo(i) {
    if (slides.length === 0) return;
    slides[current].classList.remove('is-active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (bar) {
      bar.style.width = ((current + 1) / slides.length * 100) + '%';
    }
  }

  if (prev && next) {
    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
  }
  
  setInterval(() => goTo(current + 1), 6000);
});
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "presets": [{ "name": "Hero Slider" }]
}
{% endschema %}
