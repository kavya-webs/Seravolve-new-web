<style>
  /* ============================================
     SERAVOLVE DESKTOP & MOBILE HERO BANNER
     ============================================ */
  .hero-slider-section {
    position: relative;
    padding: 20px 80px;
    background-color: var(--color-bg-primary);
  }
  @media (max-width: 768px) {
    .hero-slider-section { 
      padding: 8px 12px; 
    }
  }

  .hero-slider-track {
    position: relative;
    width: 100%;
    height: 65vh;
    min-height: 480px;
    max-height: 650px;
    border-radius: 20px;
    overflow: hidden;
    background: #EEF8FF;
    box-shadow: 0 12px 36px rgba(18, 59, 90, 0.08);
  }
  @media (max-width: 768px) {
    .hero-slider-track {
      height: 48vh;
      min-height: 320px;
      max-height: 380px;
      border-radius: 14px;
    }
  }

  .hero-slider {
    display: flex;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    text-decoration: none;
    display: block;
  }
  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Desktop Responsive Banner Image */
  .hero-slide__image-desktop {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  
  /* Mobile Responsive Banner Image */
  .hero-slide__image-mobile {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 768px) {
    .hero-slide__image-desktop {
      display: none;
    }
    .hero-slide__image-mobile {
      display: block;
    }
  }

  /* Overlay gradient for Mobile view text readability */
  .hero-slide__mobile-content {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-slide::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 55%;
      background: linear-gradient(to top, rgba(18,59,90,0.7) 0%, transparent 100%);
      z-index: 2;
    }
    .hero-slide__mobile-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      padding: 0 16px 45px;
      text-align: center;
      color: #FFF;
    }
    .hero-slide__mobile-title {
      font-size: 1.35rem;
      font-family: var(--font-heading);
      color: #FFF;
      margin-bottom: 10px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .hero-slide__mobile-btn {
      padding: 8px 24px;
      background: #0095FF;
      color: #FFF;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      border-radius: 50px;
      box-shadow: 0 4px 12px rgba(0, 149, 255, 0.4);
    }
  }

  /* Desktop Slider Navigation Controls */
  .hero-nav {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 5;
    background: rgba(18, 59, 90, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 8px 18px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  @media (max-width: 768px) {
    .hero-nav {
      bottom: 12px;
      padding: 6px 14px;
      gap: 10px;
    }
  }

  .hero-nav-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.6);
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
  }
  .hero-nav-arrow:hover { 
    background: rgba(255,255,255,0.3); 
    transform: scale(1.05);
  }

  .hero-progress {
    width: 100px; 
    height: 4px;
    background: rgba(255,255,255,0.3);
    border-radius: 4px;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .hero-progress { width: 65px; }
  }

  .hero-progress__bar {
    height: 100%;
    background: #0095FF;
    width: 33.3%;
    transition: width 0.5s ease;
  }
</style>

<section class="hero-slider-section" aria-label="Hero Banners">
  <div class="hero-slider-track">
    <div class="hero-slider" id="HeroSlider">
      
      <!-- Desktop Banner 1: Ultra Light Sunscreen -->
      <a href="/products/daily-uv-defence-routine" class="hero-slide is-active" aria-label="Ultra Light Sunscreen SPF 50">
        <img class="hero-slide__image-desktop" src="{{ 'desktop-hero-sunscreen.jpg' | asset_url }}" alt="Seravolve Ultra Light Sunscreen SPF 50 PA++++" loading="eager">
        <img class="hero-slide__image-mobile" src="{{ 'uv-defence-routine-hero.png' | asset_url }}" alt="Ultra Light Sunscreen" loading="eager">
        <div class="hero-slide__mobile-content">
          <h2 class="hero-slide__mobile-title">Ultra Light Sunscreen SPF 50</h2>
          <span class="hero-slide__mobile-btn">Shop Now</span>
        </div>
      </a>

      <!-- Desktop Banner 2: Glow Activated Vitamin C Serum -->
      <a href="/products/skin-brightening-routine" class="hero-slide" aria-label="Glow Activated Vitamin C Serum">
        <img class="hero-slide__image-desktop" src="{{ 'desktop-hero-vitamin-c.jpg' | asset_url }}" alt="Seravolve Glow Activated Vitamin C Serum 10%" loading="lazy">
        <img class="hero-slide__image-mobile" src="{{ 'skin-brightining-routine-hero.png' | asset_url }}" alt="Glow Activated Vitamin C Serum" loading="lazy">
        <div class="hero-slide__mobile-content">
          <h2 class="hero-slide__mobile-title">10% Vitamin C Glow Serum</h2>
          <span class="hero-slide__mobile-btn">Activate Glow</span>
        </div>
      </a>

      <!-- Desktop Banner 3: Clarifying Face Wash -->
      <a href="/products/acne-control-routine" class="hero-slide" aria-label="Clarifying Face Wash 2% Salicylic">
        <img class="hero-slide__image-desktop" src="{{ 'desktop-hero-facewash.jpg' | asset_url }}" alt="Seravolve Clarifying Face Wash 2% Salicylic Acid" loading="lazy">
        <img class="hero-slide__image-mobile" src="{{ 'acne-control-routine-0.png' | asset_url }}" alt="Clarifying Face Wash" loading="lazy">
        <div class="hero-slide__mobile-content">
          <h2 class="hero-slide__mobile-title">Clarifying Face Wash 2% Salicylic</h2>
          <span class="hero-slide__mobile-btn">Explore Now</span>
        </div>
      </a>

    </div>

    <!-- Controls Nav -->
    <div class="hero-nav">
      <button class="hero-nav-arrow" id="HeroPrev" aria-label="Previous Slide">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="hero-progress"><div class="hero-progress__bar" id="HeroProgressBar"></div></div>
      <button class="hero-nav-arrow" id="HeroNext" aria-label="Next Slide">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.hero-slide');
  const prev = document.getElementById('HeroPrev');
  const next = document.getElementById('HeroNext');
  const bar = document.getElementById('HeroProgressBar');
  let current = 0;

  function goTo(i) {
    if (slides.length === 0) return;
    slides[current].classList.remove('is-active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (bar) {
      bar.style.width = ((current + 1) / slides.length * 100) + '%';
    }
  }

  if (prev && next) {
    prev.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(current - 1);
    });
    next.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(current + 1);
    });
  }
  
  setInterval(() => goTo(current + 1), 6000);
});
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "presets": [{ "name": "Hero Slider" }]
}
{% endschema %}
