<style>
  .self-care-grid {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .self-care-grid__heading {
    text-align: center;
    margin-bottom: 8px;
  }
  .self-care-grid__subtext {
    text-align: center;
    color: var(--color-text-body);
    margin-bottom: var(--spacing-lg);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .self-care-grid__items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }
  @media (min-width: 768px) {
    .self-care-grid__items {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .self-care-card {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1/1;
  }
  .self-care-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .self-care-card:hover .self-care-card__image {
    transform: scale(1.05);
  }
</style>

<section class="self-care-grid">
  <div class="container">
    <h2 class="self-care-grid__heading">Natural Self Care Products</h2>
    <p class="self-care-grid__subtext">We create formulated products that really work and make you feel good</p>

    <div class="self-care-grid__items">
      <div class="self-care-card">
        <img class="self-care-card__image" src="{{ 'all-5-products-facewash-l-2-hero.png' | asset_url }}" alt="Seravolve Facewash L-2 Hero" loading="lazy">
      </div>
      <div class="self-care-card">
        <img class="self-care-card__image" src="{{ 'all-5-products-toner-l-2-hero.png' | asset_url }}" alt="Seravolve Toner L-2 Hero" loading="lazy">
      </div>
      <div class="self-care-card">
        <img class="self-care-card__image" src="{{ 'all-5-products-moisturiser-l-2-hero.png' | asset_url }}" alt="Seravolve Moisturiser L-2 Hero" loading="lazy">
      </div>
      <div class="self-care-card">
        <img class="self-care-card__image" src="{{ 'all-5-products-sunscreen-l-2-hero.jpg' | asset_url }}" alt="Seravolve Sunscreen L-2 Hero" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Self Care Grid",
  "settings": [],
  "presets": [{ "name": "Self Care Grid" }]
}
{% endschema %}
