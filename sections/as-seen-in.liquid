<style>
  .as-seen-in {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-primary);
  }
  .as-seen-in__heading {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  .as-seen-in__track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 40px 16px;
    scrollbar-width: none;
  }
  .as-seen-in__track::-webkit-scrollbar { display: none; }
  
  .as-seen-in__video-card {
    flex: 0 0 calc(75vw - 40px);
    max-width: 260px;
    scroll-snap-align: center;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 9/16;
    background: #000;
  }
  
  .as-seen-in__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none; /* Prevent accidental clicks if acting as background */
  }
  
  /* Instagram overlay icon (optional nice touch) */
  .as-seen-in__ig-icon {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 24px;
    height: 24px;
    fill: #fff;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    z-index: 2;
  }
</style>

<section class="as-seen-in">
  <div class="container">
    <h2 class="as-seen-in__heading">{{ section.settings.heading }}</h2>
  </div>
  
  <div class="as-seen-in__track">
    {% for block in section.blocks %}
      <div class="as-seen-in__video-card" {{ block.shopify_attributes }}>
        
        <!-- Optional Instagram Icon -->
        <svg class="as-seen-in__ig-icon" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>

        {% if block.settings.video %}
          {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'as-seen-in__video', image_size: '600x' }}
        {% else %}
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eee; color: #999; font-family: sans-serif;">Select a Video</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "As Seen In",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen In"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video (MP4)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen In",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
