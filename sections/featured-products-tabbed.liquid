<style>
  .tabbed-products {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-secondary);
  }
  .tabbed-products__heading {
    text-align: center;
    margin-bottom: var(--spacing-md);
  }
  .tabbed-products__tabs {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  .tabbed-products__tab {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-body);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.3s;
  }
  .tabbed-products__tab.is-active {
    color: var(--color-cta);
    border-bottom-color: var(--color-cta);
  }

  .tabbed-products__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }
  @media (min-width: 900px) {
    .tabbed-products__grid {
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    }
  }

  .product-tab-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .product-tab-card__image-wrapper {
    aspect-ratio: 3/4;
    background: var(--color-bg-alternate);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 12px;
    position: relative;
  }
  .product-tab-card__image {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .product-tab-card:hover .product-tab-card__image {
    transform: scale(1.05);
  }
  .product-tab-card__step {
    position: absolute;
    top: 12px; left: 12px;
    background: var(--color-cta);
    color: #fff;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    z-index: 2;
  }
  .product-tab-card__title {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-align: center;
    margin-bottom: 4px;
    color: var(--color-text-heading);
  }
  .product-tab-card__subtitle {
    font-size: 0.8rem;
    text-align: center;
    color: var(--color-text-body);
  }
</style>

<section class="tabbed-products">
  <div class="container">
    <h2 class="tabbed-products__heading">Your 5-Step Routine</h2>
    <div class="tabbed-products__tabs">
      <button class="tabbed-products__tab is-active">All Products</button>
      <button class="tabbed-products__tab">Best Sellers</button>
    </div>

    <div class="tabbed-products__grid">
      <!-- Step 1: Facewash -->
      <a href="#" class="product-tab-card">
        <div class="product-tab-card__image-wrapper">
          <span class="product-tab-card__step">1</span>
          <img class="product-tab-card__image" src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=500&q=80" alt="Seravolve Facewash" loading="lazy">
        </div>
        <h3 class="product-tab-card__title">Facewash</h3>
        <p class="product-tab-card__subtitle">Cleanse</p>
      </a>

      <!-- Step 2: Toner -->
      <a href="#" class="product-tab-card">
        <div class="product-tab-card__image-wrapper">
          <span class="product-tab-card__step">2</span>
          <img class="product-tab-card__image" src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?w=500&q=80" alt="Seravolve Toner" loading="lazy">
        </div>
        <h3 class="product-tab-card__title">Toner</h3>
        <p class="product-tab-card__subtitle">Prep & Balance</p>
      </a>

      <!-- Step 3: Serum -->
      <a href="#" class="product-tab-card">
        <div class="product-tab-card__image-wrapper">
          <span class="product-tab-card__step">3</span>
          <img class="product-tab-card__image" src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80" alt="Seravolve Serum" loading="lazy">
        </div>
        <h3 class="product-tab-card__title">Serum</h3>
        <p class="product-tab-card__subtitle">Treat & Target</p>
      </a>

      <!-- Step 4: Moisturiser -->
      <a href="#" class="product-tab-card">
        <div class="product-tab-card__image-wrapper">
          <span class="product-tab-card__step">4</span>
          <img class="product-tab-card__image" src="https://images.unsplash.com/photo-1570194065650-d99fb4b8ceb0?w=500&q=80" alt="Seravolve Moisturiser" loading="lazy">
        </div>
        <h3 class="product-tab-card__title">Moisturiser</h3>
        <p class="product-tab-card__subtitle">Hydrate & Nourish</p>
      </a>

      <!-- Step 5: Sunscreen -->
      <a href="#" class="product-tab-card">
        <div class="product-tab-card__image-wrapper">
          <span class="product-tab-card__step">5</span>
          <img class="product-tab-card__image" src="https://images.unsplash.com/photo-1532947974-2e3966a8b9e6?w=500&q=80" alt="Seravolve Sunscreen" loading="lazy">
        </div>
        <h3 class="product-tab-card__title">Sunscreen</h3>
        <p class="product-tab-card__subtitle">Protect & Shield</p>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products Tabbed",
  "settings": [],
  "presets": [{ "name": "Featured Products Tabbed" }]
}
{% endschema %}
