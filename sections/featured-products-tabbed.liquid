<style>
  .tabbed-products {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-secondary);
  }
  .tabbed-products__heading {
    text-align: center;
    margin-bottom: var(--spacing-sm);
  }
  .tabbed-products__subheading {
    text-align: center;
    color: var(--color-text-body);
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
  }
  .tabbed-products__tabs {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  .tabbed-products__tab {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-body);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.3s;
  }
  .tabbed-products__tab.is-active {
    color: var(--color-cta);
    border-bottom-color: var(--color-cta);
    font-weight: 500;
  }

  .tabbed-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    transition: opacity 0.3s ease;
  }
  @media (min-width: 900px) {
    .tabbed-products__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .product-tab-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    position: relative;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .product-tab-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,149,255,0.08);
    opacity: 1;
  }
  .product-tab-card__image-wrapper {
    aspect-ratio: 3/4;
    background: var(--color-bg-alternate);
    overflow: hidden;
    position: relative;
  }
  .product-tab-card__image {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }
  .product-tab-card__image--hover {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
    z-index: 1;
  }
  .product-tab-card:hover .product-tab-card__image--hover {
    opacity: 1;
  }
  .product-tab-card:hover .product-tab-card__image--main {
    transform: scale(1.03);
  }
  .product-tab-card__step {
    position: absolute;
    top: 12px; left: 12px;
    background: var(--color-cta);
    color: #fff;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0,149,255,0.3);
  }
  .product-tab-card__badge {
    position: absolute;
    top: 12px; right: 12px;
    background: var(--color-accent);
    color: var(--color-bg-dark);
    padding: 4px 10px;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 4px;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .product-tab-card__content {
    padding: 16px;
    text-align: center;
  }
  .product-tab-card__title {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--color-text-heading);
  }
  .product-tab-card__subtitle {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }
</style>

<section class="tabbed-products">
  <div class="container">
    <h2 class="tabbed-products__heading">Your 5-Step Routine</h2>
    <p class="tabbed-products__subheading">Formulated with proven actives for every step of your routine</p>
    
    <div class="tabbed-products__tabs">
      <button class="tabbed-products__tab is-active" data-tab="all">All Products</button>
      <button class="tabbed-products__tab" data-tab="bestsellers">Best Sellers</button>
    </div>

    <div class="tabbed-products__grid" id="TabbedProductGrid">
      {%- assign all_products = collections['all'].products -%}
      {%- if all_products and all_products.size > 0 -%}
        {%- for product in all_products limit: 10 -%}
          {%- assign is_bestseller = false -%}
          {%- if product.tags contains 'bestseller' or product.tags contains 'Best Seller' or forloop.index == 1 or forloop.index == 3 or forloop.index == 5 -%}
            {%- assign is_bestseller = true -%}
          {%- endif -%}
          <a href="{{ product.url }}" class="product-tab-card" data-bestseller="{{ is_bestseller }}">
            <div class="product-tab-card__image-wrapper">
              <span class="product-tab-card__step">{{ forloop.index }}</span>
              {%- if is_bestseller -%}
                <span class="product-tab-card__badge">Bestseller</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img class="product-tab-card__image product-tab-card__image--main" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- if product.images[1] -%}
                  <img class="product-tab-card__image product-tab-card__image--hover" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }} Alternate View" loading="lazy">
                {%- else -%}
                  <img class="product-tab-card__image product-tab-card__image--hover" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- endif -%}
              {%- else -%}
                <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" alt="{{ product.title }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="product-tab-card__content">
              <h3 class="product-tab-card__title">{{ product.title }}</h3>
              <p class="product-tab-card__subtitle">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Step 1: Facewash (Bestseller) -->
        <a href="{{ routes.all_products_collection_url }}" class="product-tab-card" data-bestseller="true">
          <div class="product-tab-card__image-wrapper">
            <span class="product-tab-card__step">1</span>
            <span class="product-tab-card__badge">Bestseller</span>
            <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'all-5-products-facewash-front.jpeg' | asset_url }}" alt="Seravolve Facewash" loading="lazy">
            <img class="product-tab-card__image product-tab-card__image--hover" src="{{ 'all-5-products-facewash-back.jpeg' | asset_url }}" alt="Seravolve Facewash Back" loading="lazy">
          </div>
          <div class="product-tab-card__content">
            <h3 class="product-tab-card__title">Facewash</h3>
            <p class="product-tab-card__subtitle">Cleanse</p>
          </div>
        </a>

        <!-- Step 2: Toner -->
        <a href="{{ routes.all_products_collection_url }}" class="product-tab-card" data-bestseller="false">
          <div class="product-tab-card__image-wrapper">
            <span class="product-tab-card__step">2</span>
            <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'all-5-products-toner-front.jpeg' | asset_url }}" alt="Seravolve Toner" loading="lazy">
            <img class="product-tab-card__image product-tab-card__image--hover" src="{{ 'all-5-products-toner-back.jpeg' | asset_url }}" alt="Seravolve Toner Back" loading="lazy">
          </div>
          <div class="product-tab-card__content">
            <h3 class="product-tab-card__title">Toner</h3>
            <p class="product-tab-card__subtitle">Prep & Balance</p>
          </div>
        </a>

        <!-- Step 3: Serum (Bestseller) -->
        <a href="{{ routes.all_products_collection_url }}" class="product-tab-card" data-bestseller="true">
          <div class="product-tab-card__image-wrapper">
            <span class="product-tab-card__step">3</span>
            <span class="product-tab-card__badge">Bestseller</span>
            <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'seravolve-vitamin-c-serum.png' | asset_url }}" alt="Seravolve Serum" loading="lazy">
            <img class="product-tab-card__image product-tab-card__image--hover" src="{{ 'all-5-products-serum-back.jpeg' | asset_url }}" alt="Seravolve Serum Back" loading="lazy">
          </div>
          <div class="product-tab-card__content">
            <h3 class="product-tab-card__title">Serum</h3>
            <p class="product-tab-card__subtitle">Treat & Target</p>
          </div>
        </a>

        <!-- Step 4: Moisturiser -->
        <a href="{{ routes.all_products_collection_url }}" class="product-tab-card" data-bestseller="false">
          <div class="product-tab-card__image-wrapper">
            <span class="product-tab-card__step">4</span>
            <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'all-5-products-moisturiser-front.jpeg' | asset_url }}" alt="Seravolve Moisturiser" loading="lazy">
            <img class="product-tab-card__image product-tab-card__image--hover" src="{{ 'all-5-products-moisturiser-back.jpeg' | asset_url }}" alt="Seravolve Moisturiser Back" loading="lazy">
          </div>
          <div class="product-tab-card__content">
            <h3 class="product-tab-card__title">Moisturiser</h3>
            <p class="product-tab-card__subtitle">Hydrate & Nourish</p>
          </div>
        </a>

        <!-- Step 5: Sunscreen (Bestseller) -->
        <a href="{{ routes.all_products_collection_url }}" class="product-tab-card" data-bestseller="true">
          <div class="product-tab-card__image-wrapper">
            <span class="product-tab-card__step">5</span>
            <span class="product-tab-card__badge">Bestseller</span>
            <img class="product-tab-card__image product-tab-card__image--main" src="{{ 'all-5-products-sunscreen-front.jpeg' | asset_url }}" alt="Seravolve Sunscreen" loading="lazy">
            <img class="product-tab-card__image product-tab-card__image--hover" src="{{ 'all-5-products-sunscreen-back.jpeg' | asset_url }}" alt="Seravolve Sunscreen Back" loading="lazy">
          </div>
          <div class="product-tab-card__content">
            <h3 class="product-tab-card__title">Sunscreen</h3>
            <p class="product-tab-card__subtitle">Protect & Shield</p>
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.tabbed-products__tab');
  const cards = document.querySelectorAll('.product-tab-card');
  const grid = document.getElementById('TabbedProductGrid');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Toggle Tab Active State
      tabs.forEach(t => t.classList.remove('is-active'));
      tab.classList.add('is-active');

      const filter = tab.getAttribute('data-tab');

      // Fade animation
      if (grid) grid.style.opacity = 0;
      
      setTimeout(() => {
        cards.forEach(card => {
          if (filter === 'all') {
            card.style.display = 'flex';
          } else {
            const isBestseller = card.getAttribute('data-bestseller') === 'true';
            card.style.display = isBestseller ? 'flex' : 'none';
          }
        });
        if (grid) grid.style.opacity = 1;
      }, 200);
    });
  });
});
</script>

{% schema %}
{
  "name": "Featured Products Tabbed",
  "settings": [],
  "presets": [{ "name": "Featured Products Tabbed" }]
}
{% endschema %}
