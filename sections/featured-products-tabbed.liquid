<style>
  .tabbed-products {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-secondary);
  }
  .tabbed-products__heading {
    text-align: center;
    margin-bottom: var(--spacing-sm);
  }
  .tabbed-products__subheading {
    text-align: center;
    color: var(--color-text-body);
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
  }

  .tabbed-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    transition: opacity 0.3s ease;
  }
  @media (min-width: 900px) {
    .tabbed-products__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .product-tab-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    position: relative;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .product-tab-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,149,255,0.08);
    opacity: 1;
  }
  .product-tab-card__image-wrapper {
    aspect-ratio: 3/4;
    background: var(--color-bg-alternate);
    overflow: hidden;
    position: relative;
  }
  .product-tab-card__image {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }
  .product-tab-card__image--hover {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
    z-index: 1;
  }
  .product-tab-card:hover .product-tab-card__image--hover {
    opacity: 1;
  }
  .product-tab-card:hover .product-tab-card__image--main {
    transform: scale(1.03);
  }
  .product-tab-card__step {
    position: absolute;
    top: 12px; left: 12px;
    background: var(--color-cta);
    color: #fff;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0,149,255,0.3);
  }
  .product-tab-card__badge {
    position: absolute;
    top: 12px; right: 12px;
    background: var(--color-accent);
    color: var(--color-bg-dark);
    padding: 4px 10px;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 4px;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .product-tab-card__content {
    padding: 16px;
    text-align: center;
  }
  .product-tab-card__title {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--color-text-heading);
  }
  .product-tab-card__subtitle {
    font-size: 0.8rem;
    color: var(--color-text-body);
  }
</style>

<section class="tabbed-products">
  <div class="container">
    <h2 class="tabbed-products__heading">Bestsellers</h2>
    <p class="tabbed-products__subheading">Our most-loved products, clinically formulated for real results</p>

    <div class="tabbed-products__grid" id="TabbedProductGrid">
      {%- assign bestseller_handles = 'seravolve-2-salicylic-acid-facewash-100ml,seravolve-10-vitamin-c-face-serum-30ml,acne-control-routine,smooth-skin-routine,seravolve-barrier-repair-moisturiser-50ml' | split: ',' -%}
      {%- for handle in bestseller_handles -%}
        {%- assign product = all_products[handle] -%}
        {%- if product and product.title != blank -%}
          <a href="{{ product.url }}" class="product-tab-card">
            <div class="product-tab-card__image-wrapper">
              <span class="product-tab-card__step">{{ forloop.index }}</span>
              <span class="product-tab-card__badge">Bestseller</span>
              {%- if product.featured_image -%}
                <img class="product-tab-card__image product-tab-card__image--main" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- if product.images[1] -%}
                  <img class="product-tab-card__image product-tab-card__image--hover" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }} Alternate View" loading="lazy">
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="product-tab-card__content">
              <h3 class="product-tab-card__title">{{ product.title }}</h3>
              <p class="product-tab-card__subtitle">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products Tabbed",
  "settings": [],
  "presets": [{ "name": "Featured Products Tabbed" }]
}
{% endschema %}
