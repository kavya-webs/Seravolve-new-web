<style>
  .offers-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .offers-drawer-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .offers-drawer {
    position: fixed;
    top: 0;
    left: -400px; /* slides from left */
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: var(--color-bg-alternate);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.1);
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .offers-drawer.is-active {
    left: 0;
  }
  .offers-drawer__header {
    padding: var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .offers-drawer__title {
    font-size: 1.25rem;
    color: var(--color-bg-dark);
    margin: 0;
  }
  .offers-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-bg-dark);
  }
  .offers-drawer__content {
    flex: 1;
    padding: var(--spacing-lg) var(--spacing-md);
    overflow-y: auto;
  }
  
  /* Offer Card */
  .offer-card {
    background: #fff;
    border-radius: 8px;
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    text-align: center;
  }
  .offer-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-cta);
    margin-bottom: 8px;
  }
  .offer-card__code {
    display: inline-block;
    background: var(--color-bg-secondary);
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px dashed var(--color-text-body);
    font-family: monospace;
    font-size: 1rem;
    margin-bottom: 12px;
    letter-spacing: 1px;
  }
  
  /* Pinned Toggle Button */
  .offers-toggle-btn {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 900;
    background: var(--color-cta);
    color: #fff;
    padding: 12px 20px;
    border-radius: 30px;
    font-weight: 600;
    font-family: var(--font-heading);
    box-shadow: 0 4px 12px rgba(0,149,255,0.4);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.2s ease;
  }
  .offers-toggle-btn:hover {
    transform: scale(1.05);
  }
</style>

<button class="offers-toggle-btn" id="OffersToggleBtn">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
  Offers
</button>

<div class="offers-drawer-overlay" id="OffersDrawerOverlay"></div>
<div class="offers-drawer" id="OffersDrawer">
  <div class="offers-drawer__header">
    <h2 class="offers-drawer__title">Exclusive Offers</h2>
    <button class="offers-drawer__close" id="OffersDrawerClose">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  
  <div class="offers-drawer__content">
    <div class="offer-card">
      <h3 class="offer-card__title">10% OFF First Order</h3>
      <p>Use this code at checkout to get 10% off your entire first purchase.</p>
      <div class="offer-card__code">GLOW10</div>
      <button class="btn btn--outline" style="width: 100%;" onclick="navigator.clipboard.writeText('GLOW10'); alert('Copied!');">Copy Code</button>
    </div>
    
    <div class="offer-card">
      <h3 class="offer-card__title">Free Shipping</h3>
      <p>Enjoy free standard shipping on all orders over $50.</p>
      <div class="offer-card__code">Auto Applied</div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('OffersToggleBtn');
    const overlay = document.getElementById('OffersDrawerOverlay');
    const drawer = document.getElementById('OffersDrawer');
    const closeBtn = document.getElementById('OffersDrawerClose');
    
    function openOffers() {
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }
    
    function closeOffers() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', openOffers);
    closeBtn.addEventListener('click', closeOffers);
    overlay.addEventListener('click', closeOffers);
  });
</script>
